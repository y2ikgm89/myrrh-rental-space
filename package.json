    "hono": "^4.13.2",
    "qs": "^6.15.3",
    "@tootallnate/once": "^3.0.1",
    "@hono/node-server": "^2.1.1",
    "basic-ftp": "^6.2.0",
    "flatted": "^3.4.4",
    "ip-address": "^10.5.0",
