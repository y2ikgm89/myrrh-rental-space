{
  "name": "myrrh-rental-space",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "dev": "bun run db:generate && next dev",
    "build": "bun run toolchain:check && bun run db:generate && bun scripts/clean-next-dev-types.ts && next build && bun scripts/check-static-prelude-empty.ts",
    "build:skip-env": "bun run toolchain:check && bun run db:generate && bun scripts/clean-next-dev-types.ts && bun run build:skip-env:next",
    "build:skip-env:prepared": "bun run toolchain:check && bun scripts/clean-next-dev-types.ts && bun run build:skip-env:next",
    "build:skip-env:next": "NEXT_PUBLIC_BASE_URL=http://localhost:3000 NEXT_PUBLIC_APP_URL=http://localhost:3000 BETTER_AUTH_SECRET=build-skip-env-only-placeholder-not-runtime-7dS9kL4qQ8mN2vX5rT6yB3cH1pZ0aW SKIP_ENV_VALIDATION=true next build && bun scripts/check-static-prelude-empty.ts",
    "analyze": "bun run toolchain:check && bun run db:generate && bun scripts/clean-next-dev-types.ts && next experimental-analyze --output",
    "start": "next start",
    "lint": "eslint . --concurrency 2 --max-warnings 0",
    "lint:files": "eslint --concurrency 2 --max-warnings 0",
    "toolchain:check": "bun scripts/ensure-typescript-toolchain.ts",
    "type-check": "bun scripts/type-check.ts",
    "format": "bun scripts/prettier.ts --write",
    "format:check": "bun scripts/prettier.ts --check",
    "lint-format": "bun scripts/lint-format.ts",
    "setup": "bun scripts/setup-local.ts",
    "db:generate": "bunx --bun prisma generate",
    "db:push": "bun scripts/assert-destructive-db-target.ts && bunx --bun prisma db push",
    "db:migrate": "bun scripts/assert-destructive-db-target.ts && bunx --bun prisma migrate dev",
    "db:reset": "bun scripts/assert-destructive-db-target.ts && bunx --bun prisma migrate reset --force && bun run db:seed",
    "db:studio": "bunx --bun prisma studio",
    "db:seed": "bunx --bun prisma db seed",
    "validate": "bun scripts/validate.ts",
    "test": "bun scripts/run-tests.ts",
    "test:unit": "bun run db:generate && bun scripts/run-tests.ts __tests__/unit",
    "test:db:migrate": "bun scripts/migrate-test-db.ts",
    "test:integration": "bun run db:generate && bun run test:db:migrate && bun scripts/run-tests.ts __tests__/integration",
    "test:all": "bun run db:generate && bun run test:db:migrate && bun scripts/run-tests.ts __tests__/unit __tests__/integration",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "email:dev": "email dev --dir src/shared/emails --port 3030",
    "lhci:start-server": "bun run scripts/lhci-start.ts",
    "lhci": "lhci autorun",
    "lhci:local": "bun run build:skip-env && bun run lhci",
    "lhci:collect": "lhci collect",
    "lhci:assert": "lhci assert",
    "gcp:audit-production-iap": "bun scripts/audit-gcp-production-iap.ts",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "prepare": "lefthook install || true",
    "postinstall": "bun run db:generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@conform-to/dom": "1.21.0",
    "@conform-to/react": "^1.21.0",
    "@conform-to/zod": "^1.21.0",
    "@daypicker/react": "^10.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-analytics/data": "^7.0.0",
    "@gsap/react": "2.1.2",
    "@holiday-jp/holiday_jp": "^2.5.1",
    "@hono/node-server": "^2.1.1",
    "@lexical/code": "0.49.0",
    "@lexical/extension": "0.49.0",
    "@lexical/headless": "0.49.0",
    "@lexical/html": "0.49.0",
    "@lexical/link": "0.49.0",
    "@lexical/list": "0.49.0",
    "@lexical/mark": "0.49.0",
    "@lexical/markdown": "0.49.0",
    "@lexical/react": "0.49.0",
    "@lexical/rich-text": "0.49.0",
    "@lexical/selection": "0.49.0",
    "@lexical/table": "0.49.0",
    "@lexical/utils": "0.49.0",
    "@marsidev/react-turnstile": "^1.6.0",
    "@next/third-parties": "16.3.1",
