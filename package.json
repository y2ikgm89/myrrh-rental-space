    "better-auth": "^1.6.28",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "get-nonce": "^1.0.1",
    "google-auth-library": "^11.0.2",
    "googleapis": "^174.0.1",
    "gsap": "^3.15.0",
    "hono": "^4.13.2",
    "ical-generator": "^11.1.0",
    "jsdom": "^30.0.1",
    "lenis": "^1.3.26",
    "lexical": "0.49.0",
    "lru-cache": "^11.5.2",
    "next": "16.3.1",
    "nuqs": "2.9.5",
    "prisma": "^7.9.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.20.0",
    "rrule": "^2.8.1",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "standardwebhooks": "1.0.0",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "web-vitals": "^6.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "16.3.1",
    "@playwright/test": "~1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "axe-core": "^4.13.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "lefthook": "^2.1.10",
    "p-limit": "^7.3.1",
    "prettier": "^3.9.6",
    "react-email": "^6.9.2",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0"
  },
