{
  "name": "myrrh-rental-space",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun run db:generate && next dev --turbopack",
    "build": "bun run db:generate && SKIP_ENV_VALIDATION=true next build",
    "build:strict": "bun run db:generate && next build",
    "start": "next start",
    "lint": "eslint src prisma",
    "lint:config": "eslint eslint.config.mjs next.config.ts postcss.config.mjs prisma.config.ts",
    "lint:e2e": "eslint e2e playwright.config.ts",
    "type-check": "bun run db:generate && next typegen && tsc --noEmit --incremental false && tsc --noEmit --incremental false -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "bun prisma/seed.ts",
    "validate": "bun run type-check && bun run lint",
    "test": "bun run db:generate && bun test",
    "test:watch": "bun run db:generate && bun test --watch",
    "test:coverage": "bun run db:generate && bun test --coverage",
    "test:unit": "bun run db:generate && bun test __tests__/unit",
    "test:integration": "bun run db:generate && bun test __tests__/integration",
    "test:all": "bun run test:unit && bun run test:integration",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "docs:verify-policy-sync": "node scripts/verify-policy-docs.mjs",
    "postinstall": "bun run db:generate"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.5.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-analytics/data": "^5.2.1",
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@lexical/code": "^0.42.0",
    "@lexical/html": "^0.42.0",
    "@lexical/link": "^0.42.0",
    "@lexical/list": "^0.42.0",
    "@lexical/react": "^0.42.0",
    "@lexical/rich-text": "^0.42.0",
    "@lexical/selection": "^0.42.0",
    "@lexical/table": "^0.42.0",
    "@lexical/utils": "^0.42.0",
    "@marsidev/react-turnstile": "^1.4.2",
    "@next/third-parties": "^16.2.1",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.10",
    "@supabase/supabase-js": "^2.100.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/typography": "^0.5.19",
    "better-auth": "^1.5.6",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "googleapis": "^171.4.0",
    "gsap": "3.14.2",
    "isomorphic-dompurify": "^3.7.1",
    "lenis": "^1.3.20",
    "lexical": "^0.42.0",
    "lru-cache": "^11.2.7",
    "lucide-react": "^1.0.1",
    "next": "^16.2.1",
    "nuqs": "2.8.9",
    "pg": "^8.20.0",
    "prisma": "^7.5.0",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "recharts": "^3.8.0",
    "resend": "^6.9.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "web-vitals": "^5.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^3.0.0",
    "@lexical/headless": "^0.42.0",
    "@next/bundle-analyzer": "^16.2.1",
    "@next/eslint-plugin-next": "16.2.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "bun-types": "^1.3.11",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
