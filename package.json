    "tmp": "^0.2.7",
    "playwright-core": "~1.62.1",
    "brace-expansion": "^5.0.9",
    "uuid": "^11.1.1",
    "ws": "^8.21.3",
    "happy-dom": "^20.11.2",
    "undici": "^8.10.0",
    "sharp": "^0.35.3",
    "valibot": "^1.4.2",
    "nanoid": "^3.3.18",
