{
  "name": "myrrh-rental-space",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run db:generate && next dev --turbopack",
    "build": "bun run db:generate && next build",
    "build:skip-env": "bun run db:generate && SKIP_ENV_VALIDATION=true next build",
    "analyze": "bun run db:generate && next experimental-analyze --output",
    "start": "next start",
    "lint": "eslint src prisma",
    "lint:config": "eslint eslint.config.mjs next.config.ts postcss.config.mjs prisma.config.ts",
    "lint:e2e": "eslint e2e playwright.config.ts",
    "type-check": "bun run db:generate && next typegen && bun scripts/ensure-next-types.ts && tsc --noEmit --incremental false && tsc --noEmit --incremental false -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "bunx --bun prisma generate",
    "db:push": "bunx --bun prisma db push",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:studio": "bunx --bun prisma studio",
    "db:seed": "bun prisma/seed.ts",
    "validate": "bun run type-check && bun run lint",
    "test:unit": "bun run db:generate && bun scripts/run-tests.ts __tests__/unit",
    "test:integration": "bun run db:generate && bun scripts/run-tests.ts __tests__/integration",
    "test:all": "bun run test:unit && bun run test:integration",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lhci:start-server": "bun run scripts/lhci-start.ts",
    "lhci": "lhci autorun",
    "lhci:collect": "lhci collect",
    "lhci:assert": "lhci assert",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "prepare": "lefthook install",
    "postinstall": "bun run db:generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@better-auth/prisma-adapter": "^1.6.10",
    "@daypicker/react": "^10.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-analytics/data": "^5.2.2",
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@lexical/clipboard": "0.44.0",
    "@lexical/code": "0.44.0",
    "@lexical/html": "0.44.0",
    "@lexical/link": "0.44.0",
    "@lexical/list": "0.44.0",
    "@lexical/mark": "0.44.0",
    "@lexical/markdown": "0.44.0",
    "@lexical/overflow": "0.44.0",
    "@lexical/react": "0.44.0",
    "@lexical/rich-text": "0.44.0",
    "@lexical/selection": "0.44.0",
    "@lexical/table": "0.44.0",
    "@lexical/utils": "0.44.0",
    "@marsidev/react-turnstile": "^1.5.2",
    "@next/third-parties": "^16.2.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-email/components": "^1.0.12",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/typography": "^0.5.19",
    "@touch4it/ical-timezones": "^1.9.0",
    "better-auth": "^1.6.10",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "googleapis": "^171.4.0",
    "gsap": "^3.15.0",
    "ical-generator": "^10.2.0",
    "isomorphic-dompurify": "^3.12.0",
    "lenis": "^1.3.23",
    "lexical": "0.44.0",
    "lru-cache": "^11.3.6",
    "next": "^16.2.6",
    "nuqs": "2.8.9",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "web-vitals": "^5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint-react/eslint-plugin": "^5.7.6",
    "@lexical/headless": "0.44.0",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^16.2.6",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^28.0.2",
    "@types/node": "^25.7.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "@types/pg": "^8.20.0"
  }
}
