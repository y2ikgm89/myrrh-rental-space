    "@lexical/rich-text": "0.46.0",
    "@lexical/selection": "0.46.0",
    "@lexical/table": "0.46.0",
    "@lexical/utils": "0.46.0",
    "@marsidev/react-turnstile": "^1.5.3",
    "@next/third-parties": "^16.2.9",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.9",
    "@react-pdf/renderer": "^4.5.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/typography": "^0.5.20",
    "better-auth": "^1.6.22",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "google-auth-library": "^10.9.0",
    "googleapis": "^173.0.0",
    "gsap": "^3.15.0",
    "ical-generator": "^11.0.0",
    "isomorphic-dompurify": "^3.18.0",
    "lenis": "^1.3.25",
    "lexical": "0.46.0",
    "lru-cache": "^11.5.1",
    "next": "^16.2.9",
    "nuqs": "2.8.9",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.0",
    "resend": "^6.16.0",
    "rrule": "^2.8.1",
    "sanitize-html": "^2.17.5",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "stripe": "^22.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "web-vitals": "^5.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint-react/eslint-plugin": "^5.10.0",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "@playwright/test": "~1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.0.1",
    "@types/sanitize-html": "^2.16.1",
    "jsdom": "^29.1.1",
    "prisma": "^7.8.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.12.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "lefthook": "^2.1.9",
    "p-limit": "^7.3.0",
    "prettier": "^3.9.1",
    "react-email": "^6.6.5",
    "tailwindcss": "^4.3.1",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "pg": "^8.22.0",
    "protobufjs": "^8.6.5",
    "minimatch": "^10.2.5",
    "fast-uri": "^3.1.2",
    "postcss": "^8.5.16",
    "hono": "^4.12.27",
    "qs": "^6.15.3",
    "@tootallnate/once": "^3.0.1",
    "@hono/node-server": "^2.0.6",
    "basic-ftp": "^6.0.1",
    "flatted": "^3.4.2",
    "ip-address": "^10.2.0",
    "picomatch": "^4.0.4",
    "tmp": "^0.2.7",
    "playwright-core": "~1.61.1",
    "brace-expansion": "^5.0.7",
    "uuid": "^11.1.1",
    "ws": "^8.21.0"
  }
}
