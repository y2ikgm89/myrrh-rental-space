{
  "compilerOptions": {
    "target": "es2025",
    "lib": ["dom", "esnext"],
    "skipLibCheck": true,
    "noEmit": true,
    // TS 6.0: デフォルト [] — Node.js + Bun runtime グローバル型を明示有効化
    // Bun は Node 互換 runtime のため両方併用 OK（公式 docs §TypeScript）
    "types": ["node", "bun"],
    // ── Strict type-checking ──────────────────────────────────────────────
    // Next.js が未指定だと false を注入するため明示必須
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // optional プロパティへの undefined 代入を禁止
    "exactOptionalPropertyTypes": true,
    // TS 7.0 (Go native) 準備: enum, namespace, parameter properties をエラー
    "erasableSyntaxOnly": true,
    // インデックスシグネチャ由来はブラケット記法を強制
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    // 戻り値のある関数で return を落とした経路を検出する。ESLint の
    // `consistent-return` は recommended に入っていないので、これが無いと
    // 「一部の分岐だけ undefined を返す」形を誰も見ていない。
    "noImplicitReturns": true,
    "moduleDetection": "force",
    // ── Module resolution ─────────────────────────────────────────────────
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // 解決できない副作用 import（`import "./typo.css"`）をエラーにする。
    // tsc の既定は「副作用 import は解決を検査しない」で、綴り違いが
    // ビルドまで無言で通る。ESLint 側に相当するルールは無い。
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    // ── React / JSX ───────────────────────────────────────────────────────
    "jsx": "react-jsx",
    // ── Build ─────────────────────────────────────────────────────────────
    "incremental": true,
    // ── Next.js plugin ────────────────────────────────────────────────────
    "plugins": [
      {
        "name": "next"
      }
    ],
    // ── Path aliases ──────────────────────────────────────────────────────
    "paths": {
      "@/*": ["./src/*"],
      "@generated/*": ["./generated/*"],
      "@/admin/*": ["./src/app/(admin)/admin/(dashboard)/_shared/*"],
      "@/public/*": ["./src/app/(public)/_shared/*"],
      "@/shared/*": ["./src/shared/*"]
    },
    // ── Next.js 自動注入 ─────────────────────────────────────────────────
    "allowJs": true,
    "module": "esnext",
    "esModuleInterop": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "__tests__", "generated"]
}
