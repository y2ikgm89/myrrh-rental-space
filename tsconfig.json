{
  "compilerOptions": {
    "target": "es2025",
    "lib": ["dom", "esnext"],
    "skipLibCheck": true,
    "noEmit": true,
    // TS 6.0: デフォルト [] — @types/node を明示して Node.js グローバル型を有効化
    "types": ["node"],
    // ── Strict type-checking ──────────────────────────────────────────────
    // Next.js が未指定だと false を注入するため明示必須
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // optional プロパティへの undefined 代入を禁止
    "exactOptionalPropertyTypes": true,
    // TS 7.0 (Go native) 準備: enum, namespace, parameter properties をエラー
    "erasableSyntaxOnly": true,
    // インデックスシグネチャ由来はブラケット記法を強制
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "moduleDetection": "force",
    // ── Module resolution ─────────────────────────────────────────────────
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    // ── React / JSX ───────────────────────────────────────────────────────
    "jsx": "react-jsx",
    // ── Build ─────────────────────────────────────────────────────────────
    "incremental": true,
    // ── Next.js plugin ────────────────────────────────────────────────────
    "plugins": [
      {
        "name": "next"
      }
    ],
    // ── Path aliases ──────────────────────────────────────────────────────
    "paths": {
      "@/*": ["./src/*"],
      "@generated/*": ["./generated/*"],
      "@/admin/*": ["./src/app/(admin)/admin/(dashboard)/_shared/*"],
      "@/public/*": ["./src/app/(public)/_shared/*"],
      "@/shared/*": ["./src/shared/*"]
    },
    // ── Next.js 自動注入 ─────────────────────────────────────────────────
    "allowJs": true,
    "module": "esnext",
    "esModuleInterop": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "__tests__", "generated"]
}
