// ==============================================
// Myrrh Rental Space - Prisma Schema
// ==============================================
// Prisma 7 + PostgreSQL 16

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  engineType = "client"
  runtime = "bun"
}

datasource db {
  provider = "postgresql"
}

// ==============================================
// Enums
// ==============================================

enum Role {
  SUPER_ADMIN // 全権限（システム設定、ユーザー管理、監査ログ）
  ADMIN // コンテンツ管理全般
  EDITOR // 割り当てページ編集のみ
  VIEWER // 閲覧のみ
  USER // 公開ユーザー（非管理者）
  CUSTOMER // 顧客（ソーシャルログイン）
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CustomerType {
  PERSONAL
  CORPORATE
}

enum CustomerStatus {
  NEW
  REGULAR
  VIP
  INACTIVE
  BLACKLIST
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum NavigationType {
  HEADER_DESKTOP // デスクトップ用ヘッダーメニュー
  HEADER_MOBILE // モバイル用ヘッダーメニュー
  FOOTER // フッターメニュー
}

enum SocialPlatform {
  TWITTER
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  LINE
  TIKTOK
  OTHER
}

enum LayoutWidth {
  XS
  SM
  MD
  LG
  XL
  FULL
  CUSTOM
}


enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CouponType {
  PERCENTAGE // パーセント割引 (例: 20%)
  FIXED_AMOUNT // 定額割引 (例: ¥1,000)
}

// --- 新規 Enum（String → Enum 変換） ---

enum DiscountType {
  none
  percentage
  fixed
}

enum DurationDiscountOverride {
  inherit
  enabled
  disabled
}

enum TaxRateType {
  standard
  reduced
}

// @map required: hyphens in DB values
enum HeaderScrollBehavior {
  auto_hide      @map("auto-hide")
  always_visible @map("always-visible")
  hide_on_scroll @map("hide-on-scroll")
}

enum HeaderBackgroundMode {
  solid       @map("solid")
  transparent @map("transparent")
}

enum TaxDisplayMode {
  tax_excluded
  tax_included
  both
}

enum TaxInputMode {
  tax_excluded
  tax_included
}

enum CalendarSyncMethod {
  polling
  webhook
  both
}

enum AnalyticsType {
  ga4
  gtm
}

enum DiscountCombinationMode {
  best
  both
}

enum AnnouncementBarAnimation {
  fade
  slideX
  slideY
}

enum AnnouncementBarDesignStyle {
  solid
  gradient
  outlined
  glass
  minimal
  striped
}

enum InstagramMediaType {
  IMAGE
  VIDEO
  CAROUSEL_ALBUM
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

enum EventScheduleMode {
  /// 単一開催。DB 上は EventTimeSlot 1 件だけを持つ。
  SINGLE_OCCURRENCE
  /// 日時選択制。公開申込で複数の EventTimeSlot から選ばせる。
  TIMED_ENTRY
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
}

/// Resend Webhook (email.bounced / email.complained) で観測された配信状態。
/// Gmail Feb 2024 / Yahoo bulk sender 要件 (complaint rate < 0.3%) 対応で、
/// HARD_BOUNCED / COMPLAINED 宛先には送信前に suppress する。
/// - OK: 既定値（観測なし or 正常配信）
/// - SOFT_BOUNCED: bounce.type=Temporary（再送猶予あり）
/// - HARD_BOUNCED: bounce.type=Permanent（送信永久停止）
/// - COMPLAINED: email.complained（受信者がスパム報告 → 送信永久停止）
enum EmailDeliveryStatus {
  OK
  SOFT_BOUNCED
  HARD_BOUNCED
  COMPLAINED
}

// ==============================================
// Better Auth Models
// ==============================================

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  accounts        Account[]
  sessions        Session[]
  reservations    Reservation[]
  posts           Post[]
  auditLogs       AuditLog[]
  mediaFiles      Media[]
  customer        Customer?          @relation("CustomerUser")
  blockedDates    BlockedDate[]

  // RBAC: EDITOR用の割り当てページ（中間テーブル）
  pageAssignments UserPageAssignment[]

  // FK: createdBy / resolvedBy / deletedBy リレーション
  createdCommentThreads   EditorCommentThread[]  @relation("CommentThreadCreator")
  resolvedCommentThreads  EditorCommentThread[]  @relation("CommentThreadResolver")
  createdEditorComments   EditorComment[]        @relation("EditorCommentCreator")
  deletedEditorComments   EditorComment[]        @relation("EditorCommentDeleter")
  inquiryReplies          Inquiry[]              @relation("InquiryReplies")
  reservationDeletions    Reservation[]          @relation("ReservationDeletions")
  eventDeletions          Event[]                @relation("EventDeletions")
  createdStaffInvitations StaffInvitation[]      @relation("StaffInvitationCreator")
  createdBlockTemplates   BlockTemplate[]        @relation("BlockTemplateCreator")
  repliedSpaceReviews     SpaceReview[]          @relation("SpaceReviewReplyAuthor")

  // OR検索用インデックス
  @@index([name])
  @@map("user")
}

/// EDITOR用のページ割り当て（中間テーブル）
model UserPageAssignment {
  userId String @db.Uuid
  pageId String @db.Uuid
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([userId, pageId])
  @@index([pageId])
  @@map("user_page_assignments")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  accountId             String // Better Auth: ユーザーID or プロバイダーのアカウントID
  providerId            String // Better Auth: "credential" or "google" etc.
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // Better Auth: credential provider のパスワード（scrypt hash）
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId String @db.Uuid
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model StaffInvitation {
  id        String    @id @default(uuid()) @db.Uuid
  email     String
  token     String    @unique
  role      Role      @default(USER)
  name      String? // オプションで名前を指定
  usedAt    DateTime? // 使用済み = パスワード設定完了
  expiresAt DateTime
  createdAt DateTime  @default(now())
  createdBy String? @db.Uuid // 作成者ID（User.id）- ユーザー削除時にnull化

  // Relations
  creator User? @relation("StaffInvitationCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  // @unique が自動的にインデックスを作成するため @@index([token]) は不要
  @@index([email])
  @@index([expiresAt])
  @@map("staff_invitations")
}

// ==============================================
// Business Models
// ==============================================

model Location {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique @db.VarChar(255)
  name            String   @unique
  description     String?  @db.Text
  address         String
  postalCode      String?
  prefecture      String?
  city            String?
  streetAddress   String?
  buildingName    String?
  /// 交通案内（最寄り駅・路線・徒歩分数等）。1 行 = 1 経路の構造化配列。
  /// 旧 access String 列（改行区切り）を 2026-05-01 に Json 配列化（破壊的変更）。
  accessLines     Json     @default("[]")
  parkingInfo     String?  @db.Text
  amenities       Json     @default("{}")
  imageUrl        String
  imageUrls       Json     @default("[]")
  businessHours   Json?
  specialHolidays Json?

  // MEO（Local SEO）— Settings から移管
  latitude              Float?
  longitude             Float?
  googleBusinessPlaceId String?
  googleReviewUrl       String?
  priceRange            String?  @db.VarChar(100)
  paymentAccepted       String?
  phoneNumber           String?
  email                 String?

  // GBP Sync
  gbpSyncEnabled Boolean   @default(true)
  gbpSyncedAt    DateTime?
  gbpSyncError   String?   @db.Text

  sortOrder       Int      @default(0)
  isPublished     Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  spaces       Space[]
  events       Event[]
  blockedDates BlockedDate[]

  @@index([isPublished, isActive])
  @@index([sortOrder])
  @@index([gbpSyncError])
  @@map("locations")
}

model SpaceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique // 例: 会議室、スタジオ、セミナー室（seed idempotency 保証）
  description String?  @db.Text
  icon        String? // アイコン名（任意）
  color       String? // テーマカラー（任意）
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  spaces Space[]

  @@index([sortOrder])
  @@map("space_categories")
}

model Space {
  id            String    @id @default(uuid()) @db.Uuid
  slug          String    @unique
  name          String
  /// Lexical EditorState JSON（正本）
  descriptionJson      Json
  /// Lexical → 公開表示用 HTML キャッシュ（SanitizedHtml で出力）
  descriptionHtml      String   @db.Text
  /// SEO description / カード要約 / メタデータ用プレーンテキスト派生
  descriptionPlainText String   @db.Text
  /// 号室・フロア等。建物の住所は必ず `Location.address` を正本とする。
  /// 主要交通案内・駐車場情報は親 Location（accessLines / parkingInfo）が SSoT。
  addressDetail String?   @db.Text
  capacity      Int
  area          Decimal?  @db.Decimal(10, 2)
  hourlyPrice   Decimal   @db.Decimal(10, 2)
  dailyPrice    Decimal?  @db.Decimal(10, 2)
  mainImageUrl  String
  gallery       Json      @default("[]")
  /// 構造化された設備リスト（Airbnb / Booking.com 標準パターン）。
  /// JSON 配列 `{ name: string; iconName: string }[]`。
  /// `iconName` は `@/shared/lib/icon-curation` の curation 識別子。
  /// 空文字 = icon 未指定（fallback で text のみ表示）。
  facilities    Json      @default("[]")
  businessHours Json?
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  isActive      Boolean   @default(true)
  /// レビュー機能の per-space ON/OFF。false の場合は公開ページで非表示 + 投稿不可。
  /// 新規スペースはデフォルト false（opt-in）。`Settings.featureModules.reviews` が上位 gate。
  reviewsEnabled Boolean  @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // SEO設定
  metaDescription String?
  metaKeywords    String?

  // OGP設定
  ogpTitle       String?
  ogpDescription String?
  ogpImageUrl    String?

  // 割引設定（Enum化）
  discountType             DiscountType             @default(none)
  discountValue            Decimal?                 @db.Decimal(10, 2)
  durationDiscountOverride DurationDiscountOverride  @default(inherit)

  // 税率設定（Enum化）
  taxRateType TaxRateType @default(standard)

  // 場所・カテゴリー設定（拠点は必須。カテゴリーは任意）
  locationId String @db.Uuid
  categoryId String? @db.Uuid

  // Relations
  reservations Reservation[]
  reviews      SpaceReview[]
  events       Event[]
  blockedDates BlockedDate[]
  location     Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  category     SpaceCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // OR検索用インデックス
  @@index([name])
  @@index([addressDetail])
  @@index([isPublished, isActive])
  @@index([publishedAt, isActive])
  @@index([locationId])
  @@index([categoryId])
  @@map("spaces")
}

/// 臨時休業 / 急な休み（businessHours の曜日別定休日を補完する日付範囲ベースの休業）。
/// per-space / per-location / global の 3 階層 cascade（additive、override なし）。
/// scope と type は VarChar + 型ガード SSoT（`@/shared/lib/validations/enums/helpers`）で運用。
/// scope / spaceId / locationId は discriminated union 不変条件を持つ:
/// SPACE→spaceId 必須・locationId null / LOCATION→locationId 必須・spaceId null /
/// GLOBAL→両方 null。これは DB の CHECK 制約 `blocked_dates_scope_target_check`
/// (migration 20260528173132_create_blocked_dates) で強制されるが、Prisma schema DSL では
/// 表現できないため schema.prisma は完全な SSoT ではない。
/// ⚠ `prisma db pull`（introspection）は CHECK 制約を取り込まず黙って落とすので、
/// introspection で schema を再生成する際は本制約を手で復元すること
/// （`prisma migrate reset` は全 migration を再生するため制約は復元される）。
/// アプリ層は Zod superRefine（blocked-date バリデーション）で同一不変条件を二重に保証する。
model BlockedDate {
  id          String   @id @default(uuid()) @db.Uuid
  /// "SPACE" | "LOCATION" | "GLOBAL"（isValidBlockedDateScope で検証）
  scope       String   @db.VarChar(16)
  /// scope=SPACE のみ非 null
  spaceId     String?  @db.Uuid
  /// scope=LOCATION のみ非 null
  locationId  String?  @db.Uuid
  /// JST カレンダー日付を UTC 深夜で保持。単日休業は startDate=endDate。
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  /// "年末年始" / "設備点検" / "台風 19 号による臨時休業" 等の plain text ラベル
  reason      String?  @db.VarChar(200)
  /// "HOLIDAY" | "MAINTENANCE" | "EMERGENCY" | "OTHER"（isValidBlockedDateType で検証）
  type        String   @db.VarChar(32)
  createdBy   String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  space    Space?    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  creator  User      @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([scope, startDate, endDate])
  @@index([spaceId, startDate, endDate])
  @@index([locationId, startDate, endDate])
  @@map("blocked_dates")
}

model Reservation {
  id            String            @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  userId String? @db.Uuid
  customerId String @db.Uuid
  startTime     DateTime
  endTime       DateTime
  status        ReservationStatus @default(PENDING)
  totalPrice    Decimal?          @db.Decimal(10, 2)
  notes         String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // 割引情報
  couponId String? @db.Uuid // 適用されたクーポンID
  couponDiscountAmount   Decimal? @db.Decimal(10, 2) // クーポン割引額
  durationDiscountAmount Decimal? @db.Decimal(10, 2) // 長時間割引額
  spaceDiscountAmount    Decimal? @db.Decimal(10, 2) // スペース固有割引額
  basePrice              Decimal? @db.Decimal(10, 2) // 割引前価格（記録用）

  // 税情報（予約時点の値を記録）
  taxRateType       TaxRateType? // 適用された税率タイプ
  taxRate           Decimal? @db.Decimal(5, 2) // 適用税率（%）
  taxAmount         Decimal? @db.Decimal(10, 2) // 税額
  totalPriceWithTax Decimal? @db.Decimal(10, 2) // 税込み合計

  // Google Calendar Sync
  googleCalendarEventId      String? // 共有カレンダーのイベントID
  calendarSyncedAt           DateTime? // 最終同期日時
  calendarSyncError          String?   @db.Text // 同期エラーメッセージ

  // Guest contact info (予約時に入力された連絡先 — Customer レコードとは独立に保存)
  guestLastName    String?
  guestFirstName   String?
  guestEmail       String?
  guestPhone       String?
  guestCompanyName    String?
  guestCustomerType   CustomerType?

  // Relations
  space           Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  coupon          Coupon?          @relation(fields: [couponId], references: [id], onDelete: SetNull)
  review          SpaceReview?

  // Soft-delete
  deletedAt    DateTime?
  deletedById  String?   @db.Uuid
  deletedBy    User?     @relation("ReservationDeletions", fields: [deletedById], references: [id], onDelete: SetNull)

  // Payment (Stripe)
  paymentStatus           PaymentStatus @default(UNPAID)
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime?

  // Cancellation tracking
  cancellationReason String?  @db.Text
  cancelledAt        DateTime?
  cancelledByType    String?  @db.VarChar(20) // "CUSTOMER" | "CUSTOMER_MYPAGE" | "CUSTOMER_TOKEN" | "ADMIN" (CANCELLED_BY SSoT: src/shared/lib/validations/enums/helpers.ts)

  // iCal RFC 5545 SEQUENCE (increments on update/cancel)
  icsSequence Int @default(0)

  // Reminder cron 冪等性: リマインダーメール送信済み日時（null = 未送信）。
  // 二重送信防止のため送信前に atomic claim で now を立て、送信失敗時は null に戻す。
  reminderSentAt DateTime?

  @@index([spaceId])
  @@index([customerId])
  @@index([userId])
  @@index([startTime])
  @@index([endTime])
  @@index([status])
  @@index([createdAt])
  @@index([spaceId, startTime, endTime])
  @@index([customerId, startTime])
  @@index([couponId])
  @@index([deletedAt])
  @@index([paymentStatus])
  @@index([stripePaymentIntentId])
  @@map("reservations")
}

model Customer {
  id                 String         @id @default(uuid()) @db.Uuid
  lastName           String
  firstName          String
  lastNameKana       String?        // 姓カナ（任意）
  firstNameKana      String?        // 名カナ（任意）
  companyName        String?        // 会社名・団体名（法人の場合）
  customerType       CustomerType   @default(PERSONAL)
  email              String
  /// Expand phase: nullable in DB so the previous Cloud Run revision can keep
  /// inserting customers during rollout. New code always writes this value.
  /// Contract phase should backfill nulls and make it NOT NULL.
  emailCanonical     String?
  phoneNumber        String?
  postalCode         String?        @db.VarChar(8)   // 郵便番号 "123-4567" 等
  prefecture         String?        @db.VarChar(10)  // 都道府県（PREFECTURES SSoT）
  city               String?        @db.VarChar(100) // 市区町村
  streetAddress      String?        @db.VarChar(200) // 町名・番地
  building           String?        @db.VarChar(200) // 建物名・部屋番号
  status             CustomerStatus @default(NEW)
  notes              String?        @db.Text
  totalReservations  Int            @default(0)
  totalSpent         Decimal?       @db.Decimal(10, 2)
  lastReservationAt  DateTime?
  firstReservationAt DateTime?
  isActive           Boolean        @default(true)
  marketingOptIn     Boolean        @default(false)  // メルマガ・キャンペーン受信可否
  phoneContactOptIn  Boolean        @default(true)   // 電話連絡可否
  /// Resend Webhook で観測された配信状態。HARD_BOUNCED / COMPLAINED は送信前にスキップ。
  /// 詳細は EmailDeliveryStatus enum 参照。
  emailDeliveryStatus       EmailDeliveryStatus @default(OK)
  emailDeliveryUpdatedAt    DateTime?
  /// Resend Webhook payload の bounce.message / suppression reason を保持（人間可読のラベル）。
  emailDeliveryReason       String?       @db.VarChar(500)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Social Auth Link
  userId  String? @unique @db.Uuid
  user    User?   @relation("CustomerUser", fields: [userId], references: [id], onDelete: SetNull)

  // Relations
  reservations Reservation[]
  inquiries    Inquiry[]
  reviews              SpaceReview[]
  eventRegistrations   EventRegistration[]
  termsAgreements      TermsAgreement[]

  @@index([lastName])
  @@index([firstName])
  @@index([phoneNumber])
  @@index([status])
  @@index([customerType])
  @@index([emailCanonical])
  @@index([emailCanonical, userId])
  @@index([isActive])
  @@index([lastReservationAt])
  @@index([lastName, firstName])
  @@index([emailDeliveryStatus])
  @@map("customers")
}

// ==============================================
// Coupon Model (割引クーポン)
// ==============================================

model Coupon {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique // クーポンコード (大文字英数字)
  name        String // 管理用名称
  description String? // 説明

  // 割引設定
  type          CouponType
  discountValue Decimal    @db.Decimal(10, 2) // 割引額 or 割引率

  // 適用条件
  minReservationAmount Decimal? @db.Decimal(10, 2) // 最低利用金額
  maxDiscountAmount    Decimal? @db.Decimal(10, 2) // 最大割引額（パーセント割引時）

  // 有効期限
  validFrom  DateTime
  validUntil DateTime?

  // 利用制限
  usageLimit Int? // 利用回数上限（null=無制限）
  usageCount Int     @default(0) // 利用回数
  isActive   Boolean @default(true)

  // 併用設定
  canCombineWithDurationDiscount Boolean @default(true) // 長時間割引との併用可否

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  reservations Reservation[]

  // @unique が自動的にインデックスを作成するため @@index([code]) は不要
  @@index([validFrom, validUntil])
  @@index([isActive])
  @@map("coupons")
}

model Inquiry {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  companyName  String?       // 会社名・団体名（法人の場合）
  customerType CustomerType?
  email        String
  subject      String
  message      String        @db.Text
  status       InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Reply（管理者からの返信）
  replyMessage String?   @db.Text
  repliedAt    DateTime?
  repliedById  String?   @db.Uuid
  repliedBy    User?     @relation("InquiryReplies", fields: [repliedById], references: [id], onDelete: SetNull)

  // Customer Link（ログインユーザーのお問い合わせ紐づけ）
  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([createdAt, status])
  @@index([customerId])
  @@map("inquiries")
}

model News {
  id                 String       @id @default(uuid()) @db.Uuid
  slug               String       @unique
  title              String
  contentHtml        String       @db.Text @map("content") // HTMLキャッシュ（公開表示用）
  contentJson        Json? // Lexical EditorState JSON（プライマリ）
  isPublished        Boolean      @default(false)
  publishedAt        DateTime?
  contentWidth       LayoutWidth?
  contentWidthCustom Int? // CUSTOMの場合の幅（px）
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // SEO設定
  metaDescription String?
  metaKeywords    String?

  // OGP設定
  ogpTitle       String?
  ogpDescription String?
  ogpImageUrl    String?

  // OR検索用インデックス
  @@index([title])
  @@index([isPublished, publishedAt])
  @@index([createdAt])
  @@map("news")
}

model AnnouncementBar {
  id        String    @id @default(uuid()) @db.Uuid
  /// Sanity Portable Text 互換の inline span 配列。`{_key,_type:"span",text}` と
  /// `{_key,_type:"iconInline",name}` の discriminated union を順次配置する。
  message   Json      @default("[]")
  linkUrl   String?
  linkText  String?
  bgColor   String? // カスタム背景色 (hex)
  textColor String? // カスタム文字色 (hex)
  isActive  Boolean   @default(true)
  priority  Int       @default(0)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, priority])
  @@index([startAt, endAt])
  @@map("announcement_bars")
}

// ==============================================
// Post Models
// ==============================================

model Post {
  id                 String      @id @default(uuid()) @db.Uuid
  title              String
  slug               String      @unique
  excerpt            String      @db.Text
  contentHtml        String      @db.Text @map("content") // HTMLキャッシュ（公開表示用）
  contentJson        Json? // Lexical EditorState JSON（プライマリ）
  thumbnailUrl       String
  ogpImageUrl        String?
  categoryId String @db.Uuid
  metaDescription    String?
  metaKeywords       String?
  ogpTitle           String?
  ogpDescription     String?
  publishedAt        DateTime?
  status             PostStatus  @default(DRAFT)
  authorId String? @db.Uuid // ユーザー削除時にnull化
  contentWidth       LayoutWidth?
  contentWidthCustom Int? // CUSTOMの場合の幅（px）
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Relations
  category PostCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author   User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  postTags PostTagOnPost[]

  // OR検索用インデックス
  @@index([title])
  @@index([authorId])
  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@map("posts")
}

/// Post ↔ PostTag 中間テーブル（JSON配列からの正規化）
model PostTagOnPost {
  postId String @db.Uuid
  tagId String @db.Uuid
  post   Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    PostTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tag_on_posts")
}

model PostCategory {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  slug            String   @unique
  description     String?  @db.Text
  metaTitle       String?
  metaDescription String?  @db.Text
  ogpImageUrl     String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  posts Post[]

  @@index([order])
  @@map("post_categories")
}

model PostTag {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  slug            String   @unique
  description     String?  @db.Text
  metaTitle       String?
  metaDescription String?  @db.Text
  ogpImageUrl     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  posts PostTagOnPost[]

  @@map("post_tags")
}

// ==============================================
// CMS Models
// ==============================================

model Page {
  id                 String       @id @default(uuid()) @db.Uuid
  slug               String       @unique
  title              String
  metaDescription    String?
  metaKeywords       String?
  ogpTitle           String?
  ogpDescription     String?
  ogpImageUrl        String?
  isPublished        Boolean      @default(true)
  publishedAt        DateTime?
  isActive           Boolean      @default(true)
  isSystemPage       Boolean      @default(false) // システムページ（SEO/OGPのみ編集可、コンテンツ編集不可）
  template           String       @db.VarChar(64)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relations
  sections         Section[]
  assignments      UserPageAssignment[]

  @@index([isPublished, isActive])
  @@index([isSystemPage])
  @@map("pages")
}

/// 統一セクション（システムページ + カスタムページ共通）
/// 全 section は必ず Page に紐づく（home の page-hero も含めて pageId = Page.id、seed.ts 参照）。
/// 旧仕様（pageId nullable = home section）は廃止済（migration `_section_page_id_not_null`）。
/// title / contentHtml / contentJson 列は廃止し config JSON に統合済（CUSTOM section の title +
/// body は config.title + config.body で編集、migration `_drop_section_legacy_columns_*` 参照）。
model Section {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @db.Uuid
  type      String   @db.VarChar(64)
  order     Int      @default(0) // 表示順序（DnDで変更可能）
  isActive  Boolean  @default(true) // ON/OFF制御
  config    Json     @default("{}") // タイプ別設定（Zodで型安全）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order, isActive])
  @@index([type])
  @@map("sections")
}

model NavigationItem {
  id       String         @id @default(uuid()) @db.Uuid
  type     NavigationType
  parentId String?        @db.Uuid
  /// Sanity Portable Text 互換の token 配列（{type:"text",value} | {type:"icon",name}）。
  /// テキスト + アイコンの混在を任意位置で表現する SSoT。空配列 [] は許容しない（空ナビ防止は admin form 層で）。
  /// icon-only モードは禁止（NN/g 準拠 — 必ず text token と併記、SR は text のみ読み上げ）。
  label      Json
  url        String
  isExternal Boolean        @default(false)
  order      Int
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Self-relation for submenus
  parent   NavigationItem?  @relation("NavigationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavigationHierarchy")

  @@index([type, order])
  @@index([parentId])
  @@map("navigation_items")
}

model SocialLink {
  id            String         @id @default(uuid()) @db.Uuid
  platform      SocialPlatform
  url           String
  order         Int
  isActive      Boolean        @default(true)
  showOnDesktop Boolean        @default(true) // デスクトップで表示
  showOnMobile  Boolean        @default(true) // モバイルで表示
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([order])
  @@map("social_links")
}

// ==============================================
// FAQ Models
// ==============================================

model FaqCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?   @db.Text
  icon        String? // キュレーション済みアイコン名（任意、SpaceCategory.icon と同方式）
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  items FaqItem[]

  @@index([order])
  @@index([isActive, order])
  @@index([deletedAt])
  @@map("faq_categories")
}

model FaqItem {
  id              String    @id @default(uuid()) @db.Uuid
  categoryId      String    @db.Uuid
  question        String
  answer          String    @db.Text // 回答（プレーンテキスト、改行保持）
  order           Int       @default(0)
  isPublished     Boolean   @default(true)
  publishedAt     DateTime?
  deletedAt       DateTime?
  viewCount       Int       @default(0) // 公開ページでの閲覧回数（集計値、localStorage で dedup）
  lastViewedAt    DateTime? // 直近閲覧日時（人気度の新鮮度判断用）
  helpfulCount    Int       @default(0) // 「役に立った」投票数（localStorage で dedup）
  notHelpfulCount Int       @default(0) // 「役に立たなかった」投票数（localStorage で dedup）
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  category FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, order])
  @@index([categoryId, isPublished, order])
  @@index([isPublished])
  @@index([deletedAt])
  @@index([updatedAt])
  @@index([viewCount])
  @@map("faq_items")
}

// ==============================================
// Settings (Singleton)
// ==============================================

model Settings {
  id        String   @id @default("singleton")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Site Basic Info
  // favicon は dynamic icon Route Handler (src/app/icon/route.tsx) 経由で配信する。
  // ここに保存された URL は R2 オブジェクト URL を期待し、Route Handler が DB query →
  // R2 から binary pass-through する。空文字 ("") なら ImageResponse で default fallback。
  // NOT NULL + DEFAULT '' で型を `string` に強化（codebase の他 nullable string 列とは
  // 一貫性が崩れるが、null と空文字の二重表現を排除する意図的な強化）。
  // generateMetadata からは静的 URL `/icon` を icons.icon に注入し DB query しないため、
  // PR #699 の build-time prerender 汚染懸念には抵触しない。
  siteName           String?
  siteDescription    String? @db.Text
  faviconUrl         String  @default("")
  defaultOgpImageUrl String?
  headerLogoUrl      String?
  footerLogoUrl      String?
  footerCopyright    String?

  // Logo Display Settings
  useHeaderLogo Boolean @default(true)
  useFooterLogo Boolean @default(true)

  // Business Info (事業者情報)
  businessName        String? // 会社名・屋号
  businessNameKana    String? // 会社名・屋号（カナ） — JSON-LD alternateName で公開
  representativeName  String? // 代表者名
  establishedDate     DateTime? // 設立日
  registrationNumber  String? // 法人番号/登録番号 — 特商法表記で公開
  invoiceNumber       String? // インボイス登録番号
  businessDescription String?   @db.Text // 事業概要

  // Contact Info
  // 表示用住所は postalCode + prefecture + city + streetAddress + buildingName から派生（SSoT）
  phoneNumber   String?
  faxNumber     String?
  email         String?
  postalCode    String? // 郵便番号
  prefecture    String? // 都道府県
  city          String? // 市区町村
  streetAddress String? // 番地以降
  buildingName  String? // 建物名

  // Business Hours (営業時間)
  businessHours   Json? // 曜日ごとの営業時間
  regularHolidays Json? // 定休日（曜日）
  holidayNotice   String? @db.Text // 休業日のお知らせ

  // Access Info (アクセス情報)
  // 交通案内・駐車場案内は Location 単位（multi-location）が SSoT。
  // Settings 側の旧 accessInfo / parkingInfo は 2026-05-01 に廃止。

  // Email Settings
  // 送信元(From)は env (EMAIL_FROM / EMAIL_FROM_NAME) 優先・DB フォールバックの
  // env-OR-DB（API キー / Stripe / Turnstile と同方式）。senderEmail/senderName は
  // 管理画面のメール設定で運用者が設定でき、保存時に Resend 検証済みドメインと照合する。
  senderEmail                       String?
  senderName                        String?
  replyToEmail                      String?

  // SEO Settings
  defaultMetaDescription String?
  defaultMetaKeywords    String?
  defaultOgpTitle        String?
  defaultOgpDescription  String?

  // Layout Settings (レイアウト設定)
  containerWidth        LayoutWidth?
  containerWidthCustom  Int? // CUSTOMの場合の幅（px）
  contentWidth          LayoutWidth?
  contentWidthCustom    Int? // CUSTOMの場合の幅（px）
  headerScrollBehavior  HeaderScrollBehavior @default(always_visible)
  headerBackgroundMode  HeaderBackgroundMode @default(solid)

  // Footer Settings (フッター設定)
  footerTagline         String?
  footerNavigationLabel String  @default("Navigation")
  footerContactLabel    String  @default("Contact")
  footerHoursLabel      String  @default("Hours")
  footerShowSocialLinks Boolean @default(true)

  // Theme
  themeColor String @default("#fafafa")

  // Sidebar Settings (サイドバー設定)
  sidebarEnabled      Boolean @default(true) // サイドバー全体の有効/無効
  sidebarWidgets      Json    @default("{\"search\":true,\"recent\":true,\"popular\":true,\"categories\":true,\"tags\":true}") // ウィジェット個別設定
  sidebarRecentCount  Int     @default(5) // 新着記事の表示件数
  sidebarPopularCount Int     @default(5) // 人気記事の表示件数
  sidebarTocEnabled   Boolean @default(true) // 公開記事詳細ページの目次サイドバー表示（グローバル）

  // Analytics Settings（Enum化）
  analyticsType         AnalyticsType? // ga4 | gtm | null
  googleAnalyticsId     String? // GA4 Measurement ID (G-XXXXXXXXXX)
  googleTagManagerId    String? // GTM Container ID (GTM-XXXXXXX)
  googleSearchConsoleId String? // GSC verification meta tag
  bingWebmasterToolsId  String? // Bing verification meta tag
  gaPropertyId          String? // GA4 Property ID for Data API
  microsoftClarityId    String? // Microsoft Clarity Project ID（ヒートマップ・セッション録画、GA4/GTM と独立）

  // Reservation Settings（常に有効な整数。未設定行は DB default で埋めたうえで NOT NULL）
  defaultTimeSlot                  Int     @default(60)
  minReservationDuration           Int     @default(60)
  maxReservationDuration           Int     @default(480)
  sendReservationConfirmationEmail Boolean @default(true)

  // Discount Settings (割引設定) - Enum化
  durationDiscountEnabled Boolean                @default(false)
  durationDiscountRules   Json                   @default("[]")
  discountCombinationMode DiscountCombinationMode @default(best)
  showOriginalPrice       Boolean                @default(true)

  // Tax Settings (消費税設定) - Enum化
  taxStandardRate      Decimal        @default(10) @db.Decimal(5, 2)
  taxReducedRate       Decimal        @default(8) @db.Decimal(5, 2)
  taxDisplayModePublic TaxDisplayMode @default(tax_included)

  // Notification Settings（管理者通知のイベント別トグル）
  notifyNewReservation       Boolean @default(true)
  notifyReservationChange    Boolean @default(true)
  notifyReservationCancel    Boolean @default(true)
  notifyNewInquiry           Boolean @default(true)
  notifyEventRegistration    Boolean @default(true)
  notifyEventCancellation    Boolean @default(true)
  // 通知先: スタッフ(User.id 配列・送信時に現在メールへ解決) ＋ カスタムメール(カンマ区切り)
  notificationStaffIds       Json?
  notificationEmailAddresses String?

  // Other Settings
  // timezone / language 列は 2026-06-20 撤去。日付整形は date-format.ts が "Asia/Tokyo" を、
  // html lang は layout が "ja" を固定使用しており、設定値は保存経路も consumer も無かった。
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String? @db.Text

  // Stripe Payment Settings
  // test/live モードは API キーの接頭辞（sk_test_ / sk_live_）が決定者。
  // 別途トグルを持つと UI と実挙動が乖離するため列は持たない（2026-06-20 撤去）。
  stripeEnabled          Boolean   @default(false)
  stripePublishableKey   String?
  stripeSecretKey        String?   @db.Text // 暗号化して保存
  stripeWebhookSecret    String?   @db.Text // 暗号化して保存
  stripeAccountId        String?
  stripeCurrency         String    @default("jpy")
  stripeLastTestedAt     DateTime?
  stripeConnectionStatus String?

  // Cookie Consent Settings
  cookieConsentEnabled    Boolean @default(false)
  cookieConsentMessage    String? @db.Text
  cookieConsentAcceptText String?
  cookieConsentRejectText String?
  cookieConsentPolicyUrl  String?

  // Announcement Bar Carousel Settings - Enum化
  announcementBarAnimation         AnnouncementBarAnimation    @default(fade)
  announcementBarDuration          Int                         @default(5000)
  announcementBarAutoPlay          Boolean                     @default(true)
  announcementBarPauseOnHover      Boolean                     @default(true)
  announcementBarShowArrows        Boolean                     @default(true)
  announcementBarShowIndicator     Boolean                     @default(true)
  announcementBarDesignStyle       AnnouncementBarDesignStyle   @default(solid)
  // Announcement Bar Common Color Settings
  announcementBarBgColor           String? // 共通背景色（カスタム）
  announcementBarTextColor         String? // 共通文字色（カスタム）
  // Striped Design Settings
  announcementBarStripeColor       String? // ストライプ色（カスタム）
  announcementBarStripeAnimation   Boolean @default(false) // ストライプアニメーション
  // Gradient Design Settings
  announcementBarGradientAnimation Boolean @default(false) // グラデーションアニメーション
  // Glass Design Settings
  announcementBarGlassAnimation    Boolean @default(false) // グラス（シマー）アニメーション
  announcementBarSticky            Boolean @default(false) // スクロール時に固定表示

  // ==============================================
  // External Service API Keys
  // ==============================================

  // Resend Email Service
  resendApiKey           String?   @db.Text // Encrypted
  resendLastTestedAt     DateTime?
  resendConnectionStatus String? // 'connected' | 'error'

  // Cloudflare Turnstile (Bot Protection)
  turnstileSiteKey          String? // Public key (not encrypted)
  turnstileSecretKey        String?   @db.Text // Encrypted
  turnstileLastTestedAt     DateTime?
  turnstileConnectionStatus String?

  // Google Maps API
  googleMapsApiKey           String?   @db.Text // Encrypted
  googleMapsLastTestedAt     DateTime?
  googleMapsConnectionStatus String?

  // Cloudflare CDN (Cache Purge API) — env-only に移行済み（CLOUDFLARE_ZONE_ID /
  // CLOUDFLARE_API_TOKEN）。DB 列は contract migration で DROP 済み。

  // Custom API Keys (Generic key-value storage)
  // Format: { "id": { "name": "...", "key": "encrypted", "value": "encrypted", ... } }
  customApiKeys Json? @default("{}")

  // ==============================================
  // Google Calendar Integration
  // ==============================================

  // サービスアカウント連携（共有カレンダー用）
  googleCalendarEnabled            Boolean   @default(false)
  googleCalendarServiceAccountJson String?   @db.Text // 暗号化されたJSON認証情報
  googleCalendarId                 String? // 共有カレンダーID
  googleCalendarLastTestedAt       DateTime?
  googleCalendarConnectionStatus   String? // 'connected' | 'error'

  // Google Business Profile sync
  googleBusinessProfileEnabled Boolean @default(false)
  googleBusinessProfileAuth    Json?   // { encrypted: string } envelope (中身は { accessToken, refreshToken, expiresAt, accountId } を encrypt() した ciphertext)

  // Google Meet ビデオ会議自動生成
  googleCalendarMeetEnabled Boolean @default(false)

  // リマインダー設定: null=Googleカレンダー既定を使う, 0=通知なし, N=N分前にメール通知
  googleCalendarReminderMinutes Int?

  // 予約者向けiCal設定
  icalAttachmentEnabled     Boolean @default(true) // メールにiCal添付
  addToCalendarLinksEnabled Boolean @default(true) // Add to Calendarリンク表示

  // ==============================================
  // Google Calendar 双方向同期（Phase 4）
  // ==============================================

  // 同期方式設定 - Enum化
  googleCalendarTwoWaySyncEnabled  Boolean            @default(false)
  googleCalendarSyncMethod         CalendarSyncMethod @default(polling)

  // 同期状態
  googleCalendarSyncToken    String?   @db.Text // 増分同期用トークン
  googleCalendarLastSyncedAt DateTime? // 最終同期日時

  // イベントインポート設定
  eventImportEnabled   Boolean @default(false)
  eventImportSyncToken String? @db.Text

  /// Feature Module ON/OFF SSoT（Sanity / Stripe Capabilities 流の declarative composition）。
  /// 形式: `Record<FeatureModule, boolean>` — 全 9 module（spaces / reservation / events / posts / news / faq / access / contact / reviews）。
  /// OFF module は public route 404 / nav prune / sitemap prune / section registry filter / cron 早期 return に伝播。
  /// SSoT: `@/shared/lib/features/registry` の FEATURE_MODULES。seed.ts と migration が全 module を explicit に保つ。
  featureModules Json @default("{}")

  // Webhook設定（Push Notifications）
  googleCalendarWebhookChannelId  String? // Webhook チャンネルID
  googleCalendarWebhookResourceId String? // Webhook リソースID
  googleCalendarWebhookExpiration DateTime? // Webhook 有効期限
  googleCalendarWebhookToken      String? // Webhook 認証トークン (x-goog-channel-token)

  // ==============================================
  // Instagram連携 - Enum化
  // ==============================================
  instagramAccessToken     String?            @db.Text // Encrypted
  instagramTokenExpiresAt  DateTime?
  instagramUserId          String?
  instagramUsername         String?
  instagramAccountType     String?

  // Mypage Deadline Settings（マイページ操作期限）
  cancellationDeadlineHours  Int @default(24) // キャンセル可能期限（時間前）
  modificationDeadlineHours  Int @default(24) // 変更可能期限（時間前）

  @@map("settings")
}

