  footerShowSocialLinks Boolean @default(true)

  // Theme
  themeColor String @default("#fafafa")

  // Sidebar Settings (サイドバー設定)
  sidebarEnabled      Boolean @default(true) // サイドバー全体の有効/無効
  sidebarWidgets      Json    @default("{\"search\":true,\"recent\":true,\"popular\":true,\"categories\":true,\"tags\":true}") // ウィジェット個別設定
  sidebarRecentCount  Int     @default(5) // 新着記事の表示件数
  sidebarPopularCount Int     @default(5) // 人気記事の表示件数
  sidebarTocEnabled   Boolean @default(true) // 公開記事詳細ページの目次サイドバー表示（グローバル）

  // Permalink Settings (パーマリンク設定)
