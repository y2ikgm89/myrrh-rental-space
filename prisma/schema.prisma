// =============================================================================
// iCal Feed Token
// =============================================================================

/// iCalフィード公開用トークン
model ICalToken {
  id         String    @id @default(uuid()) @db.Uuid
  token      String    @unique // 公開URL用トークン（32バイトBase64URL）
  name       String // トークン名（識別用）
  spaceId String? @db.Uuid // null = 全予約、指定時 = 特定スペースのみ
  createdBy String @db.Uuid // 作成した管理者ID
