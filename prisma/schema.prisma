  // Google Calendar 双方向同期（Phase 4）
  // ==============================================

  // 同期方式設定 - Enum化
  googleCalendarTwoWaySyncEnabled Boolean            @default(false)
  googleCalendarSyncMethod        CalendarSyncMethod @default(polling)

  // 同期状態
  googleCalendarSyncToken    String?   @db.Text // 増分同期用トークン
  googleCalendarLastSyncedAt DateTime? // 最終同期日時

  // イベントインポート設定
  eventImportEnabled   Boolean @default(false)
  eventImportSyncToken String? @db.Text

  /// Feature Module ON/OFF SSoT（Sanity / Stripe Capabilities 流の declarative composition）。
  /// 形式: `Record<FeatureModule, boolean>` — 全 module（spaces / reservation / events / posts / news / faq / access / contact / reviews / data-retention）。
  /// OFF module は public route 404 / nav prune / sitemap prune / section registry filter / cron 早期 return に伝播。
  /// SSoT: `@/shared/lib/features/registry` の FEATURE_MODULES。seed.ts と migration が全 module を explicit に保つ。
  featureModules Json @default("{}")

  /// データ保持ポリシー — 保持期間経過後の PII 削除・匿名化に使う月数（0 = opt-out）。
  /// 形式: `{ sessionMonths, verificationMonths, loginAttemptMonths, reservationGuestMonths, inquiryMonths, customerInactiveMonths }`。
  /// SSoT: `parseDataRetentionConfig` (`src/shared/lib/json-validators.ts`)。
  /// デフォルトは規約テンプレの保持期間に合わせた: Session/Verification/login_attempts 6mo、Reservation.guest* 12mo、Inquiry 36mo、INACTIVE Customer 84mo。
  /// 実 purge は feature module `data-retention` が ON かつ月数 > 0 のときのみ cron から実行される (`/api/cron/data-retention`)。
  dataRetention Json @default("{\"sessionMonths\":6,\"verificationMonths\":6,\"loginAttemptMonths\":6,\"reservationGuestMonths\":12,\"inquiryMonths\":36,\"customerInactiveMonths\":84}")

  // Webhook設定（Push Notifications）
  googleCalendarWebhookChannelId  String? // Webhook チャンネルID
  googleCalendarWebhookResourceId String? // Webhook リソースID
  googleCalendarWebhookExpiration DateTime? // Webhook 有効期限
  googleCalendarWebhookToken      String? // Webhook 認証トークン (x-goog-channel-token)

  // ==============================================
  // Instagram連携 - Enum化
  // ==============================================
  instagramAccessToken    String?   @db.Text // Encrypted
  instagramTokenExpiresAt DateTime?
  instagramUserId         String?
  instagramUsername       String?
  instagramAccountType    String?

  // ==============================================
  // SwitchBot スマートロック連携
  // ==============================================
  switchbotEnabled               Boolean   @default(false)
  switchbotOpenToken             String?   @db.Text // Encrypted
  switchbotSecretKey             String?   @db.Text // Encrypted
  switchbotConnectionStatus      String? // 'connected' | 'error'
  switchbotLastTestedAt          DateTime?
  // 予約開始/終了時刻の前後に持たせるパスコード有効バッファ（分）。早期到着・退出遅れの猶予。
  switchbotPasscodeBufferMinutes Int       @default(15)
  // Webhook URL 難読化用トークン（SwitchBot は inbound webhook の署名検証機構を提供しないため、
  // 推測困難な URL パスセグメント + deviceMac 照合の二重防御で代替する）
  switchbotWebhookPathToken      String?   @db.Text // Encrypted

  // Mypage Deadline Settings（マイページ操作期限）
  cancellationDeadlineHours Int @default(24) // キャンセル可能期限（時間前）
  modificationDeadlineHours Int @default(24) // 変更可能期限（時間前）

  @@map("settings")
}

