// レートリミット
// =============================================================================

/// ログイン試行記録（レートリミット用）
model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String // IPアドレス or メールのハッシュ
  email      String // 試行されたメールアドレス
  success    Boolean // 成功/失敗
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([email, createdAt])
  @@map("login_attempts")
}

// =============================================================================
// 規約管理（clean-break rebuild）
// =============================================================================

/// 規約の適用先スコープ。1 規約は複数 scope を持てる (多対多風)。
/// 公開 4 経路の同意必須を SSoT 制御する。新 scope 追加は ALTER TYPE ADD VALUE のみ。
/// 旧 requiredAtReservation/Inquiry/Signup 3 boolean は本 enum に統合 (PR: terms-domain overhaul)。
enum TermsScope {
  LOGIN_SIGNUP // /login 社会ログインの新規登録時
  RESERVATION // スペース予約フォーム (/reservation step3)
  INQUIRY // お問い合わせフォーム (/contact + 各 ContactFormSection)
  EVENT_REGISTRATION // イベント申込フォーム (/events/[slug] 申込)
}

/// 規約マスター（最新版を直接保存。バージョン履歴は同意記録の contentSnapshot で代替）
model TermsDocument {
  id           String       @id @default(uuid()) @db.Uuid
  type         String       @db.VarChar(64) // VARCHAR で柔軟化（旧 TermsType enum 廃止）
  slug         String       @unique @db.VarChar(50)
  title        String       @db.VarChar(100)
  contentJson  Json // Lexical EditorState
  contentHtml  String       @db.Text // SSR / 同意記録 snapshot 用（保存時 sanitize-html で再生成）
  isPublished  Boolean      @default(false)
  publishedAt  DateTime?
  /// 適用 scope 配列。空配列 = フッター掲載専用 (どの consent フォームにも出ない)。
  scopes       TermsScope[]
  /// 改訂時の周知文 (民法 548 条の 4 周知義務対応・任意)。
  changelog    String?      @db.Text
  showInFooter Boolean      @default(true)
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  agreements TermsAgreement[]

  @@unique([displayOrder], map: "terms_documents_displayOrder_active_key", where: { deletedAt: null })
  @@index([type])
  @@index([deletedAt, isPublished])
  @@index([showInFooter, isPublished, displayOrder])
  @@map("terms_documents")
}

/// 規約同意記録（証跡）— 同意時の HTML スナップショットを保持しバージョン履歴を兼ねる
model TermsAgreement {
  id              String     @id @default(uuid()) @db.Uuid
  termsId         String     @db.Uuid
  customerId      String?    @db.Uuid
  guestEmail      String?    @db.VarChar(255)
  contentSnapshot String     @db.Text // 同意時 HTML 完全保存
  contentHash     String     @db.VarChar(64) // sha256(contentSnapshot)
  agreedAt        DateTime   @default(now())
  /// 同意が発生した scope (旧 context VARCHAR を enum 化)。
  scope           TermsScope
  resourceId      String?    @db.Uuid // 予約 ID / 問い合わせ ID / イベント申込 ID 等
  ipAddress       String?    @db.VarChar(45)
  userAgent       String?    @db.Text

  terms    TermsDocument @relation(fields: [termsId], references: [id], onDelete: Restrict)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([termsId])
  @@index([customerId])
  @@index([resourceId])
  @@index([agreedAt])
  @@index([scope, agreedAt])
  @@map("terms_agreements")
}

// =============================================================================
// エディタコメント（Lexical MarkNode連携）
// =============================================================================

/// エディタコメントスレッド（Lexical MarkNodeに紐づく）
model EditorCommentThread {
  id          String              @id @default(uuid()) @db.Uuid
  markId      String // Lexical MarkNode ID（エディタ内での一意識別子）
  contentType String // コンテンツタイプ: "post" | "news" | "page" | "faq"
  contentId   String              @db.Uuid // コンテンツID（Post.id, News.id, Page.id, FaqItem.id）
  quotedText  String              @db.Text // マークされたテキスト（参照用）
  status      EditorCommentStatus @default(ACTIVE)
  resolvedAt  DateTime? // 解決日時
  resolvedBy  String?             @db.Uuid // 解決者ID（User.id）- ユーザー削除時にnull化
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdBy   String?             @db.Uuid // 作成者ID（User.id）- ユーザー削除時にnull化

  // Relations
  comments EditorComment[]
  creator  User?           @relation("CommentThreadCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  resolver User?           @relation("CommentThreadResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  // 同一コンテンツ内でmarkIdは一意
  @@unique([markId, contentType, contentId])
  @@index([contentType, contentId, status])
  @@index([createdBy])
  @@index([status, createdAt])
  @@map("editor_comment_threads")
}

/// エディタコメント（スレッド内の個別コメント）
model EditorComment {
  id        String    @id @default(uuid()) @db.Uuid
  threadId  String    @db.Uuid
  content   String    @db.Text // コメント本文
  isDeleted Boolean   @default(false) // ソフトデリート
  deletedAt DateTime? // 削除日時
  deletedBy String?   @db.Uuid // 削除者ID（User.id）- ユーザー削除時にnull化
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid // 作成者ID（User.id）- ユーザー削除時にnull化

  // Relations
  thread  EditorCommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  creator User?               @relation("EditorCommentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  deleter User?               @relation("EditorCommentDeleter", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([createdBy])
  @@index([isDeleted])
  @@map("editor_comments")
}

/// エディタブロックテンプレート（再利用可能なブロック）
model BlockTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String // テンプレート名
  description String?  @db.Text // 説明
  nodeJson    Json // Lexical SerializedEditorState JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?  @db.Uuid // 作成者ID（User.id）- ユーザー削除時にnull化

  // Relations
  creator User? @relation("BlockTemplateCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([createdBy])
  @@index([createdAt])
  @@map("block_templates")
}

// ==============================================
// Space Review Model (スペースレビュー)
// ==============================================

model SpaceReview {
  id            String    @id @default(uuid()) @db.Uuid
  spaceId       String    @db.Uuid
  customerId    String    @db.Uuid
  reservationId String    @unique @db.Uuid
  rating        Int
  title         String?   @db.VarChar(100)
  comment       String?   @db.VarChar(1000)
  isPublished   Boolean   @default(true)
  replyBody     String?   @db.VarChar(1000)
  repliedAt     DateTime?
  repliedById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  space       Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  repliedBy   User?       @relation("SpaceReviewReplyAuthor", fields: [repliedById], references: [id], onDelete: SetNull)

  @@index([spaceId, isPublished, createdAt(sort: Desc)])
  @@index([customerId])
  @@index([repliedById])
  @@map("space_reviews")
}

// ==============================================
// Event Time Slot Model (イベントタイムスロット)
// ==============================================

/// イベントの時間枠（例: 9:00-10:00 定員5名）。
/// 1 イベント = 複数スロット。スロット単位で申込・定員・GCal を管理する。
/// startAt / endAt は Timestamptz(6) で UTC 保存、JST 表示は date-format.ts SSoT。
/// capacity は NOT NULL かつ 1 以上 — スロット単位の具体的な座席数が SSoT。
/// googleCalendarEventId は Google が返す base32hex ID を保存（こちらの cuid とは別）。
model EventTimeSlot {
  id                    String   @id @default(cuid(2)) @db.VarChar(30)
  eventId               String   @db.VarChar(30)
  startAt               DateTime @db.Timestamptz(6)
  endAt                 DateTime @db.Timestamptz(6)
  capacity              Int
  googleCalendarEventId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  /// 同一イベントで同時刻スロット二重登録を防ぐ
  @@unique([eventId, startAt])
  @@index([eventId, startAt])
  /// 手書き index（20260713044626_event_reservation_cross_overlap_constraint migration で追加）。
  /// CONSTRAINT TRIGGER check_event_slot_no_reservation_overlap() のクロステーブル
  /// range クエリ (startAt, endAt) を高速化する。DROP されると deferred trigger が劣化するため
  /// diff engine に既存物として認識させる目的の宣言。
  @@index([startAt, endAt], map: "event_time_slots_time_range_idx")
  @@map("event_time_slots")
}

// ==============================================
// Event Model (イベント)
// ==============================================

model Event {
  id                   String            @id @default(cuid()) @db.VarChar(30)
  title                String            @db.VarChar(200)
  slug                 String            @unique @db.VarChar(100)
  /// Lexical EditorState JSON（正本）
  descriptionJson      Json
  /// Lexical → 公開表示用 HTML キャッシュ（SanitizedHtml で出力）
  descriptionHtml      String            @db.Text
  /// SEO description / カード要約 / メタデータ用プレーンテキスト派生
  descriptionPlainText String            @db.Text
  thumbnailUrl         String?
  ogpImageUrl          String?
  ogpTitle             String?
  ogpDescription       String?
  metaDescription      String?           @db.Text
  metaKeywords         String?
  /// 号室・フロア・補足情報または外部会場名。
  /// locationId/spaceId と併用時は補足情報（フロア・入口案内等）、
  /// 両方 null のときは外部会場名として使う。
  addressDetail        String?           @db.VarChar(200)
  /// 会場（本館・渋谷店等）。null = 外部会場または未設定
  locationId           String?           @db.Uuid
  /// 会場内のスペース。null = 会場全体 or 外部会場
  spaceId              String?           @db.Uuid
  status               EventStatus       @default(DRAFT)
  /// 開催方式。予約対象は常に EventTimeSlot。
  /// DB trigger で SINGLE_OCCURRENCE=スロット1件、TIMED_ENTRY=スロット2件以上を強制。
  /// 新規作成時は必ず明示指定する。DB default は置かない。
  scheduleMode         EventScheduleMode
  registrationOpen     Boolean           @default(true)
  /// 申込締切日時（null = 最初のスロット開始時刻まで受付）。スロット startAt 以前必須。
  registrationDeadline DateTime?         @db.Timestamptz(6)
  publishedAt          DateTime?
  deletedAt            DateTime?
  deletedById          String?           @db.Uuid
  /// 写真ギャラリー (本文外の最上位画像一覧)。GalleryItem[] = { url, alt, caption }[]。最大20件。
  gallery              Json              @default("[]")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  /// MIN(slots.startAt) の非正規化キャッシュ。スロット変更時に commands 層で同期。
  /// null = スロット未登録。ORDER BY / フィルタ用途に特化。slots.startAt と型を合わせ TIMESTAMPTZ(6)。
  firstSlotStartAt     DateTime?         @db.Timestamptz(6)
  /// MAX(slots.endAt) の非正規化キャッシュ。firstSlotStartAt と対称。
  /// 「終了が遅い順」ソート (past タブ既定) を semantic に支える。
  lastSlotEndAt        DateTime?         @db.Timestamptz(6)

  location      Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  space         Space?              @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  deletedBy     User?               @relation("EventDeletions", fields: [deletedById], references: [id], onDelete: SetNull)
  registrations EventRegistration[]
  tickets       EventTicket[]
  slots         EventTimeSlot[]

  @@index([status])
  @@index([locationId])
  @@index([spaceId])
  @@index([deletedAt])
  @@index([firstSlotStartAt])
  @@index([lastSlotEndAt])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' — searchEvents ORs
  // title/slug; both branches need trigram to avoid Seq Scan fallback.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "events_title_trgm_idx")
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "events_slug_trgm_idx")
  /// 手書き partial index（20260713044626_event_reservation_cross_overlap_constraint migration で追加）。
  /// CONSTRAINT TRIGGER check_event_no_reservation_overlap() のクロステーブルクエリを高速化する。
  /// partialIndexes preview feature は @@index の where にも対応する（@@unique 専用ではない、
  /// `prisma migrate diff` で実証済み）。where 省略の base index 宣言だけでは diff engine が
  /// 述語差分を検知し CREATE INDEX を再提案するため、実 DB と同一の predicate を明示する。
  @@index([spaceId], map: "events_spaceId_alive_idx", where: { deletedAt: null, spaceId: { not: null } })
  @@map("events")
}

// ==============================================
// Event Ticket Model (イベントチケット種別)
// ==============================================

model EventTicket {
  id          String   @id @default(cuid()) @db.VarChar(30)
  eventId     String   @db.VarChar(30)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  price       Int
  capacity    Int?
  /// 1申込あたりの人数単位（1 = 1名、2 = 2名セット 等）
  unitSize    Int      @default(1)
  sortOrder   Int      @default(0)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@unique([eventId, sortOrder], map: "event_tickets_eventId_sortOrder_key")
  @@index([eventId, sortOrder])
  @@index([eventId, isAvailable])
  @@map("event_tickets")
}

// ==============================================
// Event Registration Model (イベント申込)
// ==============================================

model EventRegistration {
  id          String             @id @default(cuid()) @db.VarChar(30)
  eventId     String             @db.VarChar(30)
  /// 申込対象タイムスロット。イベント申込は必ず 1 つの時間枠に属する。
  slotId      String             @db.VarChar(30)
  ticketId    String             @db.VarChar(30)
  name        String             @db.VarChar(100)
  // 公開申込では必須・walk-in (当日参加) では任意のため nullable
  email       String?            @db.VarChar(255)
  phone       String?            @db.VarChar(20)
  note        String?            @db.Text
  quantity    Int                @default(1)
  status      RegistrationStatus @default(CONFIRMED)
  customerId  String?            @db.Uuid
  cancelledAt DateTime?
  cancelledByType String? @db.VarChar(20) // "CUSTOMER_MYPAGE" | "CUSTOMER_TOKEN" | "ADMIN" (CANCELLED_BY SSoT: src/shared/lib/validations/enums/helpers.ts)
  // 当日受付 (check-in) 打刻時刻。null = 未来場・値あり = 来場確認済
  attendedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // iCal RFC 5545 SEQUENCE (increments on update/cancel)
  icsSequence Int @default(0)

  // Waitlist columns (Plan: 2026-07-13-event-waitlist)
  waitlistedAt DateTime? @db.Timestamptz(6) // WAITLISTED になった時刻 (FIFO 用)
  offeredAt    DateTime? @db.Timestamptz(6) // WAITLISTED_OFFERED になった時刻
  expiresAt    DateTime? @db.Timestamptz(6) // WAITLISTED_OFFERED の 24h 期限、cron で判定

  // Reminder cron 冪等性: リマインダーメール送信済み日時（null = 未送信）。
  // Reservation.reminderSentAt と同型の atomic claim パターンで二重送信を防ぐ。
  reminderSentAt DateTime?

  // Payment (Stripe) — Reservation と同型。有料 EventTicket の Stripe Checkout 対応 (PR#9)。
  // 決済フロー実装 (PR#10) はこの schema 追加を前提とする。無料チケット (price=0) は
  // 従来通り UNPAID のまま CONFIRMED を確定させる (walk-in / 招待枠と同じ扱い)。
  paymentStatus           PaymentStatus @default(UNPAID)
  // Stripe Checkout Session の id。@unique で「同じ session が別 registration に紐づく」
  // silent bug を防ぐ (Reservation 側と同型)。
  stripeCheckoutSessionId String?       @unique
  // Stripe PaymentIntent の id。session が payment_intent に紐付いた後の webhook で
  // 保存。@unique で refund の idempotency key 用途にも使う。
  stripePaymentIntentId   String?       @unique
  // 決済確定時の請求金額のスナップショット (ticket.price × quantity)。
  // 後日 ticket.price が変わっても返金額の算定根拠を残す (会計証跡)。
  paidAmount              Int?
  paidAt                  DateTime?

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slot     EventTimeSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  ticket   EventTicket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // PR#16: 領収書 (適格請求書) の 1:1 relation
  receipt  Receipt?
  // task #9 PR#1: 部分返金の repeatable child records (append-only)
  refunds  Refund[]

  @@index([eventId])
  @@index([slotId])
  @@index([slotId, status])
  @@index([ticketId])
  @@index([customerId])
  @@index([status])
  @@index([eventId, status, createdAt])
  @@index([eventId, attendedAt])
  // Payment webhook / cron が「未確定 → PAID」の atomic claim で使う (Reservation 同型)
  @@index([paymentStatus])
  // FIFO promote 用 (waitlist plan): 同一 slot/ticket 内の WAITLISTED を waitlistedAt 昇順で取得
  @@index([slotId, ticketId, status, waitlistedAt])
  // cron scan 用 (waitlist plan): WAITLISTED_OFFERED の期限切れを status+expiresAt で走査
  @@index([status, expiresAt])
  @@map("event_registrations")
}

// ==============================================
// Receipt (PR#16) — 適格請求書 (インボイス制度) 対応
// ==============================================

/**
 * 領収書 (適格請求書要件を満たす形式)。
 *
 * 発行対象: PAID 状態の Reservation と EventRegistration。
 * 発行契機: Stripe webhook checkout.session.completed の trigger 側 tx 内で自動採番。
 * 連番: ReceiptSequence の atomic increment (Postgres sequence の代替)。
 *
 * issuerSnapshot は Settings (invoiceNumber / 事業者名 / 所在地) の凍結 copy。
 * Settings 側 invoiceNumber を後日書き換えても既発行分は影響を受けない
 * (append-only の証跡性)。
 *
 * 再発行 (reissuedFromId 参照) 時は **新しい serialNo を採番** し、元 Receipt の
 * `reservationId` / `eventRegistrationId` を NULL 化 (orphan 化) することで
 * @unique(reservationId) / @unique(eventRegistrationId) 制約を維持したまま新 Receipt を
 * 同予約 / イベント申込に付け替える。revision は「何回目の再発行か」を示す counter
 * (元 = 0、1 回目 reissue = 1)。元 Receipt は監査証跡として残り、reissuedTo chain 経由で辿れる。
 * これは Codex P1 (PR #1129, comment 3589127451) を機に明文化した business contract。
 */
/// Refund — 部分返金 (partial refund) を repeatable な子レコードとして表現する。
///
/// Foundation gap analysis (2026-07-15) task #9 PR#1、Codex review P2 (PR #1123) 対応。
/// 累積 refundedAmount + 単一 stripeRefundId scalar 設計では 2 回目以降の部分返金で
/// Stripe refund id / reason / actor が失われるため、child table に refactor した。
///
/// - reservationId / eventRegistrationId は polymorphic (どちらか片方が非 null、CHECK 制約で強制)
/// - amount は各 refund event の 個別 金額 (円、正整数)。累積は `Refund` 集計 SUM で算出
/// - stripeRefundId は Stripe refund object の id (@unique で二重返金防止 + webhook idempotency)
/// - refundedByType: "ADMIN" | "AUTO_ON_CANCEL" | "STRIPE_DASHBOARD" (AuditLog と併用)
/// - append-only (update / delete 想定なし、Refund オブジェクト 1 個 = 1 tx 完了)
model Refund {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 対象 Reservation (polymorphic、eventRegistrationId と排他)
  reservationId       String?  @db.Uuid
  /// 対象 EventRegistration (polymorphic、reservationId と排他)
  eventRegistrationId String?  @db.VarChar(30)
  /// この refund event の金額 (円、正整数)
  amount              Int
  /// 管理者入力の理由 (顧客通知メール文面にも掲載予定)
  reason              String?  @db.Text
  /// Stripe refund object の id (`re_...`)。@unique で二重返金防止 + webhook idempotency key。
  stripeRefundId      String   @unique
  /// "ADMIN" | "AUTO_ON_CANCEL" | "STRIPE_DASHBOARD" (AuditLog と併用)
  refundedByType      String   @db.VarChar(20)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  reservation       Reservation?       @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  eventRegistration EventRegistration? @relation(fields: [eventRegistrationId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@index([eventRegistrationId])
  @@index([createdAt])
  @@map("refunds")
}

model Receipt {
  /// DB 側 DEFAULT gen_random_uuid()（20260713045802_add_receipt_tables migration で手書き）。
  /// Prisma 7 の diff engine は @default(uuid()) と DB 側 gen_random_uuid() を同値と見なさず
  /// ALTER COLUMN ... DROP DEFAULT を提案するため dbgenerated で明示する。
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // 領収書番号 (グローバル連番、"YYYY-XXXXXX" 形式)
  serialNo        String   @unique @db.VarChar(20)
  issuedAt        DateTime @default(now()) @db.Timestamptz(6)
  // 発行対象 (Reservation OR EventRegistration の polymorphic)
  reservationId       String? @unique @db.Uuid
  eventRegistrationId String? @unique @db.VarChar(30)
  reservation         Reservation?       @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  eventRegistration   EventRegistration? @relation(fields: [eventRegistrationId], references: [id], onDelete: Restrict)
  // 適格請求書要件フィールド
  recipientName   String  @db.VarChar(100)
  subject         String  @default("スペース利用料として") @db.VarChar(100)
  amount          Int
  taxAmount       Int     @default(0)
  taxRate         Decimal @db.Decimal(5, 2)
  // 発行時点の Settings snapshot (凍結)
  issuerSnapshot  Json    @db.JsonB
  // 再発行系: 新 serialNo を採番し、元 Receipt の reservationId/eventRegistrationId を NULL 化。
  // 元 Receipt は監査証跡として残り、chain (reissuedTo) 経由で辿れる。
  // revision は「何回目の再発行か」を示す counter (元 = 0、1 回目 reissue = 1)。
  reissuedFromId  String?  @db.Uuid
  reissuedFrom    Receipt? @relation("ReissuedReceipts", fields: [reissuedFromId], references: [id], onDelete: SetNull)
  reissuedTo      Receipt[] @relation("ReissuedReceipts")
  reissuedReason  String?  @db.Text
  revision        Int      @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([reservationId])
  @@index([eventRegistrationId])
  @@index([issuedAt])
  @@map("receipts")
}

/**
 * 領収書連番採番テーブル (単一行、advisory lock で serialize)。
 * Postgres sequence 代替: 「YYYY-XXXXXX」形式を年ごとに管理し、
 * 年替わりで nextNo をリセットする運用に対応する。
 */
model ReceiptSequence {
  id        String   @id @default("singleton") @db.VarChar(20)
  year      Int      // 4 桁年
  nextNo    Int      @default(1) // 次に発行する連番 (1-indexed)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("receipt_sequences")
}

// ==============================================
// Admin Notification
// ==============================================

model AdminNotification {
  id           String   @id @default(uuid()) @db.Uuid
  type         String   @db.VarChar(50)
  title        String   @db.VarChar(200)
  message      String   @db.VarChar(500)
  resourceType String?  @db.VarChar(50)
  resourceId   String?  @db.Uuid
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([isRead, createdAt(sort: Desc)])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@map("admin_notification")
}

// =============================================================================
// SwitchBot スマートロック連携
// =============================================================================

enum SmartLockDeviceType {
  KEYPAD
  KEYPAD_TOUCH
  KEYPAD_VISION
  KEYPAD_VISION_PRO
  LOCK_VISION_PRO
}

enum SmartLockPasscodeStatus {
  /// createKey 呼出済み、Get Device Status での keyId 確定待ち
  PENDING
  /// keyList 突合成功（switchbotKeyId 確定済み）
  CONFIRMED
  /// API 呼出失敗、または確定ポーリングがタイムアウト
  FAILED
  /// deleteKey 済み（チェックアウト後 or キャンセルによる失効）
  REVOKED
}

/// 拠点（Location）に紐づく物理スマートロック（Keypad アクセサリ or Lock Vision Pro 単体）。
/// 1 拠点に複数台を登録できる登録簿（1:N from Location）。各Spaceはこの登録簿から
/// 最大1台を選んで使う（Space.smartLockDeviceId）ため、同じ物理ロックを複数Spaceで
/// 共有できる（例: 建物入口の共有ロックを複数の貸室が使う場合）。
model SmartLockDevice {
  id         String              @id @default(uuid()) @db.Uuid
  locationId String              @db.Uuid
  deviceId   String              @unique // SwitchBot 側の device ID（MAC アドレス）
  deviceName String
  deviceType SmartLockDeviceType
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  location            Location            @relation("LocationSmartLockDevices", fields: [locationId], references: [id], onDelete: Cascade)
  defaultForLocations Location[]          @relation("LocationDefaultSmartLockDevice")
  spaces              Space[]
  passcodes           SmartLockPasscode[]

  @@index([locationId])
  @@map("smart_lock_devices")
}

/// 予約 1 件・デバイス 1 台ごとに発行される一時パスコード。
model SmartLockPasscode {
  id            String                  @id @default(uuid()) @db.Uuid
  reservationId String                  @db.Uuid
  deviceId      String                  @db.Uuid
  status        SmartLockPasscodeStatus @default(PENDING)
  /// encrypt(purpose: "switchbot-guest-passcode") 済み。平文は DB に保持しない。
  passcodeCiphertext String             @db.Text
  /// createKey 呼出の同期レスポンス（相関確認用、keyId ではない）
  switchbotCommandId String?
  /// Get Device Status の keyList[].id（deleteKey に必須）
  switchbotKeyId     String?
  /// パスコード有効期間（予約時間 ± switchbotPasscodeBufferMinutes）
  startTime     DateTime
  endTime       DateTime
  failureReason String?
  confirmedAt   DateTime?
  revokedAt     DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  reservation Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  device      SmartLockDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([reservationId, deviceId])
  @@index([status, endTime])
  @@map("smart_lock_passcodes")
}
