// ==============================================
// CMS Models
// ==============================================

model Page {
  id              String    @id @default(uuid()) @db.Uuid
  slug            String    @unique
  title           String
  metaDescription String?
  metaKeywords    String?
  ogpTitle        String?
  ogpDescription  String?
  ogpImageUrl     String?
  isPublished     Boolean   @default(true)
  publishedAt     DateTime?
  isActive        Boolean   @default(true)
  isSystemPage    Boolean   @default(false) // システムページ（SEO/OGPのみ編集可、コンテンツ編集不可）
  template        String    @db.VarChar(64)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  sections    Section[]
  assignments UserPageAssignment[]

  @@index([isPublished, isActive])
  @@index([isSystemPage])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' — searchPages ORs
  // title/slug; both branches need trigram to avoid Seq Scan fallback.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "pages_title_trgm_idx")
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "pages_slug_trgm_idx")
  @@map("pages")
}

/// 統一セクション（システムページ + カスタムページ共通）
/// 全 section は必ず Page に紐づく（home の page-hero も含めて pageId = Page.id、seed.ts 参照）。
/// 旧仕様（pageId nullable = home section）は廃止済（migration `_section_page_id_not_null`）。
/// title / contentHtml / contentJson 列は廃止し config JSON に統合済（CUSTOM section の title +
/// body は config.title + config.body で編集、migration `_drop_section_legacy_columns_*` 参照）。
model Section {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @db.Uuid
  type      String   @db.VarChar(64)
  order     Int      @default(0) // 表示順序（DnDで変更可能）
  isActive  Boolean  @default(true) // ON/OFF制御
  config    Json     @default("{}") // タイプ別設定（Zodで型安全）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, order], map: "sections_pageId_order_key")
  @@index([pageId, order, isActive])
  @@index([type])
  @@map("sections")
}

model NavigationItem {
  id         String         @id @default(uuid()) @db.Uuid
  type       NavigationType
  parentId   String?        @db.Uuid
  /// Sanity Portable Text 互換の token 配列（{type:"text",value} | {type:"icon",name}）。
  /// テキスト + アイコンの混在を任意位置で表現する SSoT。空配列 [] は許容しない（空ナビ防止は admin form 層で）。
  /// icon-only モードは禁止（NN/g 準拠 — 必ず text token と併記、SR は text のみ読み上げ）。
  label      Json
  url        String
  isExternal Boolean        @default(false)
  order      Int
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Self-relation for submenus
  parent   NavigationItem?  @relation("NavigationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavigationHierarchy")

  @@unique([type, order], map: "navigation_items_type_order_key")
  @@index([type, order])
  @@index([parentId])
  @@map("navigation_items")
}

model SocialLink {
  id            String         @id @default(uuid()) @db.Uuid
  platform      SocialPlatform
  url           String
  order         Int
  isActive      Boolean        @default(true)
  showOnDesktop Boolean        @default(true) // デスクトップで表示
  showOnMobile  Boolean        @default(true) // モバイルで表示
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([order], map: "social_links_order_key")
  @@index([order])
  @@map("social_links")
}

// ==============================================
// FAQ Models
// ==============================================

model FaqCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?   @db.Text
  icon        String? // キュレーション済みアイコン名（任意、SpaceCategory.icon と同方式）
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  items FaqItem[]

  @@unique([order], map: "faq_categories_order_active_key", where: { deletedAt: null })
  @@index([order])
  @@index([isActive, order])
  @@index([deletedAt])
  @@map("faq_categories")
}

model FaqItem {
  id              String    @id @default(uuid()) @db.Uuid
  categoryId      String    @db.Uuid
  question        String
  answer          String    @db.Text // 回答（プレーンテキスト、改行保持）
  order           Int       @default(0)
  isPublished     Boolean   @default(true)
  publishedAt     DateTime?
  deletedAt       DateTime?
  viewCount       Int       @default(0) // 公開ページでの閲覧回数（集計値、localStorage で dedup）
  lastViewedAt    DateTime? // 直近閲覧日時（人気度の新鮮度判断用）
  helpfulCount    Int       @default(0) // 「役に立った」投票数（localStorage で dedup）
  notHelpfulCount Int       @default(0) // 「役に立たなかった」投票数（localStorage で dedup）
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  category FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, order], map: "faq_items_categoryId_order_active_key", where: { deletedAt: null })
  @@index([categoryId, order])
  @@index([categoryId, isPublished, order])
  @@index([isPublished])
  @@index([deletedAt])
  @@index([updatedAt])
  @@index([viewCount])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' — searchFaqItems ORs
  // question/answer; both branches need trigram to avoid Seq Scan fallback.
  @@index([question(ops: raw("gin_trgm_ops"))], type: Gin, map: "faq_items_question_trgm_idx")
  @@index([answer(ops: raw("gin_trgm_ops"))], type: Gin, map: "faq_items_answer_trgm_idx")
  @@map("faq_items")
}

// ==============================================
// Settings (Singleton)
// ==============================================

model Settings {
  id        String   @id @default("singleton")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Site Basic Info
  // favicon は dynamic icon Route Handler (src/app/icon/route.tsx) 経由で配信する。
  // ここに保存された URL は R2 オブジェクト URL を期待し、Route Handler が DB query →
  // R2 から binary pass-through する。空文字 ("") なら ImageResponse で default fallback。
  // NOT NULL + DEFAULT '' で型を `string` に強化（codebase の他 nullable string 列とは
  // 一貫性が崩れるが、null と空文字の二重表現を排除する意図的な強化）。
  // generateMetadata からは静的 URL `/icon` を icons.icon に注入し DB query しないため、
  // PR #699 の build-time prerender 汚染懸念には抵触しない。
  siteName           String?
  siteDescription    String? @db.Text
  faviconUrl         String  @default("")
  defaultOgpImageUrl String?
  headerLogoUrl      String?
  footerLogoUrl      String?
  footerCopyright    String?

  // Logo Display Settings
  useHeaderLogo Boolean @default(true)
  useFooterLogo Boolean @default(true)

  // Business Info (事業者情報)
  businessName        String? // 会社名・屋号
  businessNameKana    String? // 会社名・屋号（カナ） — JSON-LD alternateName で公開
  representativeName  String? // 代表者名
  establishedDate     DateTime? // 設立日
  registrationNumber  String? // 法人番号/登録番号 — 特商法表記で公開
  invoiceNumber       String? // インボイス登録番号
  businessDescription String?   @db.Text // 事業概要

  // Contact Info
  // 表示用住所は postalCode + prefecture + city + streetAddress + buildingName から派生（SSoT）
  phoneNumber   String?
  faxNumber     String?
  email         String?
  postalCode    String? // 郵便番号
  prefecture    String? // 都道府県
  city          String? // 市区町村
  streetAddress String? // 番地以降
  buildingName  String? // 建物名

  // Business Hours (営業時間)
  businessHours   Json? // 曜日ごとの営業時間
  regularHolidays Json? // 定休日（曜日）
  holidayNotice   String? @db.Text // 休業日のお知らせ

  // Access Info (アクセス情報)
  // 交通案内・駐車場案内は Location 単位（multi-location）が SSoT。
  // Settings 側の旧 accessInfo / parkingInfo は 2026-05-01 に廃止。

  // Email Settings
  // 送信元(From)は env (EMAIL_FROM / EMAIL_FROM_NAME) 優先・DB フォールバックの
  // env-OR-DB（API キー / Stripe / Turnstile と同方式）。senderEmail/senderName は
  // 管理画面のメール設定で運用者が設定でき、保存時に Resend 検証済みドメインと照合する。
  senderEmail  String?
  senderName   String?
  replyToEmail String?

  // SEO Settings
  defaultMetaDescription String?
  defaultMetaKeywords    String?
  defaultOgpTitle        String?
  defaultOgpDescription  String?

  // Layout Settings (レイアウト設定)
  containerWidth       LayoutWidth?
  containerWidthCustom Int? // CUSTOMの場合の幅（px）
  contentWidth         LayoutWidth?
  contentWidthCustom   Int? // CUSTOMの場合の幅（px）
  headerScrollBehavior HeaderScrollBehavior @default(always_visible)
  headerBackgroundMode HeaderBackgroundMode @default(solid)

  // Footer Settings (フッター設定)
  footerTagline         String?
  footerNavigationLabel String  @default("Navigation")
