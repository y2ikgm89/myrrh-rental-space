// ==============================================
// Event Time Slot Model (イベントタイムスロット)
// ==============================================

/// イベントの時間枠（例: 9:00-10:00 定員5名）。
/// 1 イベント = 複数スロット。スロット単位で申込・定員・GCal を管理する。
/// startAt / endAt は Timestamptz(6) で UTC 保存、JST 表示は date-format.ts SSoT。
/// capacity は NOT NULL かつ 1 以上 — スロット単位の具体的な座席数が SSoT。
/// googleCalendarEventId は Google が返す base32hex ID を保存（こちらの uuid とは別）。
model EventTimeSlot {
  id                    String   @id @default(uuid(7)) @db.Uuid
  eventId               String   @map("event_id") @db.Uuid
  startAt               DateTime @map("start_at") @db.Timestamptz(6)
  endAt                 DateTime @map("end_at") @db.Timestamptz(6)
  capacity              Int
  googleCalendarEventId String?  @map("google_calendar_event_id")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  /// 同一イベントで同時刻スロット二重登録を防ぐ
  @@unique([eventId, startAt])
  /// 手書き index（20260713044626_event_reservation_cross_overlap_constraint migration で追加）。
  /// CONSTRAINT TRIGGER check_event_slot_no_reservation_overlap() のクロステーブル
  /// range クエリ (startAt, endAt) を高速化する。DROP されると deferred trigger が劣化するため
  /// diff engine に既存物として認識させる目的の宣言。
  @@index([startAt, endAt], map: "event_time_slots_time_range_idx")
  @@map("event_time_slots")
}

// ==============================================
// Event Category Model (イベントカテゴリー)
// ==============================================

model EventCategory {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  description String?  @db.Text
  icon        String?
  color       String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  events Event[]

  // SpaceCategory と同型: isActive:true な行の間でのみ name の一意性を強制する
  // partial unique index。無効化済みカテゴリーの名前を永久に予約しない。
  @@unique([name], map: "event_categories_name_active_key", where: { isActive: true })
  @@unique([sortOrder], map: "event_categories_sort_order_key")
  @@map("event_categories")
}

// ==============================================
// Event Model (イベント)
// ==============================================

model Event {
  id                   String            @id @default(uuid(7)) @db.Uuid
  title                String            @db.VarChar(200)
  slug                 String            @db.VarChar(100) // 一意性は下記 @@unique(where: deletedAt is null) 参照
  /// Lexical EditorState JSON（正本）
  descriptionJson      Json              @map("description_json")
  /// Lexical → 公開表示用 HTML キャッシュ（SanitizedHtml で出力）
  descriptionHtml      String            @map("description_html") @db.Text
  /// SEO description / カード要約 / メタデータ用プレーンテキスト派生
  descriptionPlainText String            @map("description_plain_text") @db.Text
  thumbnailUrl         String?           @map("thumbnail_url")
  ogpImageUrl          String?           @map("ogp_image_url")
  ogpTitle             String?           @map("ogp_title")
  ogpDescription       String?           @map("ogp_description")
  metaDescription      String?           @map("meta_description") @db.Text
  metaKeywords         String?           @map("meta_keywords")
  /// 号室・フロア・補足情報または外部会場名。
  /// locationId/spaceId と併用時は補足情報（フロア・入口案内等）、
  /// 両方 null のときは外部会場名として使う。
  addressDetail        String?           @map("address_detail") @db.VarChar(200)
  /// 会場（本館・渋谷店等）。null = 外部会場または未設定
  locationId           String?           @map("location_id") @db.Uuid
  /// 会場内のスペース。null = 会場全体 or 外部会場
  spaceId              String?           @map("space_id") @db.Uuid
  status               EventStatus       @default(DRAFT)
  /// 開催方式。予約対象は常に EventTimeSlot。
  /// DB trigger で SINGLE_OCCURRENCE=スロット1件、TIMED_ENTRY=スロット2件以上を強制。
  /// 新規作成時は必ず明示指定する。DB default は置かない。
  scheduleMode         EventScheduleMode @map("schedule_mode")
  registrationOpen     Boolean           @default(true) @map("registration_open")
  /// 申込締切日時（null = 最初のスロット開始時刻まで受付）。スロット startAt 以前必須。
  registrationDeadline DateTime?         @map("registration_deadline") @db.Timestamptz(6)
  publishedAt          DateTime?         @map("published_at") @db.Timestamptz(6)
  deletedAt            DateTime?         @map("deleted_at") @db.Timestamptz(6)
  deletedById          String?           @map("deleted_by_id") @db.Uuid
  /// 写真ギャラリー (本文外の最上位画像一覧)。GalleryItem[] = { url, alt, caption }[]。最大20件。
  gallery              Json              @default("[]")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// MIN(slots.startAt) の非正規化キャッシュ。スロット変更時に commands 層で同期。
  /// null = スロット未登録。ORDER BY / フィルタ用途に特化。slots.startAt と型を合わせ TIMESTAMPTZ(6)。
  firstSlotStartAt     DateTime?         @map("first_slot_start_at") @db.Timestamptz(6)
  /// MAX(slots.endAt) の非正規化キャッシュ。firstSlotStartAt と対称。
  /// 「終了が遅い順」ソート (past タブ既定) を semantic に支える。
  lastSlotEndAt        DateTime?         @map("last_slot_end_at") @db.Timestamptz(6)

  location      Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  space         Space?              @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  deletedBy     User?               @relation("EventDeletions", fields: [deletedById], references: [id], onDelete: SetNull)
  registrations EventRegistration[]
  tickets       EventTicket[]
  slots         EventTimeSlot[]

  /// 開催形態 (Phase B.1)。OFFLINE = 既存の物理会場のみ運用と同一 (デフォルト)。
  format          EventFormat     @default(OFFLINE)
  /// オンライン会議 URL。ONLINE/HYBRID + MANUAL provider では必須 (DB CHECK
  /// event_online_meeting_url_required で担保)。GOOGLE_MEET provider では
  /// 発行前は null、発行後に write-back される。公開ページ・JSON-LD には出力しない。
  meetingUrl      String?         @map("meeting_url") @db.VarChar(500)
  /// meetingUrl の発行元。
  meetingProvider MeetingProvider @default(MANUAL) @map("meeting_provider")

  /// Google Calendar 同期エラーメッセージ（null = 未エラー/解消済み）。
  /// slot 単位の `EventTimeSlot.googleCalendarEventId` とは別に、event 全体の
  /// 同期状態（作成失敗・Meet write-back 失敗等）を可視化する
  /// (`/api/cron/calendar-sync-retry` の retry pool 判定・admin dashboard 表示用)。
  calendarSyncError String? @map("calendar_sync_error") @db.Text

  /// イベントの種類・カテゴリー（必須）。EventCategory 側は onDelete: Restrict のため
  /// 紐づくイベントがある限り物理削除・非アクティブ化できない。
  categoryId String        @map("category_id") @db.Uuid
  category   EventCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // FaqCategory.slug と同型: slug が無条件 @unique だと、ソフトデリート済みイベントが
  // (permanentlyDelete するまで) 行として残り続ける限り同じ slug の新規作成が DB 制約で
  // 常に拒否される。ensureUniqueSlug は deletedAt: null で絞っているため partial unique
  // index に揃える。
  @@unique([slug], map: "events_slug_active_key", where: { deletedAt: null })
  @@index([status])
  @@index([categoryId])
  @@index([locationId])
  @@index([spaceId])
  @@index([deletedAt])
  @@index([firstSlotStartAt])
  @@index([lastSlotEndAt])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' — searchEvents ORs
  // title/slug; both branches need trigram to avoid Seq Scan fallback.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "events_title_trgm_idx")
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "events_slug_trgm_idx")
  /// 手書き partial index（20260713044626_event_reservation_cross_overlap_constraint migration で追加）。
  /// CONSTRAINT TRIGGER check_event_no_reservation_overlap() のクロステーブルクエリを高速化する。
  /// partialIndexes preview feature は @@index の where にも対応する（@@unique 専用ではない、
  /// `prisma migrate diff` で実証済み）。where 省略の base index 宣言だけでは diff engine が
  /// 述語差分を検知し CREATE INDEX を再提案するため、実 DB と同一の predicate を明示する。
  @@index([spaceId], map: "events_space_id_alive_idx", where: { deletedAt: null, spaceId: { not: null } })
  @@index([deletedById], map: "events_deleted_by_id_idx", where: { deletedById: { not: null } })
  @@map("events")
}

// ==============================================
// Event Ticket Model (イベントチケット種別)
// ==============================================

model EventTicket {
  id          String   @id @default(uuid(7)) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  price       Int
  capacity    Int?
  /// 1申込あたりの人数単位（1 = 1名、2 = 2名セット 等）
  unitSize    Int      @default(1) @map("unit_size")
  sortOrder   Int      @default(0) @map("sort_order")
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@unique([eventId, sortOrder], map: "event_tickets_event_id_sort_order_key")
  @@index([eventId, isAvailable])
  @@map("event_tickets")
}

// ==============================================
// Event Registration Model (イベント申込)
// ==============================================

model EventRegistration {
  id              String             @id @default(uuid(7)) @db.Uuid
  eventId         String             @map("event_id") @db.Uuid
  /// 申込対象タイムスロット。イベント申込は必ず 1 つの時間枠に属する。
  slotId          String             @map("slot_id") @db.Uuid
  ticketId        String             @map("ticket_id") @db.Uuid
  name            String             @db.VarChar(100)
  // 公開申込では必須・walk-in (当日参加) では任意のため nullable
  email           String?            @db.VarChar(255)
  phone           String?            @db.VarChar(20)
  note            String?            @db.Text
  quantity        Int                @default(1)
  status          RegistrationStatus @default(CONFIRMED)
  customerId      String?            @map("customer_id") @db.Uuid
  cancelledAt     DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancelledByType String?            @map("cancelled_by_type") @db.VarChar(20) // "CUSTOMER_MYPAGE" | "CUSTOMER_TOKEN" | "ADMIN" (CANCELLED_BY SSoT: src/shared/lib/validations/enums/helpers.ts)
  // 当日受付 (check-in) 打刻時刻。null = 未来場・値あり = 来場確認済
  attendedAt      DateTime?          @map("attended_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  // iCal RFC 5545 SEQUENCE (increments on update/cancel)
  icsSequence Int @default(0) @map("ics_sequence")

  // Waitlist columns (Plan: 2026-07-13-event-waitlist)
  waitlistedAt DateTime? @map("waitlisted_at") @db.Timestamptz(6) // WAITLISTED になった時刻 (FIFO 用)
  offeredAt    DateTime? @map("offered_at") @db.Timestamptz(6) // WAITLISTED_OFFERED になった時刻
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6) // WAITLISTED_OFFERED の 24h 期限、cron で判定

  // Reminder cron 冪等性: リマインダーメール送信済み日時（null = 未送信）。
  // Reservation.reminderSentAt と同型の atomic claim パターンで二重送信を防ぐ。
  reminderSentAt DateTime? @map("reminder_sent_at") @db.Timestamptz(6)

  // Payment (Stripe) — Reservation と同型。有料 EventTicket の Stripe Checkout 対応 (PR#9)。
  // 決済フロー実装 (PR#10) はこの schema 追加を前提とする。無料チケット (price=0) は
  // 従来通り UNPAID のまま CONFIRMED を確定させる (walk-in / 招待枠と同じ扱い)。
  paymentStatus           PaymentStatus @default(UNPAID) @map("payment_status")
  // Stripe Checkout Session の id。@unique で「同じ session が別 registration に紐づく」
  // silent bug を防ぐ (Reservation 側と同型)。
  stripeCheckoutSessionId String?       @unique @map("stripe_checkout_session_id")
  // Stripe PaymentIntent の id。session が payment_intent に紐付いた後の webhook で
  // 保存。@unique で refund の idempotency key 用途にも使う。
  stripePaymentIntentId   String?       @unique @map("stripe_payment_intent_id")
  // 決済確定時の請求金額のスナップショット (ticket.price × quantity)。
  // 後日 ticket.price が変わっても返金額の算定根拠を残す (会計証跡)。
  paidAmount              Int?          @map("paid_amount")
  paidAt                  DateTime?     @map("paid_at") @db.Timestamptz(6)

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slot     EventTimeSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  ticket   EventTicket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // PR#16: 領収書 (適格請求書) の 1:1 relation
  receipt  Receipt?
  // task #9 PR#1: 部分返金の repeatable child records (append-only)
  refunds  Refund[]

  @@index([slotId, status])
  @@index([ticketId])
  @@index([customerId])
  @@index([eventId, status, createdAt])
  @@index([eventId, attendedAt])
  // Payment webhook / cron が「未確定 → PAID」の atomic claim で使う (Reservation 同型)
  @@index([paymentStatus])
  // FIFO promote 用 (waitlist plan): 同一 slot/ticket 内の WAITLISTED を waitlistedAt 昇順で取得
  @@index([slotId, ticketId, status, waitlistedAt])
  // cron scan 用 (waitlist plan): WAITLISTED_OFFERED の期限切れを status+expiresAt で走査
  @@index([status, expiresAt])
  @@map("event_registrations")
}

// ==============================================
// Receipt (PR#16) — 適格請求書 (インボイス制度) 対応
// ==============================================

/**
 * 領収書 (適格請求書要件を満たす形式)。
 * 発行対象: PAID 状態の Reservation と EventRegistration。
 * 発行契機: Stripe webhook checkout.session.completed の trigger 側 tx 内で自動採番。
 * 連番: ReceiptSequence の atomic increment (Postgres sequence の代替)。
 * issuerSnapshot は Settings (invoiceNumber / 事業者名 / 所在地) の凍結 copy。
 * Settings 側 invoiceNumber を後日書き換えても既発行分は影響を受けない
 * (append-only の証跡性)。
 * 再発行 (reissuedFromId 参照) 時は **新しい serialNo を採番** し、元 Receipt の
 * `reservationId` / `eventRegistrationId` を NULL 化 (orphan 化) することで
 * @unique(reservationId) / @unique(eventRegistrationId) 制約を維持したまま新 Receipt を
 * 同予約 / イベント申込に付け替える。revision は「何回目の再発行か」を示す counter
 * (元 = 0、1 回目 reissue = 1)。元 Receipt は監査証跡として残り、reissuedTo chain 経由で辿れる。
 * これは Codex P1 (PR #1129, comment 3589127451) を機に明文化した business contract。
 */
/// Refund — 部分返金 (partial refund) を repeatable な子レコードとして表現する。
///
/// Foundation gap analysis (2026-07-15) task #9 PR#1、Codex review P2 (PR #1123) 対応。
/// 累積 refundedAmount + 単一 stripeRefundId scalar 設計では 2 回目以降の部分返金で
/// Stripe refund id / reason / actor が失われるため、child table に refactor した。
///
/// - reservationId / eventRegistrationId は polymorphic (どちらか片方が非 null、CHECK 制約で強制)
/// - amount は各 refund event の 個別 金額 (円、正整数)。累積は `Refund` 集計 SUM で算出
/// - stripeRefundId は Stripe refund object の id (@unique で二重返金防止 + webhook idempotency)
/// - refundedByType: "ADMIN" | "AUTO_ON_CANCEL" | "AUTO_CAPACITY_RACE" | "STRIPE_DASHBOARD" (AuditLog と併用)
/// - 実質 append-only (update / delete 想定なし、Refund オブジェクト 1 個 = 1 tx 完了)。
///   DB trigger (20260724110000_refunds_no_mutation) で UPDATE/DELETE を拒否するが、
///   status 列のみ 20260730115734_refunds_status_column_and_transition_exception が
///   例外を追加済み (他の全カラムは引き続き不変、DELETE は無条件拒否のまま)。
model Refund {
  id                  String         @id @default(uuid(7)) @db.Uuid
  /// 対象 Reservation (polymorphic、eventRegistrationId と排他)
  reservationId       String?        @map("reservation_id") @db.Uuid
  /// 対象 EventRegistration (polymorphic、reservationId と排他)
  eventRegistrationId String?        @map("event_registration_id") @db.Uuid
  /// この refund event の金額 (円、正整数)
  amount              Int
  /// 管理者入力の理由 (顧客通知メール文面にも掲載予定)
  reason              String?        @db.Text
  /// Stripe refund object の id (`re_...`)。@unique で二重返金防止 + webhook idempotency key。
  stripeRefundId      String         @unique @map("stripe_refund_id")
  /// "ADMIN" | "AUTO_ON_CANCEL" | "AUTO_CAPACITY_RACE" | "STRIPE_DASHBOARD" (AuditLog と併用)
  refundedByType      RefundedByType @map("refunded_by_type")
  /// Stripe Refund.status: "pending" | "requires_action" | "succeeded" | "failed" | "canceled"。
  /// konbini / customer_balance 等の非同期決済手段は作成直後 "pending" を返し、後日 Stripe が
  /// 確定させる。"succeeded" 以外は refund.updated webhook が確定させるまでの暫定値であり、
  /// paymentStatus は "succeeded" 確定までは変更しない (silent false-positive な返金完了通知を防ぐ)。
  /// このカラムのみ append-only trigger の例外で更新可能
  /// (20260730115734_refunds_status_column_and_transition_exception、他カラムは従来通り不変)。
  status              String         @default("succeeded") @db.VarChar(20)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  /// RESTRICT は子を触らないが、onUpdate も明示的に NoAction にする。既定の Cascade は
  /// 親の主キー更新時に refunds へ UPDATE を発行し、append-only trigger に弾かれるため。
  reservation       Reservation?       @relation(fields: [reservationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  eventRegistration EventRegistration? @relation(fields: [eventRegistrationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([reservationId])
  @@index([eventRegistrationId])
  @@index([createdAt])
  @@map("refunds")
}

model Receipt {
  /// DB 側 DEFAULT gen_random_uuid()（20260713045802_add_receipt_tables migration で手書き）。
  /// Prisma 7 の diff engine は @default(uuid(7)) と DB 側 gen_random_uuid() を同値と見なさず
  /// ALTER COLUMN ... DROP DEFAULT を提案するため dbgenerated で明示する。
  id                  String             @id @default(uuid(7)) @db.Uuid
  // 領収書番号 (グローバル連番、"YYYY-XXXXXX" 形式)
  serialNo            String             @unique @map("serial_no") @db.VarChar(20)
  issuedAt            DateTime           @default(now()) @map("issued_at") @db.Timestamptz(6)
  // 発行対象 (Reservation OR EventRegistration の polymorphic)
  reservationId       String?            @unique @map("reservation_id") @db.Uuid
  eventRegistrationId String?            @unique @map("event_registration_id") @db.Uuid
  reservation         Reservation?       @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  eventRegistration   EventRegistration? @relation(fields: [eventRegistrationId], references: [id], onDelete: Restrict)
  // 適格請求書要件フィールド。
  // **長さ制約を付けない。** どちらも他レコードからの導出値で、導出元
  // （Event.title は 200 文字、Customer.lastName/firstName は無制限 TEXT）より
  // 短い上限を置くと P2000 で領収書発行が落ちる。会計証跡を黙って切り詰めた PDF は
  // 落ちるより悪いので、上限は入力側の Zod に置く（20260803040000 参照）。
  recipientName       String             @map("recipient_name") @db.Text
  subject             String             @default("スペース利用料として") @db.Text
  amount              Int
  taxAmount           Int                @default(0) @map("tax_amount")
  taxRate             Int                @map("tax_rate")
  // 発行時点の Settings snapshot (凍結)
  issuerSnapshot      Json               @map("issuer_snapshot")
  // 再発行系: 新 serialNo を採番し、元 Receipt の reservationId/eventRegistrationId を NULL 化。
  // 元 Receipt は監査証跡として残り、chain (reissuedTo) 経由で辿れる。
  // revision は「何回目の再発行か」を示す counter (元 = 0、1 回目 reissue = 1)。
  reissuedFromId      String?            @map("reissued_from_id") @db.Uuid
  reissuedFrom        Receipt?           @relation("ReissuedReceipts", fields: [reissuedFromId], references: [id], onDelete: SetNull)
  reissuedTo          Receipt[]          @relation("ReissuedReceipts")
  reissuedReason      String?            @map("reissued_reason") @db.Text
  revision            Int                @default(0)
  /// ゲスト署名 URL 経路 (Receipt-USEDAT-P1) で 1 回だけ DL を許可するための刻印。
  /// NULL = 未使用、非 NULL = その時刻に DL 済み (以降 token 経路は 404)。
  /// Better Auth session 経路 (mypage) では参照・更新せず、常時 DL 可能。
  usedAt              DateTime?          @map("used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([issuedAt])
  @@index([reissuedFromId], map: "receipts_reissued_from_id_idx", where: { reissuedFromId: { not: null } })
  @@map("receipts")
}

/**
 * 領収書連番採番テーブル (単一行、advisory lock で serialize)。
 * Postgres sequence 代替: 「YYYY-XXXXXX」形式を年ごとに管理し、
 * 年替わりで nextNo をリセットする運用に対応する。
 */
/// 領収書番号（`YYYY-NNNNNN`）の年ごとの連番。
///
/// **主キーは年そのもの。** 単一行 + `year` 列にすると「年が変わったら
/// カウンタを 1 に戻す」分岐が要り、その分岐は**過去の年の到達点を破壊する**。
/// 時計が戻る・年を跨いだ再実行といった場面で、既に発行済みの番号を
/// もう一度採ってしまう（`serial_no` は @unique なので領収書の発行が落ちる）。
///
/// 年ごとに行を持てば、採番は「その年の行を +1 する」だけになり、分岐が消える。
model ReceiptSequence {
  year      Int      @id // 4 桁年
  nextNo    Int      @default(1) @map("next_no") // 次に発行する連番 (1-indexed)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("receipt_sequences")
}

// ==============================================
// Admin Notification
// ==============================================

model AdminNotification {
  id           String   @id @default(uuid(7)) @db.Uuid
  type         String   @db.VarChar(50)
  title        String   @db.VarChar(200)
  message      String   @db.VarChar(500)
  resourceType String?  @map("resource_type") @db.VarChar(50)
  /// 複数モデルを指す polymorphic 参照（予約 / 問い合わせ / イベント 等）。
  /// **`@db.Uuid` に戻さない。** 全 ID が uuid に揃った今も、FK を張らないポインタを
  /// 1 モデルの型で縛ると次に別種のリソースを指した瞬間に壊れる
  /// （`AuditLog.resourceId` / `TermsAgreement.resourceId` と同じ扱い）。
  /// かつて `@db.Uuid` だった頃は Event の deep link が常に死んでいた
  /// （20260726030000 で varchar へ広げた）。統一前に書かれた行には cuid が残る。
  resourceId   String?  @map("resource_id") @db.VarChar(36)
  isRead       Boolean  @default(false) @map("is_read")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([isRead, createdAt(sort: Desc)])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@map("admin_notifications")
}

// =============================================================================
// SwitchBot スマートロック連携
// =============================================================================

enum SmartLockDeviceType {
  /// パスコード発行対象（Keypad 系）
  KEYPAD
  KEYPAD_TOUCH
  KEYPAD_VISION
  KEYPAD_VISION_PRO
  /// 施錠状態監視のみ（createKey なし）
  LOCK
  LOCK_LITE
  LOCK_PRO

  @@map("smart_lock_device_type")
}

enum SmartLockPasscodeStatus {
  /// createKey 受理済み、webhook / Device List での keyId 確定待ち
  PENDING
  /// Device List keyList 突合成功（switchbotKeyId 確定済み）
  CONFIRMED
  /// createKey 失敗、webhook failed/timeout、または stale PENDING 確定
  FAILED
  /// deleteKey 受理済み、webhook / Device List での失効確定待ち
  REVOKE_PENDING
  /// deleteKey 確定（チェックアウト後 or キャンセルによる失効）
  REVOKED

  @@map("smart_lock_passcode_status")
}

/// 拠点（Location）に紐づく SwitchBot デバイス登録簿。
/// - パッド（KEYPAD*）: 一時パスコード発行。Space / Location デフォルトに割当可能。
/// - 錠（LOCK*）: 施錠状態・電池の監視のみ。パスコード発行・Space 割当対象外。
/// 1 拠点に複数台を登録できる（1:N from Location）。同一パッドを複数 Space で共有可。
model SmartLockDevice {
  id                 String              @id @default(uuid(7)) @db.Uuid
  locationId         String              @map("location_id") @db.Uuid
  deviceId           String              @unique @map("device_id") // SwitchBot 側の device ID（MAC アドレス）
  deviceName         String              @map("device_name")
  deviceType         SmartLockDeviceType @map("device_type")
  isActive           Boolean             @default(true) @map("is_active")
  /// パッド → ペア錠（錠ロールの SmartLockDevice）。錠側では null。
  pairedLockDeviceId String?             @map("paired_lock_device_id") @db.Uuid
  /// webhook / status 由来（錠ロール）。正規化: LOCKED|UNLOCKED|JAMMED
  lastLockState      String?             @map("last_lock_state")
  /// Pro/Lock のみ。正規化: OPEN|CLOSE。Lite は常に null
  lastDoorState      String?             @map("last_door_state")
  lastBattery        Int?                @map("last_battery")
  lastStateAt        DateTime?           @map("last_state_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  location            Location            @relation("LocationSmartLockDevices", fields: [locationId], references: [id], onDelete: Cascade)
  defaultForLocations Location[]          @relation("LocationDefaultSmartLockDevice")
  spaces              Space[]
  passcodes           SmartLockPasscode[]
  pairedLockDevice    SmartLockDevice?    @relation("PadToLock", fields: [pairedLockDeviceId], references: [id], onDelete: SetNull)
  pairedPads          SmartLockDevice[]   @relation("PadToLock")

  @@index([locationId])
  @@index([pairedLockDeviceId], map: "smart_lock_devices_paired_lock_device_id_idx", where: { pairedLockDeviceId: { not: null } })
  @@map("smart_lock_devices")
}

/// 予約 1 件・デバイス 1 台ごとに発行される一時パスコード。
model SmartLockPasscode {
  id                       String                  @id @default(uuid(7)) @db.Uuid
  reservationId            String                  @map("reservation_id") @db.Uuid
  deviceId                 String                  @map("device_id") @db.Uuid
  status                   SmartLockPasscodeStatus @default(PENDING)
  /// encrypt(purpose: "switchbot-guest-passcode") 済み。平文は DB に保持しない。
  passcodeCiphertext       String                  @map("passcode_ciphertext") @db.Text
  /// createKey 呼出の同期レスポンス（相関確認用、keyId ではない）
  switchbotCommandId       String?                 @map("switchbot_command_id")
  /// deleteKey 呼出の同期レスポンス commandId（無い場合あり）
  switchbotDeleteCommandId String?                 @map("switchbot_delete_command_id")
  /// Device List keyList[].id（deleteKey に必須）
  switchbotKeyId           String?                 @map("switchbot_key_id")
  /// パスコード有効期間（予約時間 ± switchbotPasscodeBufferMinutes）
  startTime                DateTime                @map("start_time") @db.Timestamptz(6)
  endTime                  DateTime                @map("end_time") @db.Timestamptz(6)
  failureReason            String?                 @map("failure_reason")
  confirmedAt              DateTime?               @map("confirmed_at") @db.Timestamptz(6)
  /// REVOKE_PENDING 開始時刻（stale 判定用）
  revokeRequestedAt        DateTime?               @map("revoke_requested_at") @db.Timestamptz(6)
  revokedAt                DateTime?               @map("revoked_at") @db.Timestamptz(6)
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  reservation Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  device      SmartLockDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([reservationId, deviceId])
  @@index([status, endTime])
  @@index([status, revokeRequestedAt])
  @@index([deviceId])
  @@map("smart_lock_passcodes")
}

// =============================================================================
// Stripe Webhook Event Dedup (STRIPE-DEDUP-A)
// =============================================================================

/// Stripe webhook event を id primary key で dedup する chokepoint テーブル。
///
/// Stripe 公式の "handle-duplicate-events" 推奨パターン
/// (https://docs.stripe.com/webhooks#handle-duplicate-events) 実装。
/// route handler は signature verification 直後に `create` を試み、`P2002`
/// unique conflict なら「既に受領済み (in-flight retry or completed)」として
/// 副作用なしで 200 短絡する。handler が全て成功した後に `processedAt` を書込。
///
/// 既存の updateMany claim guard (`claimReservationAsPaid` 等) は defense-in-depth
/// として保持し、crash-recovery backstop として機能する (`processedAt` null で
/// stuck した event は Stripe retry が再配送し、claim 側の idempotent 契約が
/// 二重副作用を防止する)。
///
/// Retention: 90 日超は cron `/api/cron/stripe-event-cleanup` (STRIPE-DEDUP-B、
/// follow-up PR) が定期削除する。
model StripeEvent {
  /// Stripe event.id (`evt_...`)。既に受領済み判定の primary key。
  id          String    @id @db.VarChar(80)
  /// event.type (`checkout.session.completed` 等)。監査/デバッグ用。
  type        String    @db.VarChar(80)
  /// signature verification 直後に record を作成した時刻 = 初回受領時刻。
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  /// handler が全て成功して switch block を抜けた時刻。null = 実行中 or crash-recovery 待ち。
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  /// retention cron 用: receivedAt で古い順に削除するため。
  @@index([receivedAt])
  @@map("stripe_events")
}

/// 銀行振込先マスタ（複数口座）。payment feature OFF かつ未払い時に顧客へ表示。
model TransferAccount {
  id                String              @id @default(uuid(7)) @db.Uuid
  label             String              @db.VarChar(50)
  bankName          String              @map("bank_name") @db.VarChar(50)
  branchName        String              @map("branch_name") @db.VarChar(50)
  /// TRANSFER_ACCOUNT_TYPE SSoT（DB VARCHAR 管理）
  accountType       TransferAccountType @map("account_type")
  accountNumber     String              @map("account_number") @db.VarChar(20)
  accountHolderName String              @map("account_holder_name") @db.VarChar(100)
  note              String?             @db.VarChar(200)
  sortOrder         Int                 @default(0) @map("sort_order")
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("transfer_accounts")
}
