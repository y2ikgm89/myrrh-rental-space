// ==============================================
// Myrrh Rental Space - Prisma Schema
// ==============================================
// Prisma 7 + PostgreSQL 16

generator client {
  provider = "prisma-client"
  output   = "../src/shared/generated/prisma"
  engineType = "client"
  runtime = "bun"
}

datasource db {
  provider = "postgresql"
}

// ==============================================
// Enums
// ==============================================

enum Role {
  SUPER_ADMIN // 全権限（システム設定、ユーザー管理、監査ログ）
  ADMIN // コンテンツ管理全般
  EDITOR // 割り当てページ編集のみ
  VIEWER // 閲覧のみ
  USER // 公開ユーザー（非管理者）
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CustomerStatus {
  NEW
  REGULAR
  VIP
  INACTIVE
  BLACKLIST
}

enum NavigationType {
  HEADER_DESKTOP // デスクトップ用ヘッダーメニュー
  HEADER_MOBILE // モバイル用ヘッダーメニュー
  FOOTER // フッターメニュー
}

enum SocialPlatform {
  TWITTER
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  LINE
  TIKTOK
  OTHER
}

enum LayoutWidth {
  XS
  SM
  MD
  LG
  XL
  FULL
  CUSTOM
}

enum HomepageSectionType {
  HERO // ヒーローセクション
  SPACE_LIST // スペース一覧
  NEWS // お知らせ一覧
  BLOG // ブログ一覧
  FAQ // FAQ
  CTA // Call to Action
  CUSTOM // カスタム（Lexicalフルコンテンツ）
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// NewsStatus enum は isPublished (Boolean) に置き換え - 削除予定
// enum NewsStatus {
//   DRAFT
//   PUBLISHED
//   ARCHIVED
// }

enum TermsType {
  TERMS_OF_USE // 利用規約
  PRIVACY_POLICY // プライバシーポリシー
  CANCELLATION // キャンセルポリシー
  PAYMENT // 支払い規約
  CUSTOM // カスタム規約
}

enum TermsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ==============================================
// Better Auth Models
// ==============================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // RBAC: EDITOR用の割り当てページID（JSON配列）
  assignedPages Json @default("[]") // ["page-id-1", "page-id-2"]

  // Relations
  accounts        Account[]
  sessions        Session[]
  reservations    Reservation[]
  blogPosts       BlogPost[]
  blogComments    BlogComment[]
  icalTokens      ICalToken[]
  auditLogs       AuditLog[]
  mediaFiles      Media[]
  termsAgreements TermsAgreement[]

  // OR検索用インデックス
  @@index([name])
  @@map("user")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String // Better Auth: ユーザーID or プロバイダーのアカウントID
  providerId            String // Better Auth: "credential" or "google" etc.
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // Better Auth: credential provider のパスワード（scrypt hash）
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model LoginToken {
  id        String    @id @default(uuid())
  token     String    @unique
  createdBy String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("login_tokens")
}

model StaffInvitation {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  role      Role      @default(USER)
  name      String? // オプションで名前を指定
  usedAt    DateTime? // 使用済み = パスワード設定完了
  expiresAt DateTime
  createdAt DateTime  @default(now())
  createdBy String

  @@index([token])
  @@index([email])
  @@index([expiresAt])
  @@map("staff_invitations")
}

// ==============================================
// Business Models
// ==============================================

model Location {
  id            String   @id @default(uuid())
  name          String // 例: 本館、渋谷店
  description   String?  @db.Text
  address       String // 住所
  access        String?  @db.Text // アクセス情報
  imageUrl      String // 建物画像（必須）
  imageUrls     Json     @default("[]") // 追加画像
  businessHours Json? // 営業時間
  sortOrder     Int      @default(0)
  isPublished   Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  spaces Space[]

  @@index([isPublished, isActive])
  @@index([sortOrder])
  @@map("locations")
}

model SpaceCategory {
  id          String   @id @default(uuid())
  name        String // 例: 会議室、スタジオ、セミナー室
  description String?  @db.Text
  icon        String? // アイコン名（任意）
  color       String? // テーマカラー（任意）
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  spaces Space[]

  @@index([sortOrder])
  @@map("space_categories")
}

model Space {
  id            String    @id @default(uuid())
  name          String
  description   String    @db.Text
  address       String
  access        String?   @db.Text
  capacity      Int
  area          Decimal?  @db.Decimal(10, 2)
  hourlyPrice   Decimal   @db.Decimal(10, 2)
  dailyPrice    Decimal?  @db.Decimal(10, 2)
  mainImageUrl  String
  imageUrls     Json      @default("[]")
  facilities    Json      @default("[]")
  businessHours Json?
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // SEO設定
  metaDescription String?
  metaKeywords    String?

  // OGP設定
  ogpTitle       String?
  ogpDescription String?
  ogpImageUrl    String?

  // 規約設定
  termsId String? // 任意の規約参照

  // 場所・カテゴリー設定
  locationId String? // 場所（建物）参照
  categoryId String? // カテゴリー参照

  // Relations
  reservations Reservation[]
  icalTokens   ICalToken[]
  terms        Terms?         @relation(fields: [termsId], references: [id], onDelete: SetNull)
  location     Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  category     SpaceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // OR検索用インデックス
  @@index([name])
  @@index([address])
  @@index([isPublished, isActive])
  @@index([termsId])
  @@index([locationId])
  @@index([categoryId])
  @@map("spaces")
}

model Reservation {
  id            String            @id @default(uuid())
  spaceId       String
  userId        String?
  customerId    String
  startTime     DateTime
  endTime       DateTime
  status        ReservationStatus @default(PENDING)
  totalPrice    Decimal?          @db.Decimal(10, 2)
  notes         String?           @db.Text
  termsAgreedAt DateTime? // 規約同意日時（レガシー互換）
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Google Calendar Sync
  googleCalendarEventId      String? // 共有カレンダーのイベントID
  googleCalendarOAuthEventId String? // OAuth連携（管理者個人）のイベントID
  calendarSyncedAt           DateTime? // 最終同期日時
  calendarSyncError          String?   @db.Text // 同期エラーメッセージ

  // Relations
  space           Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  termsAgreements TermsAgreement[]

  @@index([spaceId])
  @@index([customerId])
  @@index([startTime])
  @@index([endTime])
  @@index([status])
  @@index([spaceId, startTime, endTime])
  @@index([customerId, startTime])
  @@map("reservations")
}

model Customer {
  id                 String         @id @default(uuid())
  lastName           String
  firstName          String
  lastNameKana       String?        // 姓カナ（任意）
  firstNameKana      String?        // 名カナ（任意）
  email              String         @unique
  phoneNumber        String?
  address            String?        @db.Text
  status             CustomerStatus @default(NEW)
  notes              String?        @db.Text
  totalReservations  Int            @default(0)
  totalSpent         Decimal?       @db.Decimal(10, 2)
  lastReservationAt  DateTime?
  firstReservationAt DateTime?
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  reservations Reservation[]

  @@index([lastName])
  @@index([firstName])
  @@index([phoneNumber])
  @@index([status])
  @@index([isActive])
  @@index([lastReservationAt])
  @@index([lastName, firstName])
  @@map("customers")
}

model Inquiry {
  id        String        @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String        @db.Text
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}

model News {
  id                 String       @id @default(uuid())
  title              String
  content            String       @db.Text // HTMLコンテンツ（レンダリング用）
  isPublished        Boolean      @default(false)
  publishedAt        DateTime?
  contentWidth       LayoutWidth?
  contentWidthCustom Int? // CUSTOMの場合の幅（px）
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // SEO設定
  metaDescription String?
  metaKeywords    String?

  // OGP設定
  ogpTitle       String?
  ogpDescription String?
  ogpImageUrl    String?

  // Relations
  versions NewsVersion[]

  // OR検索用インデックス
  @@index([title])
  @@index([isPublished, publishedAt])
  @@map("news")
}

/// Newsのバージョン履歴
model NewsVersion {
  id        String   @id @default(uuid())
  newsId    String
  version   Int // 自動インクリメント（News内でユニーク）
  content   String   @db.Text // HTMLスナップショット
  createdAt DateTime @default(now())
  createdBy String? // 作成者ID（User.id）

  // Relations
  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, version])
  @@index([newsId, createdAt])
  @@map("news_versions")
}

model AnnouncementBar {
  id        String    @id @default(uuid())
  message   String    @db.VarChar(200)
  type      String    @default("info") // info, warning, promo
  linkUrl   String?
  linkText  String?
  bgColor   String? // カスタム背景色 (hex)
  textColor String? // カスタム文字色 (hex)
  isActive  Boolean   @default(true)
  priority  Int       @default(0)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, priority])
  @@index([startAt, endAt])
  @@map("announcement_bars")
}

// ==============================================
// Blog Models
// ==============================================

model BlogPost {
  id                 String         @id @default(uuid())
  title              String
  slug               String         @unique
  excerpt            String         @db.Text
  content            String         @db.Text // HTMLコンテンツ（レンダリング用）
  thumbnailUrl       String
  ogpImageUrl        String?
  categoryId         String
  tags               Json           @default("[]")
  metaDescription    String?
  metaKeywords       String?
  ogpTitle           String?
  ogpDescription     String?
  publishedAt        DateTime?
  status             BlogPostStatus @default(DRAFT)
  authorId           String
  viewCount          Int            @default(0)
  contentWidth       LayoutWidth?
  contentWidthCustom Int? // CUSTOMの場合の幅（px）
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  category BlogCategory      @relation(fields: [categoryId], references: [id])
  author   User              @relation(fields: [authorId], references: [id])
  comments BlogComment[]
  versions BlogPostVersion[]

  // OR検索用インデックス
  @@index([title])
  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([viewCount])
  @@map("blog_posts")
}

/// BlogPostのバージョン履歴
model BlogPostVersion {
  id        String   @id @default(uuid())
  postId    String
  version   Int // 自動インクリメント（Post内でユニーク）
  content   String   @db.Text // HTMLスナップショット
  createdAt DateTime @default(now())
  createdBy String? // 作成者ID（User.id）

  // Relations
  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, version])
  @@index([postId, createdAt])
  @@map("blog_post_versions")
}

model BlogCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  posts BlogPost[]

  @@index([order])
  @@map("blog_categories")
}

model BlogTag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_tags")
}

model BlogComment {
  id              String  @id @default(uuid())
  postId          String
  parentCommentId String? // Self-reference for nested comments

  // Content
  content String @db.Text

  // Author info (either userId OR guest info)
  userId     String? // For logged-in users
  guestName  String? // For guest comments
  guestEmail String? // For guest comments

  // Spam prevention metadata
  ipAddress   String? // For rate limiting (hashed)
  contentHash String? // For duplicate detection

  // Status
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String? // userId of admin who deleted

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  post          BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentComment BlogComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       BlogComment[] @relation("CommentReplies")

  // Indexes
  @@index([postId, createdAt])
  @@index([parentCommentId])
  @@index([userId])
  @@index([ipAddress, createdAt])
  @@index([guestEmail, createdAt])
  @@index([contentHash])
  @@index([isDeleted])
  @@index([isDeleted, createdAt(sort: Desc)]) // Admin search optimization
  @@map("blog_comments")
}

// ==============================================
// CMS Models
// ==============================================

model Page {
  id                 String       @id @default(uuid())
  slug               String       @unique
  title              String
  description        String?      @db.Text
  content            String       @db.Text // HTMLコンテンツ（レンダリング用）
  metaDescription    String?
  metaKeywords       String?
  ogpTitle           String?
  ogpDescription     String?
  ogpImageUrl        String?
  isPublished        Boolean      @default(true)
  publishedAt        DateTime?
  isActive           Boolean      @default(true)
  isSystemPage       Boolean      @default(false) // システムページ（SEO/OGPのみ編集可、コンテンツ編集不可）
  contentWidth       LayoutWidth?
  contentWidthCustom Int? // CUSTOMの場合の幅（px）
  showSidebar        Boolean? // null=デフォルト使用、true/false=明示的指定
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([isPublished, isActive])
  @@index([isSystemPage])
  @@map("pages")
}

model NavigationItem {
  id         String         @id @default(uuid())
  type       NavigationType
  parentId   String?
  label      String
  url        String
  isExternal Boolean        @default(false)
  order      Int
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Self-relation for submenus
  parent   NavigationItem?  @relation("NavigationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavigationHierarchy")

  @@index([type, order])
  @@map("navigation_items")
}

model SocialLink {
  id            String         @id @default(uuid())
  platform      SocialPlatform
  url           String
  iconUrl       String?
  order         Int
  isActive      Boolean        @default(true)
  showOnDesktop Boolean        @default(true) // デスクトップで表示
  showOnMobile  Boolean        @default(true) // モバイルで表示
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([order])
  @@map("social_links")
}

// ==============================================
// FAQ Models
// ==============================================

model FaqCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  items FaqItem[]

  @@index([order])
  @@index([isActive, order])
  @@map("faq_categories")
}

model FaqItem {
  id          String    @id @default(uuid())
  categoryId  String
  question    String
  answer      String    @db.Text // Lexical HTML (リッチテキスト)
  order       Int       @default(0)
  isPublished Boolean   @default(true)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // SEO設定
  metaDescription String?
  metaKeywords    String?

  // OGP設定
  ogpTitle       String?
  ogpDescription String?
  ogpImageUrl    String?

  // Relations
  category FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, order])
  @@index([isPublished])
  @@map("faq_items")
}

// ==============================================
// Settings (Singleton)
// ==============================================

model Settings {
  id        String   @id @default("singleton")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Site Basic Info
  siteName           String?
  siteDescription    String? @db.Text
  faviconUrl         String?
  defaultOgpImageUrl String?
  headerLogoUrl      String?
  footerLogoUrl      String?
  footerCopyright    String?

  // Logo Display Settings
  useHeaderLogo Boolean @default(true)
  useFooterLogo Boolean @default(true)

  // Business Info (事業者情報)
  businessName        String? // 会社名・屋号
  businessNameKana    String? // 会社名・屋号（カナ）
  representativeName  String? // 代表者名
  businessType        String? // 事業形態（個人事業主/法人）
  industryType        String? // 業種
  establishedDate     DateTime? // 設立日
  registrationNumber  String? // 法人番号/登録番号
  invoiceNumber       String? // インボイス登録番号
  businessDescription String?   @db.Text // 事業概要

  // Contact Info
  phoneNumber   String?
  faxNumber     String?
  email         String?
  address       String? @db.Text
  postalCode    String? // 郵便番号
  prefecture    String? // 都道府県
  city          String? // 市区町村
  streetAddress String? // 番地以降
  buildingName  String? // 建物名

  // Business Hours (営業時間)
  businessHours   Json? // 曜日ごとの営業時間
  regularHolidays Json? // 定休日（曜日）
  specialHolidays Json? // 特別休業日（日付リスト）
  holidayNotice   String? @db.Text // 休業日のお知らせ

  // Legacy field - keeping for backwards compatibility
  defaultBusinessHours Json?

  // Email Settings
  senderEmail                       String?
  senderName                        String?
  replyToEmail                      String?
  reservationConfirmationTemplateId String?
  reservationCancelledTemplateId    String?
  reservationUpdatedTemplateId      String?
  adminNotificationTemplateId       String?

  // SEO Settings
  defaultMetaDescription String?
  defaultMetaKeywords    String?
  defaultOgpTitle        String?
  defaultOgpDescription  String?

  // Layout Settings (レイアウト設定)
  containerWidth       LayoutWidth?
  containerWidthCustom Int? // CUSTOMの場合の幅（px）
  contentWidth         LayoutWidth?
  contentWidthCustom   Int? // CUSTOMの場合の幅（px）

  // Sidebar Settings (サイドバー設定)
  sidebarEnabled      Boolean @default(true) // サイドバー全体の有効/無効
  sidebarWidgets      Json    @default("{\"search\":true,\"recent\":true,\"popular\":true,\"categories\":true,\"tags\":true}") // ウィジェット個別設定
  sidebarRecentCount  Int     @default(5) // 新着記事の表示件数
  sidebarPopularCount Int     @default(5) // 人気記事の表示件数

  // Analytics Settings
  analyticsType         String? // "ga4" | "gtm" | null
  googleAnalyticsId     String? // GA4 Measurement ID (G-XXXXXXXXXX)
  googleTagManagerId    String? // GTM Container ID (GTM-XXXXXXX)
  googleSearchConsoleId String? // GSC verification meta tag
  bingWebmasterToolsId  String? // Bing verification meta tag
  gaPropertyId          String? // GA4 Property ID for Data API

  // Reservation Settings
  defaultTimeSlot                  Int?    @default(60)
  minReservationDuration           Int?    @default(60)
  maxReservationDuration           Int?    @default(480)
  cancellationPolicy               String? @db.Text
  sendReservationConfirmationEmail Boolean @default(true)
  sendAdminNotificationEmail       Boolean @default(true)

  // Terms Agreement Settings
  termsAgreementEnabled   Boolean @default(true) // 規約同意チェック有効
  termsAgreementText      String? // カスタム同意文言（null=デフォルト）
  requireTermsAgreement   Boolean @default(true) // 利用規約への同意必須
  requirePrivacyAgreement Boolean @default(true) // プライバシーポリシーへの同意必須

  // Notification Settings
  notifyNewReservation       Boolean @default(true)
  notifyReservationChange    Boolean @default(true)
  notifyReservationCancel    Boolean @default(true)
  notifyNewInquiry           Boolean @default(true)
  notificationEmailAddresses String?

  // Other Settings
  timezone           String? @default("Asia/Tokyo")
  language           String? @default("ja")
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String? @db.Text

  // Stripe Payment Settings
  stripeEnabled          Boolean   @default(false)
  stripeTestMode         Boolean   @default(true)
  stripePublishableKey   String?
  stripeSecretKey        String?   @db.Text // 暗号化して保存
  stripeWebhookSecret    String?   @db.Text // 暗号化して保存
  stripeAccountId        String?
  stripeCurrency         String    @default("jpy")
  stripeLastTestedAt     DateTime?
  stripeConnectionStatus String?

  // Cookie Consent Settings
  cookieConsentEnabled    Boolean @default(false)
  cookieConsentMessage    String? @db.Text
  cookieConsentAcceptText String?
  cookieConsentRejectText String?
  cookieConsentPolicyUrl  String?

  // Announcement Bar Carousel Settings
  announcementBarAnimation         String  @default("fade") // fade, slideX, slideY
  announcementBarDuration          Int     @default(5000) // ミリ秒
  announcementBarAutoPlay          Boolean @default(true)
  announcementBarPauseOnHover      Boolean @default(true)
  announcementBarShowArrows        Boolean @default(true)
  announcementBarShowIndicator     Boolean @default(true)
  announcementBarDesignStyle       String  @default("solid") // solid, gradient, outlined, glass, minimal, striped
  // Announcement Bar Common Color Settings
  announcementBarBgColor           String? // 共通背景色（カスタム）
  announcementBarTextColor         String? // 共通文字色（カスタム）
  // Striped Design Settings
  announcementBarStripeColor       String? // ストライプ色（カスタム）
  announcementBarStripeAnimation   Boolean @default(false) // ストライプアニメーション
  // Gradient Design Settings
  announcementBarGradientAnimation Boolean @default(false) // グラデーションアニメーション
  // Glass Design Settings
  announcementBarGlassAnimation    Boolean @default(false) // グラス（シマー）アニメーション

  // ==============================================
  // External Service API Keys
  // ==============================================

  // Resend Email Service
  resendApiKey           String?   @db.Text // Encrypted
  resendLastTestedAt     DateTime?
  resendConnectionStatus String? // 'connected' | 'error'

  // Cloudflare Turnstile (Bot Protection)
  turnstileSiteKey          String? // Public key (not encrypted)
  turnstileSecretKey        String?   @db.Text // Encrypted
  turnstileLastTestedAt     DateTime?
  turnstileConnectionStatus String?

  // Google Maps API
  googleMapsApiKey           String?   @db.Text // Encrypted
  googleMapsLastTestedAt     DateTime?
  googleMapsConnectionStatus String?

  // Custom API Keys (Generic key-value storage)
  // Format: { "id": { "name": "...", "key": "encrypted", "value": "encrypted", ... } }
  customApiKeys Json? @default("{}")

  // ==============================================
  // Google Calendar Integration
  // ==============================================

  // サービスアカウント連携（共有カレンダー用）
  googleCalendarEnabled            Boolean   @default(false)
  googleCalendarServiceAccountJson String?   @db.Text // 暗号化されたJSON認証情報
  googleCalendarId                 String? // 共有カレンダーID
  googleCalendarLastTestedAt       DateTime?
  googleCalendarConnectionStatus   String? // 'connected' | 'error'

  // OAuth連携（管理者個人カレンダー用）
  googleCalendarOAuthEnabled Boolean @default(false)
  // ※ access_token/refresh_tokenはAccountテーブルに保存

  // 予約者向けiCal設定
  icalAttachmentEnabled     Boolean @default(true) // メールにiCal添付
  addToCalendarLinksEnabled Boolean @default(true) // Add to Calendarリンク表示

  // iCalフィード設定（外部カレンダー購読用）
  icalFeedEnabled             Boolean @default(false) // iCalフィード公開
  icalFeedIncludeCustomerInfo Boolean @default(false) // 顧客情報を含む

  // ==============================================
  // Google Calendar 双方向同期（Phase 4）
  // ==============================================

  // 同期方式設定
  googleCalendarTwoWaySyncEnabled  Boolean @default(false) // 双方向同期有効
  googleCalendarSyncMethod         String  @default("polling") // "polling" | "webhook" | "both"
  googleCalendarPollingIntervalMin Int     @default(5) // ポーリング間隔（分）

  // 同期状態
  googleCalendarSyncToken    String?   @db.Text // 増分同期用トークン
  googleCalendarLastSyncedAt DateTime? // 最終同期日時

  // Webhook設定（Push Notifications）
  googleCalendarWebhookChannelId  String? // Webhook チャンネルID
  googleCalendarWebhookResourceId String? // Webhook リソースID
  googleCalendarWebhookExpiration DateTime? // Webhook 有効期限
  googleCalendarWebhookToken      String? // Webhook 認証トークン (x-goog-channel-token)

  @@map("settings")
}

// =============================================================================
// iCal Feed Token
// =============================================================================

/// iCalフィード公開用トークン
model ICalToken {
  id         String    @id @default(uuid())
  token      String    @unique // 公開URL用トークン（32バイトBase64URL）
  name       String // トークン名（識別用）
  spaceId    String? // null = 全予約、指定時 = 特定スペースのみ
  createdBy  String // 作成した管理者ID
  expiresAt  DateTime? // null = 無期限
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime? // 最終アクセス日時

  space Space? @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([spaceId])
  @@index([createdBy])
  @@map("ical_tokens")
}

// =============================================================================
// Homepage Section Models
// =============================================================================

/// ホームページセクション（統一モデル）
/// 各セクションタイプに応じた設定をconfigに格納
model HomepageSection {
  id        String              @id @default(uuid())
  type      HomepageSectionType
  title     String? // セクション見出し（表示用）
  config    Json                @default("{}") // タイプ別設定（JSON Schema で型安全）
  content   String?             @db.Text // Lexical HTML（CUSTOM, FAQ等で使用）
  order     Int                 @default(0) // 表示順序（DnDで変更可能）
  isActive  Boolean             @default(true) // ON/OFF制御
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([order, isActive])
  @@index([type])
  @@map("homepage_sections")
}

// =============================================================================
// RBAC: 権限管理
// =============================================================================

/// 権限定義（resource:action の組み合わせ）
model Permission {
  id          String   @id @default(uuid())
  resource    String // 'space', 'blog', 'news', 'page', 'user', 'settings' 等
  action      String // 'create', 'read', 'update', 'delete', 'publish' 等
  description String? // 説明（UI表示用）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

/// ロールと権限の紐付け
model RolePermission {
  id           String   @id @default(uuid())
  role         Role
  permissionId String
  createdAt    DateTime @default(now())

  // Relations
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

// =============================================================================
// 監査ログ
// =============================================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  LOGIN_SUCCESS
  LOGIN_FAILED
  PERMISSION_DENIED
  PASSWORD_CHANGE
  ROLE_CHANGE
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum MediaUsage {
  BLOG
  NEWS
  PAGE
  SPACE
  SITE
  GENERAL
}

/// 監査ログ（書き込み操作 + セキュリティイベント）
model AuditLog {
  id         String      @id @default(uuid())
  userId     String? // 実行ユーザー（null = システム or 未認証）
  action     AuditAction // 操作種別
  resource   String // 対象リソース種別 ('space', 'blog' 等)
  resourceId String? // 対象リソースID
  oldValue   Json? // 変更前の値（UPDATE時）
  newValue   Json? // 変更後の値 or 作成値
  metadata   Json? // 追加情報（IPアドレス、UserAgent等）
  createdAt  DateTime    @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// =============================================================================
// メディア管理
// =============================================================================

/// メディアファイル管理
model Media {
  id          String @id @default(uuid())
  filename    String // 元のファイル名
  storagePath String // Supabase Storage パス
  url         String // 公開URL
  bucket      String // Supabase バケット名
  mimeType    String // MIME type
  size        Int // ファイルサイズ（bytes）
  width       Int? // 画像幅（px）
  height      Int? // 画像高さ（px）

  // 分類・検索用
  type        MediaType // メディア種別
  usage       MediaUsage @default(GENERAL) // 用途
  alt         String? // 代替テキスト
  title       String? // タイトル
  description String?    @db.Text // 説明
  tags        Json       @default("[]") // タグ配列

  // 管理情報
  uploadedBy String // アップロードユーザーID
  isActive   Boolean  @default(true) // ソフトデリート
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  uploader User @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([type, usage])
  @@index([uploadedBy])
  @@index([isActive, createdAt])
  @@index([mimeType])
  @@map("media")
}

// =============================================================================
// レートリミット
// =============================================================================

/// ログイン試行記録（レートリミット用）
model LoginAttempt {
  id         String   @id @default(uuid())
  identifier String // IPアドレス or メールのハッシュ
  email      String // 試行されたメールアドレス
  success    Boolean // 成功/失敗
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([email, createdAt])
  @@map("login_attempts")
}

// =============================================================================
// 規約管理
// =============================================================================

/// 規約マスター（複数のバージョンを持つ）
model Terms {
  id        String    @id @default(uuid())
  type      TermsType
  title     String // 表示タイトル（例: "利用規約"）
  slug      String    @unique // URL用スラッグ（例: "terms-of-use"）
  isActive  Boolean   @default(true) // 現在有効な規約か
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  versions   TermsVersion[]
  spaces     Space[] // この規約を使用するスペース
  agreements TermsAgreement[] // 同意記録

  @@index([type, isActive])
  @@index([slug])
  @@map("terms")
}

/// 規約バージョン（不変オブジェクト）
model TermsVersion {
  id               String      @id @default(uuid())
  termsId          String
  version          Int // 自動インクリメント（Terms内でユニーク）
  content          String      @db.Text // Lexical HTML（リッチテキスト）
  status           TermsStatus @default(DRAFT)
  publishedAt      DateTime? // 公開日時
  publishedBy      String? // 公開者ID（User.id）
  isCurrentVersion Boolean     @default(false) // 現在の有効バージョン
  createdAt        DateTime    @default(now())
  createdBy        String // 作成者ID（User.id）

  // Relations
  terms      Terms            @relation(fields: [termsId], references: [id], onDelete: Cascade)
  agreements TermsAgreement[]

  @@unique([termsId, version])
  @@index([termsId, isCurrentVersion])
  @@index([status, publishedAt])
  @@map("terms_versions")
}

/// 規約同意記録（監査証跡）
model TermsAgreement {
  id            String  @id @default(uuid())
  termsId       String
  versionId     String // 同意した規約バージョンID
  reservationId String? // 予約ID（予約時の同意の場合）
  userId        String? // ユーザーID（ログイン済みの場合）

  // 同意者情報（ゲストユーザー用）
  guestName  String? // ゲスト氏名
  guestEmail String? // ゲストメール

  // 監査情報
  agreedAt  DateTime @default(now()) // 同意日時
  ipAddress String? // IPアドレス（ハッシュ化）
  userAgent String? // ブラウザ情報

  // Relations
  terms       Terms        @relation(fields: [termsId], references: [id], onDelete: Cascade)
  version     TermsVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([userId, agreedAt])
  @@index([termsId, versionId])
  @@index([guestEmail, agreedAt])
  @@map("terms_agreements")
}
