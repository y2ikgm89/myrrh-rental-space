enum AuditAction {
  CREATE
  UPDATE
  DELETE
  READ // 参照アクセス（領収書 PDF DL 等のセキュリティ観点で追跡する read）
  MANAGE // 管理操作（完全性検証トリガー等、CRUD 以外の manage 権限アクション）
  PUBLISH
  EXPORT
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PERMISSION_DENIED
  PASSWORD_CHANGE
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_FAILED
  ROLE_CHANGE
  INTEGRITY_CHECK

  @@map("audit_action")
}

enum EditorCommentStatus {
  ACTIVE // アクティブ（未解決）
  RESOLVED // 解決済み
  DELETED // 削除済み（ソフトデリート）

  @@map("editor_comment_status")
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER

  @@map("media_type")
}

enum MediaUsage {
  POST
  NEWS
  PAGE
  SPACE
  EVENT
  SITE
  GENERAL

  @@map("media_usage")
}

/// 監査ログ（書き込み操作 + セキュリティイベント）
model AuditLog {
  id            String      @id @default(uuid(7)) @db.Uuid
  sequence      BigInt      @unique
  previousHash  String      @map("previous_hash") @db.Char(64)
  entryHash     String      @map("entry_hash") @db.Char(64)
  hashAlgorithm String      @default("HMAC-SHA256") @map("hash_algorithm") @db.VarChar(32)
  hashKeyId     String      @default("v1") @map("hash_key_id") @db.VarChar(32)
  chainVersion  Int         @default(1) @map("chain_version")
  /// 実行ユーザー（null = システム or 未認証）。
  /// **`user` への FK は意図的に張らない。** `ON DELETE SET NULL` は audit_logs へ
  /// UPDATE を発行し append-only trigger に弾かれて親の DELETE を rollback させる
  /// （顧客アカウント削除が落ちていた）。RESTRICT へ倒すと「監査ログのある利用者は
  /// 二度と削除できない」になる。entryHash は userId を含めて計算されるので NULL 化は
  /// ハッシュ chain も壊す。証跡は「その時点で誰が操作したか」の記録であり、対象の
  /// 削除後も記述は真のまま残るべきなので論理参照にしている。
  /// 参照の健全性は __tests__/integration/prisma/append-only-fk-actions.test.ts が守る。
  userId        String?     @map("user_id") @db.Uuid
  action        AuditAction // 操作種別
  resource      String // 対象リソース種別 ('space', 'blog' 等)
  resourceId    String?     @map("resource_id") // 対象リソースID
  oldValue      Json?       @map("old_value") // 変更前の値（UPDATE時）
  newValue      Json?       @map("new_value") // 変更後の値 or 作成値
  metadata      Json? // 追加情報（IPアドレス、UserAgent等）
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([hashKeyId, sequence])
  @@map("audit_logs")
}

