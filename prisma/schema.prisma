// ==============================================
// Myrrh Rental Space - Prisma Schema
// ==============================================
// Prisma 7 + PostgreSQL 16

generator client {
  provider = "prisma-client"
  output   = "../src/shared/generated/prisma"
  engineType = "client"
  runtime = "bun"
}

datasource db {
  provider = "postgresql"
}

// ==============================================
// Enums
// ==============================================

enum Role {
  SUPER_ADMIN // 全権限（システム設定、ユーザー管理、監査ログ）
  ADMIN // コンテンツ管理全般
  EDITOR // 割り当てページ編集のみ
  VIEWER // 閲覧のみ
  USER // 公開ユーザー（非管理者）
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CustomerStatus {
  NEW
  REGULAR
  VIP
  INACTIVE
  BLACKLIST
}

enum NavigationType {
  HEADER_DESKTOP // デスクトップ用ヘッダーメニュー
  HEADER_MOBILE // モバイル用ヘッダーメニュー
  FOOTER // フッターメニュー
}

enum SocialPlatform {
  TWITTER
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  LINE
  TIKTOK
  OTHER
}

enum LayoutWidth {
  XS
  SM
  MD
  LG
  XL
  FULL
  CUSTOM
}

enum HomepageSectionType {
  HERO // ヒーローセクション
  SPACE_LIST // スペース一覧
  NEWS // お知らせ一覧
  POST // 記事一覧
  FAQ // FAQ
  CTA // Call to Action
  CUSTOM // カスタム（Lexicalフルコンテンツ）
  INSTAGRAM // Instagramフィード
}

enum PageSectionType {
  HERO // ヒーローセクション
  CUSTOM // Lexicalリッチテキスト
  CONTACT_FORM // お問い合わせフォーム
  FAQ_LIST // FAQ一覧
  SPACE_LIST // スペース一覧
  NEWS_LIST // お知らせ一覧
  POST_LIST // 記事一覧
  CTA // Call to Action
  GALLERY // ギャラリー
  TESTIMONIAL // 体験談・レビュー
  MAP // 地図
  EMBED // 埋め込み（iframe）
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// NewsStatus enum は isPublished (Boolean) に置き換え - 削除予定
// enum NewsStatus {
//   DRAFT
//   PUBLISHED
//   ARCHIVED
// }

enum TermsType {
  TERMS_OF_USE // 利用規約
  PRIVACY_POLICY // プライバシーポリシー
  CANCELLATION // キャンセルポリシー
  PAYMENT // 支払い規約
  CUSTOM // カスタム規約
}

enum TermsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CouponType {
  PERCENTAGE // パーセント割引 (例: 20%)
  FIXED_AMOUNT // 定額割引 (例: ¥1,000)
}

// ==============================================
// Better Auth Models
// ==============================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // RBAC: EDITOR用の割り当てページID（JSON配列）
  assignedPages Json @default("[]") // ["page-id-1", "page-id-2"]

  // Relations
  accounts        Account[]
  sessions        Session[]
  reservations    Reservation[]
  posts       Post[]
  postComments    PostComment[]
  icalTokens      ICalToken[]
  auditLogs       AuditLog[]
  mediaFiles      Media[]
  termsAgreements TermsAgreement[]

  // OR検索用インデックス
  @@index([name])
  @@map("user")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String // Better Auth: ユーザーID or プロバイダーのアカウントID
  providerId            String // Better Auth: "credential" or "google" etc.
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // Better Auth: credential provider のパスワード（scrypt hash）
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model LoginToken {
  id        String    @id @default(uuid())
  token     String    @unique
  createdBy String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("login_tokens")
}

model StaffInvitation {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  role      Role      @default(USER)
  name      String? // オプションで名前を指定
  usedAt    DateTime? // 使用済み = パスワード設定完了
  expiresAt DateTime
  createdAt DateTime  @default(now())
  createdBy String

  @@index([token])
  @@index([email])
  @@index([expiresAt])
  @@map("staff_invitations")
}

// ==============================================
// Business Models
// ==============================================

model Location {
  id            String   @id @default(uuid())
  name          String // 例: 本館、渋谷店
  description   String?  @db.Text
  address       String // 住所
  access        String?  @db.Text // アクセス情報
  imageUrl      String // 建物画像（必須）
  imageUrls     Json     @default("[]") // 追加画像
  businessHours Json? // 営業時間
  sortOrder     Int      @default(0)
  isPublished   Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  spaces Space[]

  @@index([isPublished, isActive])
  @@index([sortOrder])
  @@map("locations")
}

model SpaceCategory {
  id          String   @id @default(uuid())
  name        String // 例: 会議室、スタジオ、セミナー室
  description String?  @db.Text
  icon        String? // アイコン名（任意）
  color       String? // テーマカラー（任意）
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  spaces Space[]

  @@index([sortOrder])
  @@map("space_categories")
}

model Space {
  id            String    @id @default(uuid())
  slug          String    @unique
  name          String
  description   String    @db.Text
  address       String
  access        String?   @db.Text
  capacity      Int
  area          Decimal?  @db.Decimal(10, 2)
  hourlyPrice   Decimal   @db.Decimal(10, 2)
  dailyPrice    Decimal?  @db.Decimal(10, 2)
  mainImageUrl  String
  imageUrls     Json      @default("[]")
  facilities    Json      @default("[]")
  businessHours Json?
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // SEO設定
  metaDescription String?
  metaKeywords    String?

  // OGP設定
  ogpTitle       String?
  ogpDescription String?
  ogpImageUrl    String?

  // 規約設定
  termsId String? // 任意の規約参照

  // 割引設定
  discountType             String   @default("none") // "none" | "percentage" | "fixed"
  discountValue            Decimal? @db.Decimal(10, 2)
  durationDiscountOverride String   @default("inherit") // "inherit" | "enabled" | "disabled"

  // 税率設定
  taxRateType String @default("standard") // "standard" | "reduced"

  // 場所・カテゴリー設定
  locationId String? // 場所（建物）参照
  categoryId String? // カテゴリー参照

  // Relations
  reservations Reservation[]
  icalTokens   ICalToken[]
  terms        Terms?         @relation(fields: [termsId], references: [id], onDelete: SetNull)
  location     Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  category     SpaceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // OR検索用インデックス
  @@index([name])
  @@index([address])
  @@index([isPublished, isActive])
  @@index([termsId])
  @@index([locationId])
  @@index([categoryId])
  @@map("spaces")
}

model Reservation {
  id            String            @id @default(uuid())
  spaceId       String
  userId        String?
  customerId    String
  startTime     DateTime
  endTime       DateTime
  status        ReservationStatus @default(PENDING)
  totalPrice    Decimal?          @db.Decimal(10, 2)
  notes         String?           @db.Text
  termsAgreedAt DateTime? // 規約同意日時（レガシー互換）
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // 割引情報
  couponId               String? // 適用されたクーポンID
  couponDiscountAmount   Decimal? @db.Decimal(10, 2) // クーポン割引額
  durationDiscountAmount Decimal? @db.Decimal(10, 2) // 長時間割引額
  spaceDiscountAmount    Decimal? @db.Decimal(10, 2) // スペース固有割引額
  basePrice              Decimal? @db.Decimal(10, 2) // 割引前価格（記録用）

  // 税情報（予約時点の値を記録）
  taxRateType       String?  // "standard" | "reduced" - 適用された税率タイプ
  taxRate           Decimal? @db.Decimal(5, 2) // 適用税率（%）
  taxAmount         Decimal? @db.Decimal(10, 2) // 税額
  totalPriceWithTax Decimal? @db.Decimal(10, 2) // 税込み合計

  // Google Calendar Sync
  googleCalendarEventId      String? // 共有カレンダーのイベントID
  googleCalendarOAuthEventId String? // OAuth連携（管理者個人）のイベントID
  calendarSyncedAt           DateTime? // 最終同期日時
  calendarSyncError          String?   @db.Text // 同期エラーメッセージ

  // Relations
  space           Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  coupon          Coupon?          @relation(fields: [couponId], references: [id], onDelete: SetNull)
  termsAgreements TermsAgreement[]

  @@index([spaceId])
  @@index([customerId])
  @@index([startTime])
  @@index([endTime])
  @@index([status])
  @@index([spaceId, startTime, endTime])
  @@index([customerId, startTime])
  @@index([couponId])
  @@map("reservations")
}

model Customer {
  id                 String         @id @default(uuid())
  lastName           String
  firstName          String
  lastNameKana       String?        // 姓カナ（任意）
  firstNameKana      String?        // 名カナ（任意）
  email              String         @unique
  phoneNumber        String?
  address            String?        @db.Text
  status             CustomerStatus @default(NEW)
  notes              String?        @db.Text
  totalReservations  Int            @default(0)
  totalSpent         Decimal?       @db.Decimal(10, 2)
  lastReservationAt  DateTime?
  firstReservationAt DateTime?
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  reservations Reservation[]

  @@index([lastName])
  @@index([firstName])
  @@index([phoneNumber])
  @@index([status])
  @@index([isActive])
  @@index([lastReservationAt])
  @@index([lastName, firstName])
  @@map("customers")
}

// ==============================================
// Coupon Model (割引クーポン)
// ==============================================

model Coupon {
  id          String     @id @default(uuid())
  code        String     @unique // クーポンコード (大文字英数字)
  name        String // 管理用名称
  description String? // 説明

  // 割引設定
  type          CouponType
  discountValue Decimal    @db.Decimal(10, 2) // 割引額 or 割引率

  // 適用条件
  minReservationAmount Decimal? @db.Decimal(10, 2) // 最低利用金額
  maxDiscountAmount    Decimal? @db.Decimal(10, 2) // 最大割引額（パーセント割引時）

  // 有効期限
  validFrom  DateTime
  validUntil DateTime?

  // 利用制限
  usageLimit Int? // 利用回数上限（null=無制限）
  usageCount Int     @default(0) // 利用回数
  isActive   Boolean @default(true)

  // 併用設定
  canCombineWithDurationDiscount Boolean @default(true) // 長時間割引との併用可否

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  reservations Reservation[]

  @@index([code])
  @@index([validFrom, validUntil])
  @@index([isActive])
  @@map("coupons")
}

model Inquiry {
  id        String        @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String        @db.Text
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}

model News {
  id                 String       @id @default(uuid())
  slug               String       @unique
  title              String
  content            String       @db.Text // HTMLコンテンツ（レンダリング用）
  isPublished        Boolean      @default(false)
  publishedAt        DateTime?
  contentWidth       LayoutWidth?
  contentWidthCustom Int? // CUSTOMの場合の幅（px）
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // SEO設定
  metaDescription String?
  metaKeywords    String?

  // OGP設定
  ogpTitle       String?
  ogpDescription String?
  ogpImageUrl    String?

  // Relations
  versions NewsVersion[]

  // OR検索用インデックス
  @@index([title])
  @@index([isPublished, publishedAt])
  @@map("news")
}

/// Newsのバージョン履歴
model NewsVersion {
  id        String   @id @default(uuid())
  newsId    String
  version   Int // 自動インクリメント（News内でユニーク）
  content   String   @db.Text // HTMLスナップショット
  createdAt DateTime @default(now())
  createdBy String? // 作成者ID（User.id）

  // Relations
  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, version])
  @@index([newsId, createdAt])
  @@map("news_versions")
}

model AnnouncementBar {
  id        String    @id @default(uuid())
  message   String    @db.VarChar(200)
  type      String    @default("info") // info, warning, promo
  linkUrl   String?
  linkText  String?
  bgColor   String? // カスタム背景色 (hex)
  textColor String? // カスタム文字色 (hex)
  isActive  Boolean   @default(true)
  priority  Int       @default(0)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, priority])
  @@index([startAt, endAt])
  @@map("announcement_bars")
}

// ==============================================
// Post Models
// ==============================================

model Post {
  id                 String      @id @default(uuid())
  title              String
  slug               String      @unique
  excerpt            String      @db.Text
  content            String      @db.Text // HTMLコンテンツ（レンダリング用）
  thumbnailUrl       String
  ogpImageUrl        String?
  categoryId         String
  tags               Json        @default("[]")
  metaDescription    String?
  metaKeywords       String?
  ogpTitle           String?
  ogpDescription     String?
  publishedAt        DateTime?
  status             PostStatus  @default(DRAFT)
  authorId           String
  viewCount          Int         @default(0)
  contentWidth       LayoutWidth?
  contentWidthCustom Int? // CUSTOMの場合の幅（px）
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Relations
  category PostCategory   @relation(fields: [categoryId], references: [id])
  author   User           @relation(fields: [authorId], references: [id])
  comments PostComment[]
  versions PostVersion[]

  // OR検索用インデックス
  @@index([title])
  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([viewCount])
  @@map("posts")
}

/// Postのバージョン履歴
model PostVersion {
  id        String   @id @default(uuid())
  postId    String
  version   Int // 自動インクリメント（Post内でユニーク）
  content   String   @db.Text // HTMLスナップショット
  createdAt DateTime @default(now())
  createdBy String? // 作成者ID（User.id）

  // Relations
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, version])
  @@index([postId, createdAt])
  @@map("post_versions")
}

model PostCategory {
  id              String   @id @default(uuid())
  name            String   @unique
  slug            String   @unique
  description     String?  @db.Text
  metaTitle       String?
  metaDescription String?  @db.Text
  ogpImageUrl     String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  posts Post[]

  @@index([order])
  @@map("post_categories")
}

model PostTag {
  id              String   @id @default(uuid())
  name            String   @unique
  slug            String   @unique
  description     String?  @db.Text
  metaTitle       String?
  metaDescription String?  @db.Text
  ogpImageUrl     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("post_tags")
}

model PostComment {
  id              String  @id @default(uuid())
  postId          String
  parentCommentId String? // Self-reference for nested comments

  // Content
  content String @db.Text

  // Author info (either userId OR guest info)
  userId     String? // For logged-in users
  guestName  String? // For guest comments
  guestEmail String? // For guest comments

  // Spam prevention metadata
  ipAddress   String? // For rate limiting (hashed)
  contentHash String? // For duplicate detection

  // Status
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String? // userId of admin who deleted

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  post          Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentComment PostComment? @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       PostComment[] @relation("CommentReplies")

  // Indexes
  @@index([postId, createdAt])
  @@index([parentCommentId])
  @@index([userId])
  @@index([ipAddress, createdAt])
  @@index([guestEmail, createdAt])
  @@index([contentHash])
  @@index([isDeleted])
  @@index([isDeleted, createdAt(sort: Desc)]) // Admin search optimization
  @@map("post_comments")
}

// ==============================================
// CMS Models
// ==============================================

model Page {
  id                 String       @id @default(uuid())
  slug               String       @unique
  title              String
  description        String?      @db.Text
  metaDescription    String?
  metaKeywords       String?
  ogpTitle           String?
  ogpDescription     String?
  ogpImageUrl        String?
  isPublished        Boolean      @default(true)
  publishedAt        DateTime?
  isActive           Boolean      @default(true)
  isSystemPage       Boolean      @default(false) // システムページ（SEO/OGPのみ編集可、コンテンツ編集不可）
  contentWidth       LayoutWidth?
  contentWidthCustom Int? // CUSTOMの場合の幅（px）
  showSidebar        Boolean? // null=デフォルト使用、true/false=明示的指定
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relations
  sections PageSection[]

  @@index([isPublished, isActive])
  @@index([isSystemPage])
  @@map("pages")
}

/// ページセクション（Slice-based CMS）
model PageSection {
  id        String          @id @default(uuid())
  pageId    String
  type      PageSectionType
  title     String? // セクション見出し（表示用）
  config    Json            @default("{}") // タイプ別設定（JSON Schema で型安全）
  content   String?         @db.Text // Lexical HTML（CUSTOM等で使用）
  order     Int             @default(0) // 表示順序（DnDで変更可能）
  isActive  Boolean         @default(true) // ON/OFF制御
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Relations
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order, isActive])
  @@index([type])
  @@map("page_sections")
}

model NavigationItem {
  id         String         @id @default(uuid())
  type       NavigationType
  parentId   String?
  label      String
  url        String
  isExternal Boolean        @default(false)
  order      Int
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Self-relation for submenus
  parent   NavigationItem?  @relation("NavigationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavigationHierarchy")

  @@index([type, order])
  @@map("navigation_items")
}

model SocialLink {
  id            String         @id @default(uuid())
  platform      SocialPlatform
  url           String
  iconUrl       String?
  order         Int
  isActive      Boolean        @default(true)
  showOnDesktop Boolean        @default(true) // デスクトップで表示
  showOnMobile  Boolean        @default(true) // モバイルで表示
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([order])
  @@map("social_links")
}

// ==============================================
// FAQ Models
// ==============================================

model FaqCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  items FaqItem[]

  @@index([order])
  @@index([isActive, order])
  @@map("faq_categories")
}

model FaqItem {
  id          String    @id @default(uuid())
  categoryId  String
  question    String
  answer      String    @db.Text // Lexical HTML (リッチテキスト)
  order       Int       @default(0)
  isPublished Boolean   @default(true)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // SEO設定
  metaDescription String?
  metaKeywords    String?

  // OGP設定
  ogpTitle       String?
  ogpDescription String?
  ogpImageUrl    String?

  // Relations
  category FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, order])
  @@index([isPublished])
  @@map("faq_items")
}

// ==============================================
// Settings (Singleton)
// ==============================================

model Settings {
  id        String   @id @default("singleton")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Site Basic Info
  siteName           String?
  siteDescription    String? @db.Text
  faviconUrl         String?
  defaultOgpImageUrl String?
  headerLogoUrl      String?
  footerLogoUrl      String?
  footerCopyright    String?

  // Logo Display Settings
  useHeaderLogo Boolean @default(true)
  useFooterLogo Boolean @default(true)

