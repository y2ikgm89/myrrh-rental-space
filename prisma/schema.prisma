/// Instagram投稿のキャッシュ
model InstagramPost {
  id           String   @id @default(uuid()) @db.Uuid
  postId       String   @unique // Instagram投稿ID
  postUrl      String // 投稿URL
  mediaUrl     String? // メディアURL
  thumbnailUrl String? // サムネイルURL
  caption      String?  @db.Text // キャプション
  mediaType    InstagramMediaType
  permalink    String // 永続リンク
