  @@index([uploadedBy])
  @@index([isActive, createdAt])
  @@index([mimeType])
  @@map("media")
}

// =============================================================================
// 規約管理（clean-break rebuild）
// =============================================================================

/// 規約の適用先スコープ。1 規約は複数 scope を持てる (多対多風)。
/// 公開 4 経路の同意必須を SSoT 制御する。新 scope 追加は ALTER TYPE ADD VALUE のみ。
/// 旧 requiredAtReservation/Inquiry/Signup 3 boolean は本 enum に統合 (PR: terms-domain overhaul)。
enum TermsScope {
  LOGIN_SIGNUP // /login 社会ログインの新規登録時
  RESERVATION // スペース予約フォーム (/reservation step3)
  INQUIRY // お問い合わせフォーム (/contact + 各 ContactFormSection)
  EVENT_REGISTRATION // イベント申込フォーム (/events/[slug] 申込)
  RESERVATION_SERIES // 繰返し予約フォーム (Phase B.2)

  @@map("terms_scope")
}

/// 規約マスター（最新版を直接保存。バージョン履歴は同意記録の contentSnapshot で代替）
model TermsDocument {
  id           String       @id @default(uuid(7)) @db.Uuid
  type         String       @db.VarChar(64) // VARCHAR で柔軟化（旧 TermsType enum 廃止）
  slug         String       @db.VarChar(50) // 一意性は下記 @@unique(where: deletedAt is null) 参照
  title        String       @db.VarChar(100)
  contentJson  Json         @map("content_json") // Lexical EditorState
  contentHtml  String       @map("content_html") @db.Text // SSR / 同意記録 snapshot 用（保存時 sanitize-html で再生成）
  isPublished  Boolean      @default(false) @map("is_published")
  publishedAt  DateTime?    @map("published_at") @db.Timestamptz(6)
  /// 適用 scope 配列。空配列 = フッター掲載専用 (どの consent フォームにも出ない)。
  scopes       TermsScope[]
  /// 改訂時の周知文 (民法 548 条の 4 周知義務対応・任意)。
  changelog    String?      @db.Text
  showInFooter Boolean      @default(true) @map("show_in_footer")
  displayOrder Int          @default(0) @map("display_order")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(6)

  agreements TermsAgreement[]

  @@unique([slug], map: "terms_documents_slug_active_key", where: { deletedAt: null })
  @@unique([displayOrder], map: "terms_documents_display_order_active_key", where: { deletedAt: null })
  @@index([type])
  @@index([deletedAt, isPublished])
  @@index([showInFooter, isPublished, displayOrder])
  @@map("terms_documents")
}

/// 規約同意記録（証跡）— 同意時の HTML スナップショットを保持しバージョン履歴を兼ねる
model TermsAgreement {
  id              String     @id @default(uuid(7)) @db.Uuid
  termsId         String     @map("terms_id") @db.Uuid
  /// 同意した顧客（null = ゲスト。guestEmail 側で識別する）。
  /// **`customers` への FK は意図的に張らない。** `ON DELETE SET NULL` は
  /// terms_agreements へ UPDATE を発行し append-only trigger に弾かれて
  /// 顧客マージ（`tx.customer.delete`）を必ず失敗させていた。NULL 化は
  /// 「誰が同意したか」という証跡そのものを消すため、trigger の拒否が正しい。
  /// 詳細は AuditLog.userId のコメントと 20260803030000 の migration を参照。
  customerId      String?    @map("customer_id") @db.Uuid
  guestEmail      String?    @map("guest_email") @db.VarChar(255)
  contentSnapshot String     @map("content_snapshot") @db.Text // 同意時 HTML 完全保存
  contentHash     String     @map("content_hash") @db.VarChar(64) // sha256(contentSnapshot)
  agreedAt        DateTime   @default(now()) @map("agreed_at") @db.Timestamptz(6)
  /// 同意が発生した scope (旧 context VARCHAR を enum 化)。
  scope           TermsScope
  /// 同意が紐づくリソースの ID（予約 / 問い合わせ / イベント申込）。
  ///
  /// **`@db.Uuid` にしてはいけない。** 理由は 2 つあり、どちらも今も生きている:
  ///
  /// 1. 複数モデルを指す polymorphic 参照なので、1 モデルの型で縛らない
  ///    （`AuditLog.resourceId` と同じ扱い）。全 ID が uuid に揃った今でも、
  ///    FK を張らないポインタに型を付けると次に別種のリソースを指した瞬間に壊れる
  /// 2. この表は append-only（`prevent_terms_agreements_mutation`）なので、
  ///    20260804000000 の ID 統一より前に書かれた行は **cuid のまま残っている**。
  ///    証跡は書き換えない方針なので、`@db.Uuid` へ narrow すると既存行が読めなくなる
  ///
  /// かつては 1 を軽視して `@db.Uuid` にしており、規約同意付きのイベント申込が
  /// P2007 で必ず失敗していた（#1747）。
  resourceId      String?    @map("resource_id")
  ipAddress       String?    @map("ip_address") @db.VarChar(45)
  userAgent       String?    @map("user_agent") @db.Text

  /// termsId は RESTRICT（子を触らない）だが、onUpdate も明示的に NoAction にする。
  /// 既定の Cascade は親の主キー更新時に terms_agreements へ UPDATE を発行し、
  /// append-only trigger に弾かれるため。
  terms TermsDocument @relation(fields: [termsId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([termsId])
  @@index([customerId])
  @@index([resourceId])
  @@index([agreedAt])
  @@index([scope, agreedAt])
  @@index([guestEmail(ops: raw("gin_trgm_ops"))], type: Gin, map: "terms_agreements_guest_email_trgm_idx")
  @@map("terms_agreements")
}

// =============================================================================
// エディタコメント（Lexical MarkNode連携）
// =============================================================================

/// エディタコメントスレッド（Lexical MarkNodeに紐づく）
model EditorCommentThread {
  id          String              @id @default(uuid(7)) @db.Uuid
  markId      String              @map("mark_id") // Lexical MarkNode ID（エディタ内での一意識別子）
  contentType String              @map("content_type") // コンテンツタイプ: "post" | "news" | "page" | "faq"
  contentId   String              @map("content_id") @db.Uuid // コンテンツID（Post.id, News.id, Page.id, FaqItem.id）
  quotedText  String              @map("quoted_text") @db.Text // マークされたテキスト（参照用）
  status      EditorCommentStatus @default(ACTIVE)
  resolvedAt  DateTime?           @map("resolved_at") @db.Timestamptz(6) // 解決日時
  resolvedBy  String?             @map("resolved_by") @db.Uuid // 解決者ID（User.id）- ユーザー削除時にnull化
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?             @map("created_by") @db.Uuid // 作成者ID（User.id）- ユーザー削除時にnull化

  // Relations
  comments EditorComment[]
  creator  User?           @relation("CommentThreadCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  resolver User?           @relation("CommentThreadResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  // 同一コンテンツ内でmarkIdは一意
  @@unique([markId, contentType, contentId])
  @@index([contentType, contentId, status])
  @@index([createdBy])
  @@index([status, createdAt])
  @@index([resolvedBy], map: "editor_comment_threads_resolved_by_idx", where: { resolvedBy: { not: null } })
  @@map("editor_comment_threads")
}

/// エディタコメント（スレッド内の個別コメント）
model EditorComment {
  id        String    @id @default(uuid(7)) @db.Uuid
  threadId  String    @map("thread_id") @db.Uuid
  content   String    @db.Text // コメント本文
  isDeleted Boolean   @default(false) @map("is_deleted") // ソフトデリート
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6) // 削除日時
  deletedBy String?   @map("deleted_by") @db.Uuid // 削除者ID（User.id）- ユーザー削除時にnull化
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid // 作成者ID（User.id）- ユーザー削除時にnull化

  // Relations
  thread  EditorCommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  creator User?               @relation("EditorCommentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  deleter User?               @relation("EditorCommentDeleter", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([createdBy])
  @@index([isDeleted])
  @@index([deletedBy], map: "editor_comments_deleted_by_idx", where: { deletedBy: { not: null } })
  @@map("editor_comments")
}

/// エディタブロックテンプレート（再利用可能なブロック）
model BlockTemplate {
