// ==============================================
// Myrrh Rental Space - Prisma Schema
// ==============================================
// Prisma 7 + PostgreSQL 16

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ==============================================
// Enums
// ==============================================

enum Role {
  ADMIN
  USER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CustomerStatus {
  NEW
  REGULAR
  VIP
  INACTIVE
  BLACKLIST
}

enum NavigationType {
  HEADER_DESKTOP // デスクトップ用ヘッダーメニュー
  HEADER_MOBILE  // モバイル用ヘッダーメニュー
  FOOTER         // フッターメニュー
}

enum SocialPlatform {
  TWITTER
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  LINE
  TIKTOK
  OTHER
}

// ==============================================
// Auth.js Models
// ==============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?   // bcrypt hashed password
  name          String?
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts     Account[]
  sessions     Session[]
  reservations Reservation[]
  blogPosts    BlogPost[]
  blogComments BlogComment[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model LoginToken {
  id        String   @id @default(uuid())
  token     String   @unique
  createdBy String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("login_tokens")
}

// ==============================================
// Business Models
// ==============================================

model Space {
  id            String   @id @default(uuid())
  name          String
  description   String   @db.Text
  address       String
  access        String?  @db.Text
  capacity      Int
  area          Decimal? @db.Decimal(10, 2)
  hourlyPrice   Decimal  @db.Decimal(10, 2)
  dailyPrice    Decimal? @db.Decimal(10, 2)
  mainImageUrl  String
  imageUrls     Json     @default("[]")
  facilities    Json     @default("[]")
  businessHours Json?
  isPublished   Boolean  @default(false)
  publishedAt   DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  reservations Reservation[]

  @@index([isPublished, isActive])
  @@map("spaces")
}

model Reservation {
  id            String            @id @default(uuid())
  spaceId       String
  userId        String?
  customerId    String
  startTime     DateTime
  endTime       DateTime
  status        ReservationStatus @default(PENDING)
  totalPrice    Decimal?          @db.Decimal(10, 2)
  notes         String?           @db.Text
  termsAgreedAt DateTime?         // 規約同意日時
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Google Calendar Sync
  googleCalendarEventId      String?   // 共有カレンダーのイベントID
  googleCalendarOAuthEventId String?   // OAuth連携（管理者個人）のイベントID
  calendarSyncedAt           DateTime? // 最終同期日時
  calendarSyncError          String?   @db.Text // 同期エラーメッセージ

  // Relations
  space    Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([spaceId])
  @@index([customerId])
  @@index([startTime])
  @@index([endTime])
  @@index([status])
  @@index([spaceId, startTime, endTime])
  @@index([customerId, startTime])
  @@map("reservations")
}

model Customer {
  id                 String         @id @default(uuid())
  lastName           String
  firstName          String
  email              String         @unique
  phoneNumber        String?
  address            String?        @db.Text
  status             CustomerStatus @default(NEW)
  notes              String?        @db.Text
  totalReservations  Int            @default(0)
  totalSpent         Decimal?       @db.Decimal(10, 2)
  lastReservationAt  DateTime?
  firstReservationAt DateTime?
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  reservations Reservation[]

  @@index([lastName])
  @@index([status])
  @@index([isActive])
  @@index([lastReservationAt])
  @@index([lastName, firstName])
  @@map("customers")
}

model Inquiry {
  id        String        @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String        @db.Text
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}

model News {
  id          String    @id @default(uuid())
  title       String
  content     String    @db.Text
  publishedAt DateTime?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
  @@map("news")
}

model AnnouncementBar {
  id        String    @id @default(uuid())
  message   String    @db.VarChar(200)
  type      String    @default("info") // info, warning, promo
  linkUrl   String?
  linkText  String?
  bgColor   String?   // カスタム背景色 (hex)
  textColor String?   // カスタム文字色 (hex)
  isActive  Boolean   @default(true)
  priority  Int       @default(0)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, priority])
  @@index([startAt, endAt])
  @@map("announcement_bars")
}

// ==============================================
// Blog Models
// ==============================================

model BlogPost {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  excerpt         String    @db.Text
  content         String    @db.Text
  thumbnailUrl    String
  ogpImageUrl     String?
  categoryId      String
  tags            Json      @default("[]")
  metaDescription String?
  metaKeywords    String?
  ogpTitle        String?
  ogpDescription  String?
  publishedAt     DateTime?
  isPublished     Boolean   @default(false)
  isDraft         Boolean   @default(true)
  authorId        String
  viewCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  category BlogCategory @relation(fields: [categoryId], references: [id])
  author   User         @relation(fields: [authorId], references: [id])
  comments BlogComment[]

  @@index([isPublished, publishedAt])
  @@index([categoryId, isPublished, publishedAt])
  @@index([viewCount])
  @@map("blog_posts")
}

model BlogCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  posts BlogPost[]

  @@index([order])
  @@map("blog_categories")
}

model BlogTag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_tags")
}

model BlogComment {
  id              String    @id @default(uuid())
  postId          String
  parentCommentId String?   // Self-reference for nested comments

  // Content
  content         String    @db.Text

  // Author info (either userId OR guest info)
  userId          String?   // For logged-in users
  guestName       String?   // For guest comments
  guestEmail      String?   // For guest comments

  // Spam prevention metadata
  ipAddress       String?   // For rate limiting (hashed)
  contentHash     String?   // For duplicate detection

  // Status
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  deletedBy       String?   // userId of admin who deleted

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  post          BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentComment BlogComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       BlogComment[] @relation("CommentReplies")

  // Indexes
  @@index([postId, createdAt])
  @@index([parentCommentId])
  @@index([userId])
  @@index([ipAddress, createdAt])
  @@index([guestEmail, createdAt])
  @@index([contentHash])
  @@index([isDeleted])
  @@index([isDeleted, createdAt(sort: Desc)]) // Admin search optimization
  @@map("blog_comments")
}

// ==============================================
// CMS Models
// ==============================================

model Page {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  description     String?   @db.Text
  content         String    @db.Text
  metaDescription String?
  metaKeywords    String?
  ogpTitle        String?
  ogpDescription  String?
  ogpImageUrl     String?
  isPublished     Boolean   @default(true)
  publishedAt     DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isPublished, isActive])
  @@map("pages")
}

model HomepageHero {
  id                 String   @id @default("singleton")
  title              String   @default("理想のスペースを、あなたに。")
  subtitle           String?  @db.Text
  ctaPrimaryText     String   @default("スペースを探す")
  ctaPrimaryUrl      String   @default("/spaces")
  ctaSecondaryText   String?  @default("お問い合わせ")
  ctaSecondaryUrl    String?  @default("/contact")
  backgroundImageUrl String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("homepage_hero")
}

model NavigationItem {
  id         String         @id @default(uuid())
  type       NavigationType
  parentId   String?
  label      String
  url        String
  isExternal Boolean        @default(false)
  order      Int
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Self-relation for submenus
  parent   NavigationItem?  @relation("NavigationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavigationHierarchy")

  @@index([type, order])
  @@map("navigation_items")
}

model SocialLink {
  id            String         @id @default(uuid())
  platform      SocialPlatform
  url           String
  iconUrl       String?
  order         Int
  isActive      Boolean        @default(true)
  showOnDesktop Boolean        @default(true) // デスクトップで表示
  showOnMobile  Boolean        @default(true) // モバイルで表示
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([order])
  @@map("social_links")
}

// ==============================================
// Settings (Singleton)
// ==============================================

model Settings {
  id        String   @id @default("singleton")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Site Basic Info
  siteName           String?
  siteDescription    String? @db.Text
  faviconUrl         String?
  defaultOgpImageUrl String?
  headerLogoUrl      String?
  footerCopyright    String?

  // Business Info (事業者情報)
  businessName         String?           // 会社名・屋号
  businessNameKana     String?           // 会社名・屋号（カナ）
  representativeName   String?           // 代表者名
  businessType         String?           // 事業形態（個人事業主/法人）
  industryType         String?           // 業種
  establishedDate      DateTime?         // 設立日
  registrationNumber   String?           // 法人番号/登録番号
  invoiceNumber        String?           // インボイス登録番号
  businessDescription  String? @db.Text  // 事業概要

  // Contact Info
  phoneNumber          String?
  faxNumber            String?
  email                String?
  address              String? @db.Text
  postalCode           String?           // 郵便番号
  prefecture           String?           // 都道府県
  city                 String?           // 市区町村
  streetAddress        String?           // 番地以降
  buildingName         String?           // 建物名

  // Business Hours (営業時間)
  businessHours        Json?             // 曜日ごとの営業時間
  regularHolidays      Json?             // 定休日（曜日）
  specialHolidays      Json?             // 特別休業日（日付リスト）
  holidayNotice        String? @db.Text  // 休業日のお知らせ

  // Legacy field - keeping for backwards compatibility
  defaultBusinessHours Json?

  // Email Settings
  senderEmail                        String?
  senderName                         String?
  replyToEmail                       String?
  reservationConfirmationTemplateId  String?
  reservationCancelledTemplateId     String?
  reservationUpdatedTemplateId       String?
  adminNotificationTemplateId        String?

  // SEO Settings
  defaultMetaDescription  String?
  defaultMetaKeywords     String?
  defaultOgpTitle         String?
  defaultOgpDescription   String?

  // Analytics Settings
  analyticsType           String?   // "ga4" | "gtm" | null
  googleAnalyticsId       String?   // GA4 Measurement ID (G-XXXXXXXXXX)
  googleTagManagerId      String?   // GTM Container ID (GTM-XXXXXXX)
  googleSearchConsoleId   String?   // GSC verification meta tag
  bingWebmasterToolsId    String?   // Bing verification meta tag
  gaPropertyId            String?   // GA4 Property ID for Data API

  // Reservation Settings
  defaultTimeSlot                 Int?     @default(60)
  minReservationDuration          Int?     @default(60)
  maxReservationDuration          Int?     @default(480)
  cancellationPolicy              String?  @db.Text
  sendReservationConfirmationEmail Boolean @default(true)
  sendAdminNotificationEmail       Boolean @default(true)

  // Terms Agreement Settings
  termsAgreementEnabled     Boolean @default(true)  // 規約同意チェック有効
  termsAgreementText        String? // カスタム同意文言（null=デフォルト）
  requireTermsAgreement     Boolean @default(true)  // 利用規約への同意必須
  requirePrivacyAgreement   Boolean @default(true)  // プライバシーポリシーへの同意必須

  // Notification Settings
  notifyNewReservation       Boolean @default(true)
  notifyReservationChange    Boolean @default(true)
  notifyReservationCancel    Boolean @default(true)
  notifyNewInquiry           Boolean @default(true)
  notificationEmailAddresses String?

  // Other Settings
  timezone           String?  @default("Asia/Tokyo")
  language           String?  @default("ja")
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?  @db.Text

  // Stripe Payment Settings
  stripeEnabled          Boolean  @default(false)
  stripeTestMode         Boolean  @default(true)
  stripePublishableKey   String?
  stripeSecretKey        String?  @db.Text  // 暗号化して保存
  stripeWebhookSecret    String?  @db.Text  // 暗号化して保存
  stripeAccountId        String?
  stripeCurrency         String   @default("jpy")
  stripeLastTestedAt     DateTime?
  stripeConnectionStatus String?

  // Cookie Consent Settings
  cookieConsentEnabled    Boolean  @default(false)
  cookieConsentMessage    String?  @db.Text
  cookieConsentAcceptText String?
  cookieConsentRejectText String?
  cookieConsentPolicyUrl  String?

  // Announcement Bar Carousel Settings
  announcementBarAnimation     String  @default("fade") // fade, slideX, slideY
  announcementBarDuration      Int     @default(5000)   // ミリ秒
  announcementBarAutoPlay      Boolean @default(true)
  announcementBarPauseOnHover  Boolean @default(true)
  announcementBarShowArrows    Boolean @default(true)
  announcementBarShowIndicator Boolean @default(true)
  announcementBarDesignStyle   String  @default("solid") // solid, gradient, outlined, glass, minimal

  // ==============================================
  // External Service API Keys
  // ==============================================

  // Resend Email Service
  resendApiKey           String?   @db.Text // Encrypted
  resendLastTestedAt     DateTime?
  resendConnectionStatus String?            // 'connected' | 'error'

  // Cloudflare Turnstile (Bot Protection)
  turnstileSiteKey           String?          // Public key (not encrypted)
  turnstileSecretKey         String?   @db.Text // Encrypted
  turnstileLastTestedAt      DateTime?
  turnstileConnectionStatus  String?

  // Google Maps API
  googleMapsApiKey           String?   @db.Text // Encrypted
  googleMapsLastTestedAt     DateTime?
  googleMapsConnectionStatus String?

  // Custom API Keys (Generic key-value storage)
  // Format: { "id": { "name": "...", "key": "encrypted", "value": "encrypted", ... } }
  customApiKeys Json? @default("{}")

  // ==============================================
  // Google Calendar Integration
  // ==============================================

  // サービスアカウント連携（共有カレンダー用）
  googleCalendarEnabled            Boolean   @default(false)
  googleCalendarServiceAccountJson String?   @db.Text  // 暗号化されたJSON認証情報
  googleCalendarId                 String?             // 共有カレンダーID
  googleCalendarLastTestedAt       DateTime?
  googleCalendarConnectionStatus   String?             // 'connected' | 'error'

  // OAuth連携（管理者個人カレンダー用）
  googleCalendarOAuthEnabled       Boolean   @default(false)
  // ※ access_token/refresh_tokenはAccountテーブルに保存

  // 予約者向けiCal設定
  icalAttachmentEnabled            Boolean   @default(true)  // メールにiCal添付
  addToCalendarLinksEnabled        Boolean   @default(true)  // Add to Calendarリンク表示

  @@map("settings")
}
