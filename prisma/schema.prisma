// =============================================================================
// 監査ログ
// =============================================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PERMISSION_DENIED
  PASSWORD_CHANGE
  PASSWORD_RESET_REQUEST
  ROLE_CHANGE
}

enum EditorCommentStatus {
  ACTIVE // アクティブ（未解決）
  RESOLVED // 解決済み
  DELETED // 削除済み（ソフトデリート）
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum MediaUsage {
  POST
  NEWS
  PAGE
  SPACE
  EVENT
  SITE
  GENERAL
}

/// 監査ログ（書き込み操作 + セキュリティイベント）
model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid // 実行ユーザー（null = システム or 未認証）
  action     AuditAction // 操作種別
  resource   String // 対象リソース種別 ('space', 'blog' 等)
  resourceId String? // 対象リソースID
  oldValue   Json? // 変更前の値（UPDATE時）
  newValue   Json? // 変更後の値 or 作成値
  metadata   Json? // 追加情報（IPアドレス、UserAgent等）
  createdAt  DateTime    @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// =============================================================================
// メディア管理
// =============================================================================

/// メディアファイル管理
model Media {
  id          String @id @default(uuid()) @db.Uuid
  filename    String // 元のファイル名
  storagePath String // Cloudflare R2 オブジェクトキー（`{prefix}/{folder}/{timestamp}-{uuid}.{ext}`）
  url         String // 公開URL
  bucket      String // ストレージ prefix（`STORAGE_PREFIXES` の 4 値: `spaces` / `posts` / `site` / `media`）
  mimeType    String // MIME type
  size        Int // ファイルサイズ（bytes）
  width       Int? // 画像幅（px）
  height      Int? // 画像高さ（px）

  // 分類・検索用
  type        MediaType // メディア種別
  usage       MediaUsage @default(GENERAL) // 用途
  alt         String? // 代替テキスト
  title       String? // タイトル
  description String?    @db.Text // 説明
  tags        Json       @default("[]") // タグ配列

  // 管理情報
  uploadedBy String? @db.Uuid // アップロードユーザーID（User削除時にnull化）
  isActive   Boolean  @default(true) // ソフトデリート
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  uploader User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([type, usage])
  @@index([uploadedBy])
  @@index([isActive, createdAt])
  @@index([mimeType])
  @@map("media")
}

// =============================================================================
// レートリミット
// =============================================================================

/// ログイン試行記録（レートリミット用）
model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String // IPアドレス or メールのハッシュ
  email      String // 試行されたメールアドレス
  success    Boolean // 成功/失敗
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([email, createdAt])
  @@map("login_attempts")
}

// =============================================================================
// 規約管理（clean-break rebuild）
// =============================================================================

/// 規約マスター（最新版を直接保存。バージョン履歴は同意記録の contentSnapshot で代替）
model TermsDocument {
  id                    String    @id @default(uuid()) @db.Uuid
  type                  String    @db.VarChar(64)         // VARCHAR で柔軟化（旧 TermsType enum 廃止）
  slug                  String    @unique @db.VarChar(50)
  title                 String    @db.VarChar(100)
  contentJson           Json                              // Lexical EditorState
  contentHtml           String    @db.Text                // SSR / 同意記録 snapshot 用
  isPublished           Boolean   @default(false)
  publishedAt           DateTime?
  requiredAtReservation Boolean   @default(false)
  requiredAtInquiry     Boolean   @default(false)
  requiredAtSignup      Boolean   @default(false)
  showInFooter          Boolean   @default(true)
  footerOrder           Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  agreements TermsAgreement[]

  @@index([type])
  @@index([deletedAt, isPublished])
  @@index([showInFooter, isPublished, footerOrder])
  @@map("terms_documents")
}

/// 規約同意記録（証跡）— 同意時の HTML スナップショットを保持しバージョン履歴を兼ねる
model TermsAgreement {
  id              String   @id @default(uuid()) @db.Uuid
  termsId         String   @db.Uuid
  customerId      String?  @db.Uuid
  guestEmail      String?  @db.VarChar(255)
  contentSnapshot String   @db.Text                // 同意時 HTML 完全保存
  contentHash     String   @db.VarChar(64)         // sha256(contentSnapshot)
  agreedAt        DateTime @default(now())
  context         String   @db.VarChar(64)         // "reservation"/"inquiry"/"signup"
  resourceId      String?  @db.Uuid                // 予約 ID 等
  ipAddress       String?  @db.VarChar(45)
  userAgent       String?  @db.Text

  terms    TermsDocument @relation(fields: [termsId], references: [id], onDelete: Restrict)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([termsId])
  @@index([customerId])
  @@index([resourceId])
  @@index([agreedAt])
  @@index([context, agreedAt])
  @@map("terms_agreements")
}

// =============================================================================
// エディタコメント（Lexical MarkNode連携）
// =============================================================================

/// エディタコメントスレッド（Lexical MarkNodeに紐づく）
model EditorCommentThread {
  id          String              @id @default(uuid()) @db.Uuid
  markId      String // Lexical MarkNode ID（エディタ内での一意識別子）
  contentType String // コンテンツタイプ: "post" | "news" | "page" | "faq"
  contentId String @db.Uuid // コンテンツID（Post.id, News.id, Page.id, FaqItem.id）
  quotedText  String              @db.Text // マークされたテキスト（参照用）
  status      EditorCommentStatus @default(ACTIVE)
  resolvedAt  DateTime? // 解決日時
  resolvedBy String? @db.Uuid // 解決者ID（User.id）- ユーザー削除時にnull化
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdBy String? @db.Uuid // 作成者ID（User.id）- ユーザー削除時にnull化

  // Relations
  comments EditorComment[]
  creator  User?           @relation("CommentThreadCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  resolver User?           @relation("CommentThreadResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  // 同一コンテンツ内でmarkIdは一意
  @@unique([markId, contentType, contentId])
  @@index([contentType, contentId, status])
  @@index([createdBy])
  @@index([status, createdAt])
  @@map("editor_comment_threads")
}

/// エディタコメント（スレッド内の個別コメント）
model EditorComment {
  id        String    @id @default(uuid()) @db.Uuid
  threadId String @db.Uuid
  content   String    @db.Text // コメント本文
  isDeleted Boolean   @default(false) // ソフトデリート
  deletedAt DateTime? // 削除日時
  deletedBy String? @db.Uuid // 削除者ID（User.id）- ユーザー削除時にnull化
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String? @db.Uuid // 作成者ID（User.id）- ユーザー削除時にnull化

  // Relations
  thread  EditorCommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  creator User?               @relation("EditorCommentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  deleter User?               @relation("EditorCommentDeleter", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([createdBy])
  @@index([isDeleted])
  @@map("editor_comments")
}

/// エディタブロックテンプレート（再利用可能なブロック）
model BlockTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String // テンプレート名
  description String?  @db.Text // 説明
  nodeJson    Json // Lexical SerializedEditorState JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy String? @db.Uuid // 作成者ID（User.id）- ユーザー削除時にnull化

  // Relations
  creator User? @relation("BlockTemplateCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([createdBy])
  @@index([createdAt])
  @@map("block_templates")
}


// ==============================================
// Space Review Model (スペースレビュー)
// ==============================================

model SpaceReview {
  id            String    @id @default(uuid()) @db.Uuid
  spaceId       String    @db.Uuid
  customerId    String    @db.Uuid
  reservationId String    @unique @db.Uuid
  rating        Int
  title         String?   @db.VarChar(100)
  comment       String?   @db.VarChar(1000)
  isPublished   Boolean   @default(true)
  replyBody     String?   @db.VarChar(1000)
  repliedAt     DateTime?
  repliedById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  space       Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  repliedBy   User?       @relation("SpaceReviewReplyAuthor", fields: [repliedById], references: [id], onDelete: SetNull)

  @@index([spaceId, isPublished, createdAt(sort: Desc)])
  @@index([customerId])
  @@index([repliedById])
  @@map("space_reviews")
}


// ==============================================
// Event Model (イベント)
// ==============================================

model Event {
  id                    String      @id @default(cuid()) @db.VarChar(30)
  title                 String      @db.VarChar(200)
  slug                  String      @unique @db.VarChar(100)
  /// Lexical EditorState JSON（正本）
  descriptionJson       Json
  /// Lexical → 公開表示用 HTML キャッシュ（SanitizedHtml で出力）
  descriptionHtml       String      @db.Text
  /// SEO description / カード要約 / メタデータ用プレーンテキスト派生
  descriptionPlainText  String      @db.Text
  thumbnailUrl          String?
  startTime             DateTime
  endTime               DateTime
  capacity              Int?
  price                 Int?
  /// 号室・フロア・補足情報または外部会場名。
  /// locationId/spaceId と併用時は補足情報（フロア・入口案内等）、
  /// 両方 null のときは外部会場名として使う。
  addressDetail         String?     @db.VarChar(200)
  /// 会場（本館・渋谷店等）。null = 外部会場または未設定
  locationId            String?     @db.Uuid
  /// 会場内のスペース。null = 会場全体 or 外部会場
  spaceId               String?     @db.Uuid
  status                EventStatus @default(DRAFT)
  registrationOpen      Boolean     @default(true)
  /// 申込締切日時（null = 開始時刻まで受付）。startTime <= 必須。
  registrationDeadline  DateTime?
  googleCalendarEventId String?     @unique
  publishedAt           DateTime?
  deletedAt             DateTime?
  deletedById           String?     @db.Uuid
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  location      Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  space         Space?              @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  deletedBy     User?               @relation("EventDeletions", fields: [deletedById], references: [id], onDelete: SetNull)
  registrations EventRegistration[]

  @@index([startTime, endTime])
  @@index([status])
  @@index([locationId])
  @@index([spaceId])
  @@index([deletedAt])
  @@map("events")
}

// ==============================================
// Event Registration Model (イベント申込)
// ==============================================

model EventRegistration {
  id              String             @id @default(cuid()) @db.VarChar(30)
  eventId         String             @db.VarChar(30)
  name            String             @db.VarChar(100)
  email           String             @db.VarChar(255)
  phone           String?            @db.VarChar(20)
  note            String?            @db.Text
  numberOfPeople  Int                @default(1)
  status          RegistrationStatus @default(CONFIRMED)
  customerId      String?            @db.Uuid
  cancelledAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // iCal RFC 5545 SEQUENCE (increments on update/cancel)
  icsSequence Int @default(0)

  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  customer        Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([customerId])
  @@index([status])
  @@index([eventId, status, createdAt])
  @@map("event_registrations")
}

// ==============================================
// Admin Notification
// ==============================================

model AdminNotification {
  id           String   @id @default(uuid()) @db.Uuid
  type         String   @db.VarChar(50)
  title        String   @db.VarChar(200)
  message      String   @db.VarChar(500)
  resourceType String?  @db.VarChar(50)
  resourceId   String?  @db.Uuid
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([isRead, createdAt(sort: Desc)])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@map("admin_notification")
}
