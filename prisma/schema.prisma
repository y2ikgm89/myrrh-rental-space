  phoneNumber   String?
  faxNumber     String?
  email         String?
  postalCode    String? // 郵便番号
  prefecture    String? // 都道府県
  city          String? // 市区町村
  streetAddress String? // 番地以降
  buildingName  String? // 建物名

  // Business Hours (営業時間)
  businessHours   Json? // 曜日ごとの営業時間
  regularHolidays Json? // 定休日（曜日）
  holidayNotice   String? @db.Text // 休業日のお知らせ

  // Access Info (アクセス情報)
  // 交通案内・駐車場案内は Location 単位（multi-location）が SSoT。
  // Settings 側の旧 accessInfo / parkingInfo は 2026-05-01 に廃止。

  // Email Settings
  senderEmail                       String?
  senderName                        String?
  replyToEmail                      String?
  reservationConfirmationTemplateId String?
  reservationCancelledTemplateId    String?
  reservationUpdatedTemplateId      String?
  adminNotificationTemplateId       String?

  // SEO Settings
  defaultMetaDescription String?
  defaultMetaKeywords    String?
  defaultOgpTitle        String?
  defaultOgpDescription  String?

  // Layout Settings (レイアウト設定)
  containerWidth        LayoutWidth?
  containerWidthCustom  Int? // CUSTOMの場合の幅（px）
  contentWidth          LayoutWidth?
  contentWidthCustom    Int? // CUSTOMの場合の幅（px）
  headerScrollBehavior  HeaderScrollBehavior @default(always_visible)
  headerBackgroundMode  HeaderBackgroundMode @default(solid)

