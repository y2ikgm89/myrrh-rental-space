// CMS Models
// ==============================================

model Page {
  id              String    @id @default(uuid(7)) @db.Uuid
  slug            String    @unique
  title           String
  metaDescription String?   @map("meta_description")
  metaKeywords    String?   @map("meta_keywords")
  ogpTitle        String?   @map("ogp_title")
  ogpDescription  String?   @map("ogp_description")
  ogpImageUrl     String?   @map("ogp_image_url")
  isPublished     Boolean   @default(true) @map("is_published")
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  isActive        Boolean   @default(true) @map("is_active")
  isSystemPage    Boolean   @default(false) @map("is_system_page") // システムページ（SEO/OGPのみ編集可、コンテンツ編集不可）
  template        String    @db.VarChar(64)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  sections    Section[]
  assignments UserPageAssignment[]

  @@index([isPublished, isActive])
  @@index([isSystemPage])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' — searchPages ORs
  // title/slug; both branches need trigram to avoid Seq Scan fallback.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "pages_title_trgm_idx")
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "pages_slug_trgm_idx")
  @@map("pages")
}

/// 統一セクション（システムページ + カスタムページ共通）
/// 全 section は必ず Page に紐づく（home の page-hero も含めて pageId = Page.id、seed.ts 参照）。
/// 旧仕様（pageId nullable = home section）は廃止済（migration `_section_page_id_not_null`）。
/// title / contentHtml / contentJson 列は廃止し config JSON に統合済（CUSTOM section の title +
/// body は config.title + config.body で編集、migration `_drop_section_legacy_columns_*` 参照）。
model Section {
  id        String   @id @default(uuid(7)) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  type      String   @db.VarChar(64)
  order     Int      @default(0) // 表示順序（DnDで変更可能）
  isActive  Boolean  @default(true) @map("is_active") // ON/OFF制御
  config    Json     @default("{}") // タイプ別設定（Zodで型安全）
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, order], map: "sections_page_id_order_key")
  @@index([pageId, order, isActive])
  @@index([type])
  @@map("sections")
}

model NavigationItem {
  id         String         @id @default(uuid(7)) @db.Uuid
  type       NavigationType
  parentId   String?        @map("parent_id") @db.Uuid
  /// Sanity Portable Text 互換の token 配列（{type:"text",value} | {type:"icon",name}）。
  /// テキスト + アイコンの混在を任意位置で表現する SSoT。空配列 [] は許容しない（空ナビ防止は admin form 層で）。
  /// icon-only モードは禁止（NN/g 準拠 — 必ず text token と併記、SR は text のみ読み上げ）。
  label      Json
  url        String
  isExternal Boolean        @default(false) @map("is_external")
  order      Int
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Self-relation for submenus
  parent   NavigationItem?  @relation("NavigationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavigationHierarchy")

  @@unique([type, order], map: "navigation_items_type_order_key")
  @@index([parentId])
  @@map("navigation_items")
}

model SocialLink {
  id            String         @id @default(uuid(7)) @db.Uuid
  platform      SocialPlatform
  url           String
  order         Int
  isActive      Boolean        @default(true) @map("is_active")
  showOnDesktop Boolean        @default(true) @map("show_on_desktop") // デスクトップで表示
  showOnMobile  Boolean        @default(true) @map("show_on_mobile") // モバイルで表示
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([order], map: "social_links_order_key")
  @@map("social_links")
}

// ==============================================
// FAQ Models
// ==============================================

model FaqCategory {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String
  slug        String // 一意性は下記 @@unique(where: deletedAt is null) 参照
  description String?   @db.Text
  icon        String? // キュレーション済みアイコン名（任意、SpaceCategory.icon と同方式）
  order       Int       @default(0)
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  items FaqItem[]

  // Round-5 audit Finding #18: slug が無条件 @unique だと、ソフトデリート済み
  // カテゴリーが (permanentlyDelete するまで) 行として残り続ける限り同じ slug の
  // 新規作成が DB 制約で常に拒否される。ドメイン層の ensureFaqCategoryUnique は
  // 既に deletedAt: null で絞って「空いている」と判定していたため、この DB 制約
  // 側の非対称により createFaqCategory が生の P2002 (executeAdminMutationResult
  // が DomainError しか friendly化しない) で失敗していた。order と同じ partial
  // unique index に揃える。
  @@unique([slug], map: "faq_categories_slug_active_key", where: { deletedAt: null })
  @@unique([order], map: "faq_categories_order_active_key", where: { deletedAt: null })
  @@index([order])
  @@index([isActive, order])
  @@index([deletedAt])
  @@map("faq_categories")
}

model FaqItem {
  id              String    @id @default(uuid(7)) @db.Uuid
  categoryId      String    @map("category_id") @db.Uuid
  question        String
  answer          String    @db.Text // 回答（プレーンテキスト、改行保持）
  order           Int       @default(0)
  isPublished     Boolean   @default(true) @map("is_published")
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  viewCount       Int       @default(0) @map("view_count") // 公開ページでの閲覧回数（集計値、localStorage で dedup）
  lastViewedAt    DateTime? @map("last_viewed_at") @db.Timestamptz(6) // 直近閲覧日時（人気度の新鮮度判断用）
  helpfulCount    Int       @default(0) @map("helpful_count") // 「役に立った」投票数（localStorage で dedup）
  notHelpfulCount Int       @default(0) @map("not_helpful_count") // 「役に立たなかった」投票数（localStorage で dedup）
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  category FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, order], map: "faq_items_category_id_order_active_key", where: { deletedAt: null })
  @@index([categoryId, order])
  @@index([categoryId, isPublished, order])
  @@index([isPublished])
  @@index([deletedAt])
  @@index([updatedAt])
  @@index([viewCount])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' — searchFaqItems ORs
  // question/answer; both branches need trigram to avoid Seq Scan fallback.
  @@index([question(ops: raw("gin_trgm_ops"))], type: Gin, map: "faq_items_question_trgm_idx")
  @@index([answer(ops: raw("gin_trgm_ops"))], type: Gin, map: "faq_items_answer_trgm_idx")
  @@map("faq_items")
}

