// ==============================================
// Myrrh Rental Space - Prisma Schema
// ==============================================
// Prisma 7 + PostgreSQL 16

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  engineType      = "client"
  runtime         = "bun"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ==============================================
// Enums
// ==============================================

enum Role {
  SUPER_ADMIN // 全権限（システム設定、ユーザー管理、監査ログ）
  ADMIN // コンテンツ管理全般
  EDITOR // 割り当てページ編集のみ
  VIEWER // 閲覧のみ
  USER // 公開ユーザー（非管理者）
  CUSTOMER // 顧客（ソーシャルログイン）
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CustomerType {
  PERSONAL
  CORPORATE
}

enum CustomerStatus {
  NEW
  REGULAR
  VIP
  INACTIVE
  BLACKLIST
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum NavigationType {
  HEADER_DESKTOP // デスクトップ用ヘッダーメニュー
  HEADER_MOBILE // モバイル用ヘッダーメニュー
  FOOTER // フッターメニュー
}

enum SocialPlatform {
  TWITTER
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  LINE
  TIKTOK
  OTHER
}

enum LayoutWidth {
  XS
  SM
  MD
  LG
  XL
  FULL
  CUSTOM
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CouponType {
  PERCENTAGE // パーセント割引 (例: 20%)
  FIXED_AMOUNT // 定額割引 (例: ¥1,000)
}

// --- 新規 Enum（String → Enum 変換） ---

enum DiscountType {
  none
  percentage
  fixed
}

enum DurationDiscountOverride {
  inherit
  enabled
  disabled
}

enum TaxRateType {
  standard
  reduced
}

// @map required: hyphens in DB values
enum HeaderScrollBehavior {
  auto_hide      @map("auto-hide")
  always_visible @map("always-visible")
  hide_on_scroll @map("hide-on-scroll")
}

enum HeaderBackgroundMode {
  solid       @map("solid")
  transparent @map("transparent")
}

enum TaxDisplayMode {
  tax_excluded
  tax_included
  both
}

enum TaxInputMode {
  tax_excluded
  tax_included
}

enum CalendarSyncMethod {
  polling
  webhook
  both
}

enum AnalyticsType {
  ga4
  gtm
}

enum DiscountCombinationMode {
  best
  both
}

enum AnnouncementBarAnimation {
  fade
  slideX
  slideY
}

enum AnnouncementBarDesignStyle {
  solid
  gradient
  outlined
  glass
  minimal
  striped
}

enum InstagramMediaType {
  IMAGE
  VIDEO
  CAROUSEL_ALBUM
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

enum EventScheduleMode {
  /// 単一開催。DB 上は EventTimeSlot 1 件だけを持つ。
  SINGLE_OCCURRENCE
  /// 日時選択制。公開申込で複数の EventTimeSlot から選ばせる。
  TIMED_ENTRY
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
  WAITLISTED
  WAITLISTED_OFFERED
  EXPIRED
}

/// Resend Webhook (email.bounced / email.complained) で観測された配信状態。
/// Gmail Feb 2024 / Yahoo bulk sender 要件 (complaint rate < 0.3%) 対応で、
/// HARD_BOUNCED / COMPLAINED 宛先には送信前に suppress する。
/// - OK: 既定値（観測なし or 正常配信）
/// - SOFT_BOUNCED: bounce.type=Temporary（再送猶予あり）
/// - HARD_BOUNCED: bounce.type=Permanent（送信永久停止）
/// - COMPLAINED: email.complained（受信者がスパム報告 → 送信永久停止）
enum EmailDeliveryStatus {
  OK
  SOFT_BOUNCED
  HARD_BOUNCED
  COMPLAINED
}

/// SpaceRatePlan の曜日制約。空配列 (daysOfWeek: []) は「全曜日」を意味する。
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// SpaceRatePlan の祝日マッチ条件。
enum HolidayMode {
  any // 祝日/平日どちらでもマッチ (default)
  only // 祝日のみマッチ
  exclude // 祝日は除外 (平日のみ)
}

// ==============================================
// Better Auth Models
// ==============================================

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  accounts     Account[]
  sessions     Session[]
  reservations Reservation[]
  posts        Post[]
  auditLogs    AuditLog[]
  mediaFiles   Media[]
  customer     Customer?     @relation("CustomerUser")
  blockedDates BlockedDate[]

  // RBAC: EDITOR用の割り当てページ（中間テーブル）
  pageAssignments UserPageAssignment[]

  // FK: createdBy / resolvedBy / deletedBy リレーション
  createdCommentThreads  EditorCommentThread[] @relation("CommentThreadCreator")
  resolvedCommentThreads EditorCommentThread[] @relation("CommentThreadResolver")
  createdEditorComments  EditorComment[]       @relation("EditorCommentCreator")
  deletedEditorComments  EditorComment[]       @relation("EditorCommentDeleter")
  inquiryReplies         Inquiry[]             @relation("InquiryReplies")
  reservationDeletions   Reservation[]         @relation("ReservationDeletions")
  eventDeletions         Event[]               @relation("EventDeletions")
  createdBlockTemplates  BlockTemplate[]       @relation("BlockTemplateCreator")
  repliedSpaceReviews    SpaceReview[]         @relation("SpaceReviewReplyAuthor")

  // OR検索用インデックス
  @@index([name])
  @@map("user")
}

/// EDITOR用のページ割り当て（中間テーブル）
model UserPageAssignment {
  userId String @db.Uuid
  pageId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([userId, pageId])
  @@index([pageId])
  @@map("user_page_assignments")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  accountId             String // Better Auth: ユーザーID or プロバイダーのアカウントID
  providerId            String // Better Auth: "credential" or "google" etc.
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // Better Auth: credential provider のパスワード（scrypt hash）
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ==============================================
// Business Models
// ==============================================

model Location {
  id              String  @id @default(uuid()) @db.Uuid
  slug            String  @unique @db.VarChar(255)
  name            String  @unique
  description     String? @db.Text
  address         String
  postalCode      String?
  prefecture      String?
  city            String?
  streetAddress   String?
  buildingName    String?
  /// 交通案内（最寄り駅・路線・徒歩分数等）。1 行 = 1 経路の構造化配列。
  /// 旧 access String 列（改行区切り）を 2026-05-01 に Json 配列化（破壊的変更）。
  accessLines     Json    @default("[]")
  parkingInfo     String? @db.Text
  amenities       Json    @default("{}")
  imageUrl        String
  imageUrls       Json    @default("[]")
  businessHours   Json?
  specialHolidays Json?

  // MEO（Local SEO）— Settings から移管
  latitude              Float?
  longitude             Float?
  googleBusinessPlaceId String?
  googleReviewUrl       String?
  priceRange            String? @db.VarChar(100)
  paymentAccepted       String?
  phoneNumber           String?
  email                 String?

  // GBP Sync
  gbpSyncEnabled Boolean   @default(true)
  gbpSyncedAt    DateTime?
  gbpSyncError   String?   @db.Text

  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // スマートロックデバイス登録簿からの既定デバイス（任意）。新規Space作成時に
  // Space.smartLockDeviceIdの初期値として継承される（登録し忘れ防止）。
  defaultSmartLockDeviceId String? @db.Uuid

  // Relations
  spaces                 Space[]
  events                  Event[]
  blockedDates            BlockedDate[]
  smartLockDevices        SmartLockDevice[]      @relation("LocationSmartLockDevices")
  defaultSmartLockDevice  SmartLockDevice?        @relation("LocationDefaultSmartLockDevice", fields: [defaultSmartLockDeviceId], references: [id], onDelete: SetNull)

  @@unique([sortOrder], map: "locations_active_sortOrder_key", where: { isActive: true })
  @@index([isPublished, isActive])
  @@index([sortOrder])
  @@index([gbpSyncError])
  @@index([defaultSmartLockDeviceId])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' OR-branch coverage
  // (searchLocations queries name OR address; PostgreSQL falls back to Seq
  // Scan unless every OR branch is indexed).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "locations_name_trgm_idx")
  @@index([address(ops: raw("gin_trgm_ops"))], type: Gin, map: "locations_address_trgm_idx")
  @@map("locations")
}

model SpaceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique // 例: 会議室、スタジオ、セミナー室（seed idempotency 保証）
  description String?  @db.Text
  icon        String? // アイコン名（任意）
  color       String? // テーマカラー（任意）
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  spaces Space[]

  @@unique([sortOrder], map: "space_categories_sortOrder_key")
  @@index([sortOrder])
  @@map("space_categories")
}

model Space {
  id                   String    @id @default(uuid()) @db.Uuid
  slug                 String    @unique
  name                 String
  /// Lexical EditorState JSON（正本）
  descriptionJson      Json
  /// Lexical → 公開表示用 HTML キャッシュ（SanitizedHtml で出力）
  descriptionHtml      String    @db.Text
  /// SEO description / カード要約 / メタデータ用プレーンテキスト派生
  descriptionPlainText String    @db.Text
  /// 号室・フロア等。建物の住所は必ず `Location.address` を正本とする。
  /// 主要交通案内・駐車場情報は親 Location（accessLines / parkingInfo）が SSoT。
  addressDetail        String?   @db.Text
  capacity             Int
  area                 Decimal?  @db.Decimal(10, 2)
  hourlyPrice          Decimal   @db.Decimal(10, 2)
  mainImageUrl         String
  gallery              Json      @default("[]")
  /// 構造化された設備リスト（Airbnb / Booking.com 標準パターン）。
  /// JSON 配列 `{ name: string; iconName: string }[]`。
  /// `iconName` は `@/shared/lib/icon-curation` の curation 識別子。
  /// 空文字 = icon 未指定（fallback で text のみ表示）。
  facilities           Json      @default("[]")
  businessHours        Json?
  isPublished          Boolean   @default(false)
  publishedAt          DateTime?
  isActive             Boolean   @default(true)
  /// レビュー機能の per-space ON/OFF。false の場合は公開ページで非表示 + 投稿不可。
  /// 新規スペースはデフォルト false（opt-in）。`Settings.featureModules.reviews` が上位 gate。
  reviewsEnabled       Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // SEO設定
  metaDescription String?
  metaKeywords    String?

  // OGP設定
  ogpTitle       String?
  ogpDescription String?
  ogpImageUrl    String?

  // 割引設定（Enum化）
  discountType             DiscountType             @default(none)
  discountValue            Decimal?                 @db.Decimal(10, 2)
  durationDiscountOverride DurationDiscountOverride @default(inherit)

  // 税率設定（Enum化）
  taxRateType TaxRateType @default(standard)

  // 場所・カテゴリー設定（拠点は必須。カテゴリーは任意）
  locationId String  @db.Uuid
  categoryId String? @db.Uuid

  // スマートロックデバイス（同一Locationに登録済みのデバイスから1台選択、任意）。
  // デバイスはLocation所有のため、同じ物理ロックを複数Spaceで共有できる
  // （例: 建物入口の共有ロックを複数の貸室が使う場合）。
  smartLockDeviceId String? @db.Uuid

  // Relations
  reservations    Reservation[]
  reviews         SpaceReview[]
  events          Event[]
  blockedDates    BlockedDate[]
  ratePlans       SpaceRatePlan[]
  location        Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  category        SpaceCategory?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  smartLockDevice SmartLockDevice? @relation(fields: [smartLockDeviceId], references: [id], onDelete: SetNull)

  // OR検索用インデックス
  @@index([name])
  @@index([addressDetail])
  @@index([isPublished, isActive])
  @@index([publishedAt, isActive])
  @@index([locationId])
  @@index([categoryId])
  @@index([smartLockDeviceId])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' — searchSpaces uses
  // `OR: [{ name }, { slug }]`, so both branches need trigram to avoid a
  // Seq Scan fallback (per Codex review on PR #986).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "spaces_name_trgm_idx")
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "spaces_slug_trgm_idx")
  @@map("spaces")
}

/// 曜日別 / 時間帯別 / 特定期間 / 祝日料金プラン。マッチする plan がない時間帯は
/// `Space.hourlyPrice` にフォールバックする。同一時間帯に複数 plan がマッチした場合は
/// `updatedAt DESC`（last-updated-wins）で 1 件を採用する。解決ロジックは
/// `src/shared/lib/pricing/rate-plan-resolver.ts`（Task 4 で追加）。
/// CHECK 制約 4 本（hourlyPrice >= 0 / startTime・endTime の HH:MM 形式 / effectiveFrom <=
/// effectiveTo）は Prisma 7 が `@@check` 属性を持たないため migration.sql に手書きしてある。
/// `prisma db pull` で introspection すると欠落するため、再生成時は手で復元すること
/// （BlockedDate の CHECK 制約と同じ注意点）。
model SpaceRatePlan {
  id      String @id @default(cuid()) @db.VarChar(30)
  spaceId String @db.Uuid
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(100) // 例: "週末料金", "GW料金", "深夜料金", "祝日料金"
  hourlyPrice Decimal @db.Decimal(10, 2)

  daysOfWeek    DayOfWeek[] // 空配列 = 全曜日（曜日制約なし）
  holidayMode   HolidayMode @default(any)
  startTime     String?     @db.VarChar(5) // "HH:MM" (24h)、null = 00:00（開始）
  endTime       String?     @db.VarChar(5) // "HH:MM"、null = 24:00（終了、半開区間）
  effectiveFrom DateTime?   @db.Date // JST 日付、null = 期限なし
  effectiveTo   DateTime?   @db.Date // JST 日付（inclusive）、null = 期限なし

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // last-updated-wins 優先度用

  @@index([spaceId, updatedAt(sort: Desc)])
  @@map("space_rate_plans")
}

/// 臨時休業 / 急な休み（businessHours の曜日別定休日を補完する日付範囲ベースの休業）。
/// per-space / per-location / global の 3 階層 cascade（additive、override なし）。
/// scope と type は VarChar + 型ガード SSoT（`@/shared/lib/validations/enums/helpers`）で運用。
/// scope / spaceId / locationId は discriminated union 不変条件を持つ:
/// SPACE→spaceId 必須・locationId null / LOCATION→locationId 必須・spaceId null /
/// GLOBAL→両方 null。これは DB の CHECK 制約 `blocked_dates_scope_target_check`
/// (baseline migration 00000000000000_init) で強制されるが、Prisma schema DSL では
/// 表現できないため schema.prisma は完全な SSoT ではない。
/// ⚠ `prisma db pull`（introspection）は CHECK 制約を取り込まず黙って落とすので、
/// introspection で schema を再生成する際は本制約を手で復元すること
/// （`prisma migrate reset` は baseline migration を再生するため制約は復元される）。
/// アプリ層は Zod superRefine（blocked-date バリデーション）で同一不変条件を二重に保証する。
model BlockedDate {
  id         String   @id @default(uuid()) @db.Uuid
  /// "SPACE" | "LOCATION" | "GLOBAL"（isValidBlockedDateScope で検証）
  scope      String   @db.VarChar(16)
  /// scope=SPACE のみ非 null
  spaceId    String?  @db.Uuid
  /// scope=LOCATION のみ非 null
  locationId String?  @db.Uuid
  /// JST カレンダー日付を UTC 深夜で保持。単日休業は startDate=endDate。
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  /// "年末年始" / "設備点検" / "台風 19 号による臨時休業" 等の plain text ラベル
  reason     String?  @db.VarChar(200)
  /// "HOLIDAY" | "MAINTENANCE" | "EMERGENCY" | "OTHER"（isValidBlockedDateType で検証）
  type       String   @db.VarChar(32)
  createdBy  String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  space    Space?    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  creator  User      @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([scope, startDate, endDate])
  @@index([spaceId, startDate, endDate])
  @@index([locationId, startDate, endDate])
  @@map("blocked_dates")
}

model Reservation {
  id         String            @id @default(uuid()) @db.Uuid
  spaceId    String            @db.Uuid
  userId     String?           @db.Uuid
  customerId String            @db.Uuid
  /// Space reservations are half-open intervals: [startTime, endTime).
  /// DB invariant `reservations_time_order_check` enforces startTime < endTime.
  startTime  DateTime
  endTime    DateTime
  /// Active inventory states are PENDING / CONFIRMED. DB invariant
  /// `reservations_no_active_time_overlap_excl` prevents overlapping active,
  /// non-deleted reservations for the same space by using PostgreSQL EXCLUDE
  /// with `tsrange(startTime, endTime, '[)')`.
  ///
  /// Prisma schema DSL cannot express EXCLUDE constraints or CHECK constraints.
  /// `prisma db pull` will not preserve these invariants; keep migration SQL,
  /// comments, and `__tests__/integration/domain/reservations/db-invariants.test.ts`
  /// in sync if this model changes.
  status     ReservationStatus @default(PENDING)
  totalPrice Decimal           @db.Decimal(10, 2) // 割引後・税抜（NOT NULL、legacy row は migration backfill 済み）
  notes      String?           @db.Text
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  // 割引情報
  couponId               String?  @db.Uuid // 適用されたクーポンID
  couponDiscountAmount   Decimal? @db.Decimal(10, 2) // クーポン割引額
  durationDiscountAmount Decimal? @db.Decimal(10, 2) // 長時間割引額
  spaceDiscountAmount    Decimal? @db.Decimal(10, 2) // スペース固有割引額
  basePrice              Decimal  @db.Decimal(10, 2) // 割引前価格（NOT NULL、Σ segment.subtotal）
  /// Rate plan 解決結果のスナップショット（`RateBreakdown` 型、`src/shared/lib/pricing/rate-breakdown.ts`）。
  /// legacy row（本 migration の backfill 対象）は `{ legacy: true, segments: [], ... }` を持つ
  /// （`isLegacyRateBreakdown` で判定、`receipts/issue.ts` 等は legacy 時のみ totalPrice フォールバックを維持）。
  rateBreakdownJson Json

  // 税情報（予約時点の値を記録）
  taxRateType       TaxRateType // 適用された税率タイプ（NOT NULL、snapshot）
  taxRate           Decimal     @db.Decimal(5, 2) // 適用税率（%）（NOT NULL、snapshot）
  taxAmount         Decimal     @db.Decimal(10, 2) // 税額（NOT NULL）
  totalPriceWithTax Decimal     @db.Decimal(10, 2) // 税込み合計（NOT NULL）
  /// 管理者が計算値を手動上書きした場合の実行者 User.id（audit 目的）。null = 上書きなし。
  priceOverriddenBy String?

  // Google Calendar Sync
  googleCalendarEventId String? // 共有カレンダーのイベントID
  calendarSyncedAt      DateTime? // 最終同期日時
  calendarSyncError     String?   @db.Text // 同期エラーメッセージ

  // Guest contact info (予約時に入力された連絡先 — Customer レコードとは独立に保存)
  guestLastName     String?
  guestFirstName    String?
  guestEmail        String?
  guestPhone        String?
  guestCompanyName  String?
  guestCustomerType CustomerType?

  // Relations
  space              Space               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  coupon             Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  review             SpaceReview?
  smartLockPasscodes SmartLockPasscode[]

  // Soft-delete
  deletedAt   DateTime?
  deletedById String?   @db.Uuid
  deletedBy   User?     @relation("ReservationDeletions", fields: [deletedById], references: [id], onDelete: SetNull)

  // Payment (Stripe)
  paymentStatus           PaymentStatus @default(UNPAID)
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  /// checkout session を開始した (paymentStatus を PENDING に遷移させた) 最終時刻。
  /// fail-safe cron (`/api/cron/pending-reservation-expire`) が
  /// `PENDING_RESERVATION_EXPIRY_MINUTES` の cutoff 判定に使う。予約作成時刻
  /// (createdAt) ではなく checkout 開始時刻で判定することで、予約作成から時間をおいて
  /// 決済を開始したケース (createdAt < cutoff だが checkout はまだ生きている) を誤爆
  /// せず、FAILED → PENDING の再 checkout でも refresh される。
  paymentInitiatedAt      DateTime?

  // Cancellation tracking
  cancellationReason String?   @db.Text
  cancelledAt        DateTime?
  cancelledByType    String?   @db.VarChar(20) // "CUSTOMER" | "CUSTOMER_MYPAGE" | "CUSTOMER_TOKEN" | "ADMIN" (CANCELLED_BY SSoT: src/shared/lib/validations/enums/helpers.ts)

  // iCal RFC 5545 SEQUENCE (increments on update/cancel)
  icsSequence Int @default(0)

  // Reminder cron 冪等性: リマインダーメール送信済み日時（null = 未送信）。
  // 二重送信防止のため送信前に atomic claim で now を立て、送信失敗時は null に戻す。
  reminderSentAt DateTime?

  // PR#16: 領収書 (適格請求書) の 1:1 relation (1 予約 = 1 領収書、再発行は
  // Receipt.reissuedFromId で自参照)
  receipt Receipt?
  // task #9 PR#1: 部分返金の repeatable child records (append-only)
  refunds Refund[]

  @@index([spaceId])
  @@index([customerId])
  @@index([userId])
  @@index([startTime])
  @@index([endTime])
  @@index([status])
  @@index([createdAt])
  @@index([spaceId, startTime, endTime])
  @@index([customerId, startTime])
  @@index([couponId])
  @@index([deletedAt])
  @@index([paymentStatus])
  @@index([stripePaymentIntentId])
  @@map("reservations")
}

model Customer {
  id                     String              @id @default(uuid()) @db.Uuid
  lastName               String
  firstName              String
  lastNameKana           String? // 姓カナ（任意）
  firstNameKana          String? // 名カナ（任意）
  companyName            String? // 会社名・団体名（法人の場合）
  customerType           CustomerType        @default(PERSONAL)
  email                  String
  emailCanonical         String
  phoneNumber            String?
  postalCode             String?             @db.VarChar(8) // 郵便番号 "123-4567" 等
  prefecture             String?             @db.VarChar(10) // 都道府県（PREFECTURES SSoT）
  city                   String?             @db.VarChar(100) // 市区町村
  streetAddress          String?             @db.VarChar(200) // 町名・番地
  building               String?             @db.VarChar(200) // 建物名・部屋番号
  status                 CustomerStatus      @default(NEW)
  notes                  String?             @db.Text
  totalReservations      Int                 @default(0)
  totalSpent             Decimal?            @db.Decimal(10, 2)
  lastReservationAt      DateTime?
  firstReservationAt     DateTime?
  isActive               Boolean             @default(true)
  marketingOptIn         Boolean             @default(false) // メルマガ・キャンペーン受信可否
  phoneContactOptIn      Boolean             @default(true) // 電話連絡可否
  /// Resend Webhook で観測された配信状態。HARD_BOUNCED / COMPLAINED は送信前にスキップ。
  /// 詳細は EmailDeliveryStatus enum 参照。
  emailDeliveryStatus    EmailDeliveryStatus @default(OK)
  emailDeliveryUpdatedAt DateTime?
  /// Resend Webhook payload の bounce.message / suppression reason を保持（人間可読のラベル）。
  emailDeliveryReason    String?             @db.VarChar(500)
  /// 不審検知cron(customer-risk-scan)が検知理由コードを書き込む。手動クリアで null に戻す。
  /// 自動でBLACKLIST化・予約拒否はしない（最終判断は常に管理者、誤検知リスクの回避）。
  flaggedForReviewAt     DateTime?
  flagReasons            String[]            @default([])
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  // Social Auth Link
  userId String? @unique @db.Uuid
  user   User?   @relation("CustomerUser", fields: [userId], references: [id], onDelete: SetNull)

  // Relations
  reservations       Reservation[]
  inquiries          Inquiry[]
  reviews            SpaceReview[]
  eventRegistrations EventRegistration[]
  termsAgreements    TermsAgreement[]

  @@index([lastName])
  @@index([firstName])
  @@index([phoneNumber])
  @@index([status])
  @@index([customerType])
  @@index([emailCanonical])
  @@index([emailCanonical, userId])
  @@index([isActive])
  @@index([lastReservationAt])
  @@index([lastName, firstName])
  @@index([emailDeliveryStatus])
  @@index([flaggedForReviewAt])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' — searchCustomers ORs
  // four columns; all four need trigram or PostgreSQL falls back to Seq Scan
  // on `customers` (per Codex review on PR #986).
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_last_name_trgm_idx")
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_first_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_email_trgm_idx")
  @@index([companyName(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_company_name_trgm_idx")
  @@map("customers")
}

// ==============================================
// Coupon Model (割引クーポン)
// ==============================================

model Coupon {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique // クーポンコード (大文字英数字)
  name        String // 管理用名称
  description String? // 説明

  // 割引設定
  type          CouponType
  discountValue Decimal    @db.Decimal(10, 2) // 割引額 or 割引率

  // 適用条件
  minReservationAmount Decimal? @db.Decimal(10, 2) // 最低利用金額
  maxDiscountAmount    Decimal? @db.Decimal(10, 2) // 最大割引額（パーセント割引時）

  // 有効期限
  validFrom  DateTime
  validUntil DateTime?

  // 利用制限
  usageLimit Int? // 利用回数上限（null=無制限）
  usageCount Int     @default(0) // 利用回数
  isActive   Boolean @default(true)

  // 併用設定
  canCombineWithDurationDiscount Boolean @default(true) // 長時間割引との併用可否

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  reservations Reservation[]

  // @unique が自動的にインデックスを作成するため @@index([code]) は不要
  @@index([validFrom, validUntil])
  @@index([isActive])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' OR-branch coverage
  // (searchCoupons uses `OR: [{ code }, { name }]`; both branches indexed).
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "coupons_code_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "coupons_name_trgm_idx")
  @@map("coupons")
}

model Inquiry {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  companyName  String? // 会社名・団体名（法人の場合）
  customerType CustomerType?
  email        String
  subject      String
  message      String        @db.Text
  status       InquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Reply（管理者からの返信）
  replyMessage String?   @db.Text
  repliedAt    DateTime?
  repliedById  String?   @db.Uuid
  repliedBy    User?     @relation("InquiryReplies", fields: [repliedById], references: [id], onDelete: SetNull)

  // Customer Link（ログインユーザーのお問い合わせ紐づけ）
  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([createdAt, status])
  @@index([customerId])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' — searchInquiries ORs
  // name/email/subject; all three need trigram to avoid Seq Scan fallback.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "inquiries_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "inquiries_email_trgm_idx")
  @@index([subject(ops: raw("gin_trgm_ops"))], type: Gin, map: "inquiries_subject_trgm_idx")
  @@map("inquiries")
}

model News {
  id                 String       @id @default(uuid()) @db.Uuid
  slug               String       @unique
  title              String
  contentHtml        String       @map("content") @db.Text // HTMLキャッシュ（公開表示用）
  contentJson        Json? // Lexical EditorState JSON（プライマリ）
  isPublished        Boolean      @default(false)
  publishedAt        DateTime?
  contentWidth       LayoutWidth?
  contentWidthCustom Int? // CUSTOMの場合の幅（px）
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // SEO設定
  metaDescription String?
  metaKeywords    String?

  // OGP設定
  ogpTitle       String?
  ogpDescription String?
  ogpImageUrl    String?

  // OR検索用インデックス
  @@index([title])
  @@index([isPublished, publishedAt])
  @@index([createdAt])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' — searchNews ORs
  // title/slug; both branches need trigram to avoid Seq Scan fallback.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "news_title_trgm_idx")
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "news_slug_trgm_idx")
  @@map("news")
}

model AnnouncementBar {
  id           String    @id @default(uuid()) @db.Uuid
  /// Sanity Portable Text 互換の inline span 配列。`{_key,_type:"span",text}` と
  /// `{_key,_type:"iconInline",name}` の discriminated union を順次配置する。
  message      Json      @default("[]")
  linkUrl      String?
  linkText     String?
  bgColor      String? // カスタム背景色 (hex)
  textColor    String? // カスタム文字色 (hex)
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  startAt      DateTime?
  endAt        DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([displayOrder], map: "announcement_bars_displayOrder_key")
  @@index([isActive, displayOrder])
  @@index([startAt, endAt])
  @@map("announcement_bars")
}

// ==============================================
// Post Models
// ==============================================

model Post {
  id                 String       @id @default(uuid()) @db.Uuid
  title              String
  slug               String       @unique
  excerpt            String       @db.Text
  contentHtml        String       @map("content") @db.Text // HTMLキャッシュ（公開表示用）
  contentJson        Json? // Lexical EditorState JSON（プライマリ）
  thumbnailUrl       String
  ogpImageUrl        String?
  categoryId         String       @db.Uuid
  metaDescription    String?
  metaKeywords       String?
  ogpTitle           String?
  ogpDescription     String?
  publishedAt        DateTime?
  status             PostStatus   @default(DRAFT)
  authorId           String?      @db.Uuid // ユーザー削除時にnull化
  contentWidth       LayoutWidth?
  contentWidthCustom Int? // CUSTOMの場合の幅（px）
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relations
  category PostCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author   User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  postTags PostTagOnPost[]

  // OR検索用インデックス
  @@index([title])
  @@index([authorId])
  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' — searchPosts ORs
  // title/slug; both branches need trigram to avoid Seq Scan fallback.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "posts_title_trgm_idx")
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "posts_slug_trgm_idx")
  @@map("posts")
}

/// Post ↔ PostTag 中間テーブル（JSON配列からの正規化）
model PostTagOnPost {
  postId String  @db.Uuid
  tagId  String  @db.Uuid
  post   Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    PostTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tag_on_posts")
}

model PostCategory {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  slug            String   @unique
  description     String?  @db.Text
  metaTitle       String?
  metaDescription String?  @db.Text
  ogpImageUrl     String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  posts Post[]

  @@unique([order], map: "post_categories_order_key")
  @@index([order])
  @@map("post_categories")
}

model PostTag {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
