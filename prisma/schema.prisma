// =============================================================================
// 監査ログ
// =============================================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  EXPORT
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PERMISSION_DENIED
  PASSWORD_CHANGE
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_FAILED
  ROLE_CHANGE
  INTEGRITY_CHECK
}

enum EditorCommentStatus {
  ACTIVE // アクティブ（未解決）
  RESOLVED // 解決済み
  DELETED // 削除済み（ソフトデリート）
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

enum MediaUsage {
  POST
  NEWS
  PAGE
  SPACE
  EVENT
  SITE
  GENERAL
}

/// 監査ログ（書き込み操作 + セキュリティイベント）
model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  sequence      BigInt      @unique
  previousHash  String      @db.Char(64)
  entryHash     String      @db.Char(64)
  hashAlgorithm String      @default("HMAC-SHA256") @db.VarChar(32)
  hashKeyId     String      @default("v1") @db.VarChar(32)
  chainVersion  Int         @default(1)
  userId        String?     @db.Uuid // 実行ユーザー（null = システム or 未認証）
  action        AuditAction // 操作種別
  resource      String // 対象リソース種別 ('space', 'blog' 等)
  resourceId    String? // 対象リソースID
  oldValue      Json? // 変更前の値（UPDATE時）
  newValue      Json? // 変更後の値 or 作成値
  metadata      Json? // 追加情報（IPアドレス、UserAgent等）
  createdAt     DateTime    @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([hashKeyId, sequence])
  @@map("audit_logs")
}

// =============================================================================
// メディア管理
// =============================================================================

/// メディアファイル管理
model Media {
  id          String @id @default(uuid()) @db.Uuid
  filename    String // 元のファイル名
  storagePath String // Cloudflare R2 オブジェクトキー（`{prefix}/{folder}/{timestamp}-{uuid}.{ext}`）
  url         String // 公開URL
  bucket      String // ストレージ prefix（`STORAGE_PREFIXES` の 4 値: `spaces` / `posts` / `site` / `media`）
  mimeType    String // MIME type
  size        Int // ファイルサイズ（bytes）
  width       Int? // 画像幅（px）
  height      Int? // 画像高さ（px）

  // 分類・検索用
  type        MediaType // メディア種別
  usage       MediaUsage @default(GENERAL) // 用途
  alt         String? // 代替テキスト
  title       String? // タイトル
  description String?    @db.Text // 説明
  tags        Json       @default("[]") // タグ配列

  // 管理情報
  uploadedBy String?  @db.Uuid // アップロードユーザーID（User削除時にnull化）
  isActive   Boolean  @default(true) // ソフトデリート
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  uploader User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([type, usage])
  @@index([uploadedBy])
  @@index([isActive, createdAt])
  @@index([mimeType])
  @@map("media")
}

