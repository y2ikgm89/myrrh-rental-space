// ==============================================
// Myrrh Rental Space - Prisma Schema
// ==============================================
// Prisma 7 + PostgreSQL 16

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  engineType = "client"
  runtime = "bun"
}

datasource db {
  provider = "postgresql"
}

// ==============================================
// Enums
// ==============================================

enum Role {
  SUPER_ADMIN // 全権限（システム設定、ユーザー管理、監査ログ）
  ADMIN // コンテンツ管理全般
  EDITOR // 割り当てページ編集のみ
  VIEWER // 閲覧のみ
  USER // 公開ユーザー（非管理者）
  CUSTOMER // 顧客（ソーシャルログイン）
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CustomerType {
  PERSONAL
  CORPORATE
}

enum CustomerStatus {
  NEW
  REGULAR
  VIP
  INACTIVE
  BLACKLIST
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum NavigationType {
  HEADER_DESKTOP // デスクトップ用ヘッダーメニュー
  HEADER_MOBILE // モバイル用ヘッダーメニュー
  FOOTER // フッターメニュー
}

enum SocialPlatform {
  TWITTER
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  LINE
  TIKTOK
  OTHER
}

enum LayoutWidth {
  XS
  SM
  MD
  LG
  XL
  FULL
  CUSTOM
}


enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CouponType {
  PERCENTAGE // パーセント割引 (例: 20%)
  FIXED_AMOUNT // 定額割引 (例: ¥1,000)
}

// --- 新規 Enum（String → Enum 変換） ---

enum AnnouncementBarType {
  info
  warning
  promo
}

enum DiscountType {
  none
  percentage
  fixed
}

enum DurationDiscountOverride {
  inherit
  enabled
  disabled
}

enum TaxRateType {
  standard
  reduced
}

// @map required: hyphens in DB values
enum HeaderScrollBehavior {
  auto_hide      @map("auto-hide")
  always_visible @map("always-visible")
  hide_on_scroll @map("hide-on-scroll")
}

enum HeaderBackgroundMode {
  solid       @map("solid")
  transparent @map("transparent")
}

enum TaxDisplayMode {
  tax_excluded
  tax_included
  both
}

enum TaxInputMode {
  tax_excluded
  tax_included
}

enum CalendarSyncMethod {
  polling
  webhook
  both
}

enum AnalyticsType {
  ga4
  gtm
}

enum DiscountCombinationMode {
  best
  both
}

// @map required: hyphens in DB values
enum PostPermalinkStructure {
  post_name     @map("post-name")
  date_name     @map("date-name")
  category_name @map("category-name")
}

enum AnnouncementBarAnimation {
  fade
  slideX
  slideY
}

enum AnnouncementBarDesignStyle {
  solid
  gradient
  outlined
  glass
  minimal
  striped
}

enum InstagramFeedLayout {
  grid
  masonry
  slider
}

enum InstagramMediaType {
  IMAGE
  VIDEO
  CAROUSEL_ALBUM
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
}

// ==============================================
// Better Auth Models
// ==============================================

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  accounts        Account[]
  sessions        Session[]
  reservations    Reservation[]
  posts           Post[]
  postComments    PostComment[]
  icalTokens      ICalToken[]
  auditLogs       AuditLog[]
  mediaFiles      Media[]
  customer        Customer?          @relation("CustomerUser")

  // RBAC: EDITOR用の割り当てページ（中間テーブル）
  pageAssignments UserPageAssignment[]

  // FK: createdBy / resolvedBy / deletedBy リレーション
  createdNewsVersions     NewsVersion[]          @relation("NewsVersionCreator")
  createdPostVersions     PostVersion[]          @relation("PostVersionCreator")
  createdCommentThreads   EditorCommentThread[]  @relation("CommentThreadCreator")
  resolvedCommentThreads  EditorCommentThread[]  @relation("CommentThreadResolver")
  createdEditorComments   EditorComment[]        @relation("EditorCommentCreator")
  deletedEditorComments   EditorComment[]        @relation("EditorCommentDeleter")
  deletedPostComments     PostComment[]          @relation("PostCommentDeleter")
  inquiryReplies          Inquiry[]              @relation("InquiryReplies")
  reservationDeletions    Reservation[]          @relation("ReservationDeletions")
  eventDeletions          Event[]                @relation("EventDeletions")
  createdStaffInvitations StaffInvitation[]      @relation("StaffInvitationCreator")
  createdLoginTokens      LoginToken[]           @relation("LoginTokenCreator")
  createdBlockTemplates   BlockTemplate[]        @relation("BlockTemplateCreator")
  repliedSpaceReviews     SpaceReview[]          @relation("SpaceReviewReplyAuthor")

  // OR検索用インデックス
  @@index([name])
  @@map("user")
}

/// EDITOR用のページ割り当て（中間テーブル）
model UserPageAssignment {
  userId String @db.Uuid
  pageId String @db.Uuid
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([userId, pageId])
  @@index([pageId])
  @@map("user_page_assignments")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  accountId             String // Better Auth: ユーザーID or プロバイダーのアカウントID
  providerId            String // Better Auth: "credential" or "google" etc.
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // Better Auth: credential provider のパスワード（scrypt hash）
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId String @db.Uuid
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model LoginToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  createdBy String? @db.Uuid // 作成者ID（User.id）- ユーザー削除時にnull化
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  // Relations
  creator User? @relation("LoginTokenCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  // @unique が自動的にインデックスを作成するため @@index([token]) は不要
  @@index([expiresAt])
  @@index([usedAt])
  @@map("login_tokens")
}

model StaffInvitation {
  id        String    @id @default(uuid()) @db.Uuid
  email     String
  token     String    @unique
  role      Role      @default(USER)
  name      String? // オプションで名前を指定
  usedAt    DateTime? // 使用済み = パスワード設定完了
  expiresAt DateTime
  createdAt DateTime  @default(now())
  createdBy String? @db.Uuid // 作成者ID（User.id）- ユーザー削除時にnull化

  // Relations
  creator User? @relation("StaffInvitationCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  // @unique が自動的にインデックスを作成するため @@index([token]) は不要
  @@index([email])
  @@index([expiresAt])
  @@map("staff_invitations")
}

// ==============================================
// Business Models
// ==============================================

model Location {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique @db.VarChar(255)
  name            String   @unique
  description     String?  @db.Text
  address         String
  postalCode      String?
  prefecture      String?
  city            String?
  streetAddress   String?
  buildingName    String?
  /// 交通案内（最寄り駅・路線・徒歩分数等）。1 行 = 1 経路の構造化配列。
  /// 旧 access String 列（改行区切り）を 2026-05-01 に Json 配列化（破壊的変更）。
  accessLines     Json     @default("[]")
  parkingInfo     String?  @db.Text
  amenities       Json     @default("{}")
  imageUrl        String
  imageUrls       Json     @default("[]")
  businessHours   Json?
  specialHolidays Json?

  // MEO（Local SEO）— Settings から移管
  latitude              Float?
  longitude             Float?
  googleBusinessPlaceId String?
  googleReviewUrl       String?
  priceRange            String?  @db.VarChar(100)
  paymentAccepted       String?
  phoneNumber           String?
  email                 String?

  sortOrder       Int      @default(0)
  isPublished     Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  spaces Space[]
  events Event[]

  @@index([isPublished, isActive])
  @@index([sortOrder])
  @@map("locations")
}

model SpaceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique // 例: 会議室、スタジオ、セミナー室（seed idempotency 保証）
  description String?  @db.Text
  icon        String? // アイコン名（任意）
  color       String? // テーマカラー（任意）
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  spaces Space[]

  @@index([sortOrder])
  @@map("space_categories")
}

model Space {
  id            String    @id @default(uuid()) @db.Uuid
  slug          String    @unique
  name          String
  /// Lexical EditorState JSON（正本）
  descriptionJson      Json
  /// Lexical → 公開表示用 HTML キャッシュ（SanitizedHtml で出力）
  descriptionHtml      String   @db.Text
  /// SEO description / カード要約 / メタデータ用プレーンテキスト派生
  descriptionPlainText String   @db.Text
  /// 号室・フロア等。建物の住所は必ず `Location.address` を正本とする。
  /// 主要交通案内・駐車場情報は親 Location（accessLines / parkingInfo）が SSoT。
  addressDetail String?   @db.Text
  capacity      Int
  area          Decimal?  @db.Decimal(10, 2)
  hourlyPrice   Decimal   @db.Decimal(10, 2)
  dailyPrice    Decimal?  @db.Decimal(10, 2)
  mainImageUrl  String
  imageUrls     Json      @default("[]")
  facilities    Json      @default("[]")
  businessHours Json?
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  isActive      Boolean   @default(true)
  /// レビュー機能の per-space ON/OFF。false の場合は公開ページで非表示 + 投稿不可。
  /// 新規スペースはデフォルト false（opt-in）。`Settings.reviewsEnabledGlobal` が上位 gate。
  reviewsEnabled Boolean  @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // SEO設定
  metaDescription String?
  metaKeywords    String?

  // OGP設定
  ogpTitle       String?
  ogpDescription String?
  ogpImageUrl    String?

  // 割引設定（Enum化）
  discountType             DiscountType             @default(none)
  discountValue            Decimal?                 @db.Decimal(10, 2)
  durationDiscountOverride DurationDiscountOverride  @default(inherit)

  // 税率設定（Enum化）
  taxRateType TaxRateType @default(standard)

  // 場所・カテゴリー設定（拠点は必須。カテゴリーは任意）
  locationId String @db.Uuid
  categoryId String? @db.Uuid

  // Relations
  reservations Reservation[]
  icalTokens   ICalToken[]
  reviews      SpaceReview[]
  events       Event[]
  location     Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  category     SpaceCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // OR検索用インデックス
  @@index([name])
  @@index([addressDetail])
  @@index([isPublished, isActive])
  @@index([publishedAt, isActive])
  @@index([locationId])
  @@index([categoryId])
  @@map("spaces")
}

model Reservation {
  id            String            @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  userId String? @db.Uuid
  customerId String @db.Uuid
  startTime     DateTime
  endTime       DateTime
  status        ReservationStatus @default(PENDING)
  totalPrice    Decimal?          @db.Decimal(10, 2)
  notes         String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // 割引情報
  couponId String? @db.Uuid // 適用されたクーポンID
  couponDiscountAmount   Decimal? @db.Decimal(10, 2) // クーポン割引額
  durationDiscountAmount Decimal? @db.Decimal(10, 2) // 長時間割引額
  spaceDiscountAmount    Decimal? @db.Decimal(10, 2) // スペース固有割引額
  basePrice              Decimal? @db.Decimal(10, 2) // 割引前価格（記録用）

  // 税情報（予約時点の値を記録）
  taxRateType       TaxRateType? // 適用された税率タイプ
  taxRate           Decimal? @db.Decimal(5, 2) // 適用税率（%）
  taxAmount         Decimal? @db.Decimal(10, 2) // 税額
  totalPriceWithTax Decimal? @db.Decimal(10, 2) // 税込み合計

  // Google Calendar Sync
  googleCalendarEventId      String? // 共有カレンダーのイベントID
  googleCalendarOAuthEventId String? // OAuth連携（管理者個人）のイベントID
  calendarSyncedAt           DateTime? // 最終同期日時
  calendarSyncError          String?   @db.Text // 同期エラーメッセージ

  // Guest contact info (予約時に入力された連絡先 — Customer レコードとは独立に保存)
  guestLastName    String?
  guestFirstName   String?
  guestPhone       String?
  guestCompanyName    String?
  guestCustomerType   CustomerType?

  // Relations
  space           Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  coupon          Coupon?          @relation(fields: [couponId], references: [id], onDelete: SetNull)
  review          SpaceReview?

  // Soft-delete
  deletedAt    DateTime?
  deletedById  String?   @db.Uuid
  deletedBy    User?     @relation("ReservationDeletions", fields: [deletedById], references: [id], onDelete: SetNull)

  // Payment (Stripe)
  paymentStatus           PaymentStatus @default(UNPAID)
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime?

  // Cancellation tracking
  cancellationReason String?  @db.Text
  cancelledAt        DateTime?
  cancelledByType    String?  @db.VarChar(20) // "CUSTOMER" | "ADMIN"

  // iCal RFC 5545 SEQUENCE (increments on update/cancel)
  icsSequence Int @default(0)

  @@index([spaceId])
  @@index([customerId])
  @@index([userId])
  @@index([startTime])
  @@index([endTime])
  @@index([status])
  @@index([createdAt])
  @@index([spaceId, startTime, endTime])
  @@index([customerId, startTime])
  @@index([couponId])
  @@index([deletedAt])
  @@index([paymentStatus])
  @@index([stripePaymentIntentId])
  @@map("reservations")
}

model Customer {
  id                 String         @id @default(uuid()) @db.Uuid
  lastName           String
  firstName          String
  lastNameKana       String?        // 姓カナ（任意）
  firstNameKana      String?        // 名カナ（任意）
  companyName        String?        // 会社名・団体名（法人の場合）
  customerType       CustomerType   @default(PERSONAL)
  email              String         @unique
  phoneNumber        String?
  postalCode         String?        @db.VarChar(8)   // 郵便番号 "123-4567" 等
  prefecture         String?        @db.VarChar(10)  // 都道府県（PREFECTURES SSoT）
  city               String?        @db.VarChar(100) // 市区町村
  streetAddress      String?        @db.VarChar(200) // 町名・番地
  building           String?        @db.VarChar(200) // 建物名・部屋番号
  status             CustomerStatus @default(NEW)
  notes              String?        @db.Text
  totalReservations  Int            @default(0)
  totalSpent         Decimal?       @db.Decimal(10, 2)
  lastReservationAt  DateTime?
  firstReservationAt DateTime?
  isActive           Boolean        @default(true)
  marketingOptIn     Boolean        @default(false)  // メルマガ・キャンペーン受信可否
  phoneContactOptIn  Boolean        @default(true)   // 電話連絡可否
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Social Auth Link
  userId  String? @unique @db.Uuid
  user    User?   @relation("CustomerUser", fields: [userId], references: [id], onDelete: SetNull)

  // Relations
  reservations Reservation[]
  inquiries    Inquiry[]
  reviews              SpaceReview[]
  eventRegistrations   EventRegistration[]
  termsAgreements      TermsAgreement[]

  @@index([lastName])
  @@index([firstName])
  @@index([phoneNumber])
  @@index([status])
  @@index([customerType])
  @@index([isActive])
  @@index([lastReservationAt])
  @@index([lastName, firstName])
  @@index([userId])
  @@map("customers")
}

// ==============================================
// Coupon Model (割引クーポン)
// ==============================================

model Coupon {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique // クーポンコード (大文字英数字)
  name        String // 管理用名称
  description String? // 説明

  // 割引設定
  type          CouponType
  discountValue Decimal    @db.Decimal(10, 2) // 割引額 or 割引率

  // 適用条件
  minReservationAmount Decimal? @db.Decimal(10, 2) // 最低利用金額
  maxDiscountAmount    Decimal? @db.Decimal(10, 2) // 最大割引額（パーセント割引時）

  // 有効期限
  validFrom  DateTime
  validUntil DateTime?

  // 利用制限
  usageLimit Int? // 利用回数上限（null=無制限）
  usageCount Int     @default(0) // 利用回数
  isActive   Boolean @default(true)

  // 併用設定
  canCombineWithDurationDiscount Boolean @default(true) // 長時間割引との併用可否

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  reservations Reservation[]

  // @unique が自動的にインデックスを作成するため @@index([code]) は不要
  @@index([validFrom, validUntil])
  @@index([isActive])
  @@map("coupons")
}

model Inquiry {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  companyName  String?       // 会社名・団体名（法人の場合）
  customerType CustomerType?
  email        String
  subject      String
  message      String        @db.Text
  status       InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Reply（管理者からの返信）
  replyMessage String?   @db.Text
  repliedAt    DateTime?
  repliedById  String?   @db.Uuid
  repliedBy    User?     @relation("InquiryReplies", fields: [repliedById], references: [id], onDelete: SetNull)

  // Customer Link（ログインユーザーのお問い合わせ紐づけ）
  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([createdAt, status])
  @@index([customerId])
  @@map("inquiries")
}

model News {
  id                 String       @id @default(uuid()) @db.Uuid
  slug               String       @unique
  title              String
  contentHtml        String       @db.Text @map("content") // HTMLキャッシュ（公開表示用）
  contentJson        Json? // Lexical EditorState JSON（プライマリ）
  isPublished        Boolean      @default(false)
  publishedAt        DateTime?
  contentWidth       LayoutWidth?
  contentWidthCustom Int? // CUSTOMの場合の幅（px）
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // SEO設定
  metaDescription String?
  metaKeywords    String?

  // OGP設定
  ogpTitle       String?
  ogpDescription String?
  ogpImageUrl    String?

  // Relations
  versions NewsVersion[]

  // OR検索用インデックス
  @@index([title])
  @@index([isPublished, publishedAt])
  @@index([createdAt])
  @@map("news")
}

/// Newsのバージョン履歴
model NewsVersion {
  id          String   @id @default(uuid()) @db.Uuid
  newsId String @db.Uuid
  version     Int // 自動インクリメント（News内でユニーク）
  contentHtml String   @db.Text @map("content") // HTMLスナップショット
  contentJson Json? // Lexical EditorState JSON
  createdAt   DateTime @default(now())
  createdBy String? @db.Uuid // 作成者ID（User.id）- ユーザー削除時にnull化

  // Relations
  news    News  @relation(fields: [newsId], references: [id], onDelete: Cascade)
  creator User? @relation("NewsVersionCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([newsId, version])
  @@index([newsId, createdAt])
  @@map("news_versions")
}

model AnnouncementBar {
  id        String              @id @default(uuid()) @db.Uuid
  message   String              @db.VarChar(200)
  type      AnnouncementBarType @default(info)
  linkUrl   String?
  linkText  String?
  bgColor   String? // カスタム背景色 (hex)
  textColor String? // カスタム文字色 (hex)
  isActive  Boolean             @default(true)
  priority  Int                 @default(0)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([isActive, priority])
  @@index([startAt, endAt])
  @@map("announcement_bars")
}

// ==============================================
// Post Models
// ==============================================

model Post {
  id                 String      @id @default(uuid()) @db.Uuid
  title              String
  slug               String      @unique
  excerpt            String      @db.Text
  contentHtml        String      @db.Text @map("content") // HTMLキャッシュ（公開表示用）
  contentJson        Json? // Lexical EditorState JSON（プライマリ）
  thumbnailUrl       String
  ogpImageUrl        String?
  categoryId String @db.Uuid
  metaDescription    String?
  metaKeywords       String?
  ogpTitle           String?
  ogpDescription     String?
  publishedAt        DateTime?
  status             PostStatus  @default(DRAFT)
  authorId String? @db.Uuid // ユーザー削除時にnull化
  viewCount          Int         @default(0)
  contentWidth       LayoutWidth?
  contentWidthCustom Int? // CUSTOMの場合の幅（px）
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Relations
  category PostCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author   User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  comments PostComment[]
  versions PostVersion[]
  postTags PostTagOnPost[]

  // OR検索用インデックス
  @@index([title])
  @@index([authorId])
  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([viewCount])
  @@map("posts")
}

/// Post ↔ PostTag 中間テーブル（JSON配列からの正規化）
model PostTagOnPost {
  postId String @db.Uuid
  tagId String @db.Uuid
  post   Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    PostTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tag_on_posts")
}

/// Postのバージョン履歴
model PostVersion {
  id          String   @id @default(uuid()) @db.Uuid
  postId String @db.Uuid
  version     Int // 自動インクリメント（Post内でユニーク）
  contentHtml String   @db.Text @map("content") // HTMLスナップショット
  contentJson Json? // Lexical EditorState JSON
  createdAt   DateTime @default(now())
  createdBy String? @db.Uuid // 作成者ID（User.id）- ユーザー削除時にnull化

  // Relations
  post    Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  creator User? @relation("PostVersionCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([postId, version])
  @@index([postId, createdAt])
  @@map("post_versions")
}

model PostCategory {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  slug            String   @unique
  description     String?  @db.Text
  metaTitle       String?
  metaDescription String?  @db.Text
  ogpImageUrl     String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  posts Post[]

  @@index([order])
  @@map("post_categories")
}

model PostTag {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  slug            String   @unique
  description     String?  @db.Text
  metaTitle       String?
  metaDescription String?  @db.Text
  ogpImageUrl     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  posts PostTagOnPost[]

  @@map("post_tags")
}

model PostComment {
  id              String  @id @default(uuid()) @db.Uuid
  postId String @db.Uuid
  parentCommentId String? @db.Uuid // Self-reference for nested comments

  // Content
  content String @db.Text

  // Author info (either userId OR guest info)
  userId String? @db.Uuid // For logged-in users
  guestName  String? // For guest comments
  guestEmail String? // For guest comments

  // Spam prevention metadata
  ipAddress   String? // For rate limiting (hashed)
  contentHash String? // For duplicate detection

  // Status
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String? @db.Uuid // userId of admin who deleted

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  post          Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  deleter       User?        @relation("PostCommentDeleter", fields: [deletedBy], references: [id], onDelete: SetNull)
  parentComment PostComment? @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       PostComment[] @relation("CommentReplies")

  // Indexes
  @@index([postId, createdAt])
  @@index([parentCommentId])
  @@index([userId])
  @@index([ipAddress, createdAt])
  @@index([guestEmail, createdAt])
  @@index([contentHash])
  @@index([isDeleted])
  @@index([isDeleted, createdAt(sort: Desc)]) // Admin search optimization
  @@map("post_comments")
}

// ==============================================
// CMS Models
// ==============================================

model Page {
  id                 String       @id @default(uuid()) @db.Uuid
  slug               String       @unique
  title              String
  description        String?      @db.Text
  metaDescription    String?
  metaKeywords       String?
  ogpTitle           String?
  ogpDescription     String?
  ogpImageUrl        String?
  isPublished        Boolean      @default(true)
  publishedAt        DateTime?
  isActive           Boolean      @default(true)
  isSystemPage       Boolean      @default(false) // システムページ（SEO/OGPのみ編集可、コンテンツ編集不可）
  template           String       @db.VarChar(64)
  contentWidth       LayoutWidth?
  contentWidthCustom Int? // CUSTOMの場合の幅（px）
  showSidebar        Boolean? // null=デフォルト使用、true/false=明示的指定
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relations
  sections         Section[]
  assignments      UserPageAssignment[]

  @@index([isPublished, isActive])
  @@index([isSystemPage])
  @@map("pages")
}

/// 統一セクション（ホームページ + カスタムページ共通）
/// pageId = null でホームページセクション判別
model Section {
  id          String      @id @default(uuid()) @db.Uuid
  pageId String? @db.Uuid // null = ホームページ
  type        String      @db.VarChar(64)
  order       Int         @default(0) // 表示順序（DnDで変更可能）
  isActive    Boolean     @default(true) // ON/OFF制御
  title       String? // セクション見出し（表示用）
  contentHtml String?     @db.Text @map("content") // HTMLキャッシュ（CUSTOM等で使用）
  contentJson Json? // Lexical EditorState JSON（プライマリ）
  config      Json        @default("{}") // タイプ別設定（Zodで型安全）
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relations
  page  Page?          @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order, isActive])
  @@index([type])
  @@map("sections")
}

model NavigationItem {
  id         String         @id @default(uuid()) @db.Uuid
  type       NavigationType
  parentId String? @db.Uuid
  label      String
  url        String
  isExternal Boolean        @default(false)
  order      Int
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Self-relation for submenus
  parent   NavigationItem?  @relation("NavigationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavigationHierarchy")

  @@index([type, order])
  @@index([parentId])
  @@map("navigation_items")
}

model SocialLink {
  id            String         @id @default(uuid()) @db.Uuid
  platform      SocialPlatform
  url           String
  order         Int
  isActive      Boolean        @default(true)
  showOnDesktop Boolean        @default(true) // デスクトップで表示
  showOnMobile  Boolean        @default(true) // モバイルで表示
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([order])
  @@map("social_links")
}

// ==============================================
// FAQ Models
// ==============================================

model FaqCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?   @db.Text
  iconEmoji   String?   @db.VarChar(8)
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  items FaqItem[]

  @@index([order])
  @@index([isActive, order])
  @@index([deletedAt])
  @@map("faq_categories")
}

model FaqItem {
  id              String    @id @default(uuid()) @db.Uuid
  categoryId      String    @db.Uuid
  question        String
  answer          String    @db.Text // 回答（プレーンテキスト、改行保持）
  order           Int       @default(0)
  isPublished     Boolean   @default(true)
  publishedAt     DateTime?
  deletedAt       DateTime?
  viewCount       Int       @default(0) // 公開ページでの閲覧回数（集計値、localStorage で dedup）
  lastViewedAt    DateTime? // 直近閲覧日時（人気度の新鮮度判断用）
  helpfulCount    Int       @default(0) // 「役に立った」投票数（localStorage で dedup）
  notHelpfulCount Int       @default(0) // 「役に立たなかった」投票数（localStorage で dedup）
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  category FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, order])
  @@index([categoryId, isPublished, order])
  @@index([isPublished])
  @@index([deletedAt])
  @@index([updatedAt])
  @@index([viewCount])
  @@map("faq_items")
}

// ==============================================
