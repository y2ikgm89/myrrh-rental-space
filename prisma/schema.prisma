/// メディアファイル管理
model Media {
  id          String @id @default(uuid(7)) @db.Uuid
  filename    String // 元のファイル名
  storagePath String @map("storage_path") // Cloudflare R2 オブジェクトキー（`{prefix}/{folder}/{timestamp}-{uuid}.{ext}`）
  url         String // 公開URL
  bucket      String // ストレージ prefix（`STORAGE_PREFIXES` の 4 値: `spaces` / `posts` / `site` / `media`）
  mimeType    String @map("mime_type") // MIME type
  size        Int // ファイルサイズ（bytes）
  width       Int? // 画像幅（px）
  height      Int? // 画像高さ（px）

  // 分類・検索用
  type        MediaType // メディア種別
  usage       MediaUsage @default(GENERAL) // 用途
  alt         String? // 代替テキスト
  title       String? // タイトル
  description String?    @db.Text // 説明
  tags        Json       @default("[]") // タグ配列

  // 管理情報
  uploadedBy String?  @map("uploaded_by") @db.Uuid // アップロードユーザーID（User削除時にnull化）
  isActive   Boolean  @default(true) @map("is_active") // ソフトデリート
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
