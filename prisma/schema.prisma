// ==============================================
// Myrrh Rental Space - Prisma Schema
// ==============================================
// Prisma 7 + PostgreSQL 16

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  runtime         = "bun"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ==============================================
// Enums
// ==============================================

enum Role {
  SUPER_ADMIN // 全権限（システム設定、ユーザー管理、監査ログ）
  ADMIN // コンテンツ管理全般
  EDITOR // 割り当てページ編集のみ
  VIEWER // 閲覧のみ
  USER // 公開ユーザー（非管理者）
  CUSTOMER // 顧客（ソーシャルログイン）

  @@map("role")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("reservation_status")
}

enum ReservationSeriesFreq {
  DAILY
  WEEKLY
  MONTHLY

  @@map("reservation_series_freq")
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
  FLAGGED
  SPAM

  @@map("inquiry_status")
}

enum InquiryReplyAuthorType {
  STAFF
  CUSTOMER

  @@map("inquiry_reply_author_type")
}

enum CustomerType {
  PERSONAL
  CORPORATE

  @@map("customer_type")
}

enum CustomerStatus {
  NEW
  REGULAR
  VIP
  INACTIVE
  BLACKLIST

  @@map("customer_status")
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED

  @@map("payment_status")
}

enum NavigationType {
  HEADER_DESKTOP // デスクトップ用ヘッダーメニュー
  HEADER_MOBILE // モバイル用ヘッダーメニュー
  FOOTER // フッターメニュー

  @@map("navigation_type")
}

enum SocialPlatform {
  TWITTER
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  LINE
  TIKTOK
  OTHER

  @@map("social_platform")
}

enum LayoutWidth {
  XS
  SM
  MD
  LG
  XL
  FULL
  CUSTOM

  @@map("layout_width")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("post_status")
}

enum CouponType {
  PERCENTAGE // パーセント割引 (例: 20%)
  FIXED_AMOUNT // 定額割引 (例: ¥1,000)

  @@map("coupon_type")
}

// --- 新規 Enum（String → Enum 変換） ---

enum DiscountType {
  NONE
  PERCENTAGE
  FIXED

  @@map("discount_type")
}

enum DurationDiscountOverride {
  INHERIT
  ENABLED
  DISABLED

  @@map("duration_discount_override")
}

enum TaxRateType {
  STANDARD
  REDUCED

  @@map("tax_rate_type")
}

// @map required: hyphens in DB values
enum HeaderScrollBehavior {
  AUTO_HIDE
  ALWAYS_VISIBLE
  HIDE_ON_SCROLL

  @@map("header_scroll_behavior")
}

enum HeaderBackgroundMode {
  SOLID
  TRANSPARENT

  @@map("header_background_mode")
}

enum TaxDisplayMode {
  TAX_EXCLUDED
  TAX_INCLUDED
  BOTH

  @@map("tax_display_mode")
}

enum CalendarSyncMethod {
  POLLING
  WEBHOOK
  BOTH

  @@map("calendar_sync_method")
}

/// 外部サービスとの接続状態。6 つの設定表が同じ値域を持つ。
///
/// 以前は各表に `*_connection_status_check` という手書き CHECK を 6 本置いて
/// `'connected' | 'error'` を強制していた。同じ値域を 6 箇所で書くと、1 箇所だけ
/// 値を足したときに気づけない。型 1 つに集約する。
enum ConnectionStatus {
  CONNECTED
  ERROR

  @@map("connection_status")
}

/// 臨時休業の適用範囲。**宣言順が cascade の優先順位そのもの**。
///
/// `availability.ts` は `orderBy: { scope: "asc" }` で最優先の理由を採る。
/// PostgreSQL の enum は**宣言順**でソートされるので、この並びを変えると
/// 全社休業日よりスペース単位の休業が優先される — 顧客には「休業にしたのに
/// 別の理由が出る」形で現れる。順序は
/// `__tests__/integration/domain/blocked-dates/cascade-priority.test.ts` が
/// 実 DB に行を入れて検査する。
enum BlockedDateScope {
  GLOBAL
  LOCATION
  SPACE

  @@map("blocked_date_scope")
}

/// 臨時休業の理由区分。
///
/// 以前は VARCHAR で **DB 側に制約が 1 つも無かった**（TS の型ガードだけ）。
/// 生 SQL・seed・将来の直接書込が通れば任意の値が入る状態だった。
enum BlockedDateType {
  HOLIDAY
  MAINTENANCE
  EMERGENCY
  OTHER

  @@map("blocked_date_type")
}

/// 返金を発生させた主体。会計証跡（append-only な refunds）の一部。
///
/// 以前は VARCHAR + 手書き CHECK（`refunds_refunded_by_type_check`）で値域を
/// 強制していた。型 1 つに寄せて CHECK を落とす。
enum RefundedByType {
  ADMIN
  AUTO_ON_CANCEL
  AUTO_CAPACITY_RACE
  AUTO_AMOUNT_MISMATCH
  STRIPE_DASHBOARD

  @@map("refunded_by_type")
}

/// 振込先の口座種別。顧客が振込先として見る値。
///
/// 以前は VARCHAR で **DB 側に制約が 1 つも無かった**。
enum TransferAccountType {
  ORDINARY
  CURRENT
  SAVINGS

  @@map("transfer_account_type")
}

enum AnalyticsType {
  GA4
  GTM

  @@map("analytics_type")
}

enum DiscountCombinationMode {
  BEST
  BOTH

  @@map("discount_combination_mode")
}

enum AnnouncementBarAnimation {
  FADE
  SLIDE_X
  SLIDE_Y

  @@map("announcement_bar_animation")
}

enum AnnouncementBarDesignStyle {
  SOLID
  GRADIENT
  OUTLINED
  GLASS
  MINIMAL
  STRIPED

  @@map("announcement_bar_design_style")
}

enum InstagramMediaType {
  IMAGE
  VIDEO
  CAROUSEL_ALBUM

  @@map("instagram_media_type")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED

  @@map("event_status")
}

enum EventScheduleMode {
  /// 単一開催。DB 上は EventTimeSlot 1 件だけを持つ。
  SINGLE_OCCURRENCE
  /// 日時選択制。公開申込で複数の EventTimeSlot から選ばせる。
  TIMED_ENTRY

  @@map("event_schedule_mode")
}

/// オンライン開催対応 (Phase B.1)。schema.org eventAttendanceMode に対応。
enum EventFormat {
  /// schema.org OfflineEventAttendanceMode
  OFFLINE
  /// schema.org OnlineEventAttendanceMode
  ONLINE
  /// schema.org MixedEventAttendanceMode
  HYBRID

  @@map("event_format")
}

/// Event.meetingUrl の発行元 (Phase B.1)。
enum MeetingProvider {
  /// 管理者手入力の URL (Zoom / Teams / Whereby / 独自 URL 等)
  MANUAL
  /// GCal API 経由で自動発行、応答の URL は Event.meetingUrl に write-back
  GOOGLE_MEET

  @@map("meeting_provider")
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
  WAITLISTED
  WAITLISTED_OFFERED
  EXPIRED

  @@map("registration_status")
}

/// Resend Webhook (email.bounced / email.complained) で観測された配信状態。
/// Gmail Feb 2024 / Yahoo bulk sender 要件 (complaint rate < 0.3%) 対応で、
/// HARD_BOUNCED / COMPLAINED 宛先には送信前に suppress する。
/// - OK: 既定値（観測なし or 正常配信）
/// - SOFT_BOUNCED: bounce.type=Temporary（再送猶予あり）
/// - HARD_BOUNCED: bounce.type=Permanent（送信永久停止）
/// - COMPLAINED: email.complained（受信者がスパム報告 → 送信永久停止）
enum EmailDeliveryStatus {
  OK
  SOFT_BOUNCED
  HARD_BOUNCED
  COMPLAINED

  @@map("email_delivery_status")
}

/// SpaceRatePlan の曜日制約。空配列 (daysOfWeek: []) は「全曜日」を意味する。
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("day_of_week")
}

/// SpaceRatePlan の祝日マッチ条件。
enum HolidayMode {
  ANY // 祝日/平日どちらでもマッチ (default)
  ONLY // 祝日のみマッチ
  EXCLUDE // 祝日は除外 (平日のみ)

  @@map("holiday_mode")
}

// ==============================================
// Better Auth Models
// ==============================================

model User {
  id               String   @id @default(uuid(7)) @db.Uuid
  email            String   @unique
  name             String
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  role             Role     @default(USER)
  /// Google Workspace グループ同期でダッシュボード利用可否を表す。
  /// false のとき管理ログイン拒否・通知先/担当候補から除外（ロール履歴は保持）。
  dashboardEnabled Boolean  @default(true) @map("dashboard_enabled")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  accounts     Account[]
  sessions     Session[]
  reservations Reservation[]
  posts        Post[]
  mediaFiles   Media[]
  customer     Customer?     @relation("CustomerUser")
  blockedDates BlockedDate[]

  // RBAC: EDITOR用の割り当てページ（中間テーブル）
  pageAssignments UserPageAssignment[]

  // FK: createdBy / resolvedBy / deletedBy リレーション
  createdCommentThreads      EditorCommentThread[] @relation("CommentThreadCreator")
  resolvedCommentThreads     EditorCommentThread[] @relation("CommentThreadResolver")
  createdEditorComments      EditorComment[]       @relation("EditorCommentCreator")
  deletedEditorComments      EditorComment[]       @relation("EditorCommentDeleter")
  // Inquiry Overhaul Phase 1: 旧 1:1 の replyMessage/repliedBy を廃止。
  // 複数返信スレッド (InquiryReply) と担当者アサイン (Inquiry.assignee) に分割し、
  // status 変更履歴・添付・内部メモの author も User FK として持つ。
  assignedInquiries          Inquiry[]             @relation("InquiryAssignee")
  authoredInquiryReplies     InquiryReply[]        @relation("InquiryReplyAuthor")
  uploadedInquiryAttachments InquiryAttachment[]   @relation("InquiryAttachmentUploadedByUser")
  authoredInquiryNotes       InquiryInternalNote[] @relation("InquiryInternalNoteAuthor")
  reservationDeletions       Reservation[]         @relation("ReservationDeletions")
  deletedReservationSeries   ReservationSeries[]   @relation("ReservationSeriesDeletedBy")
  eventDeletions             Event[]               @relation("EventDeletions")
  createdBlockTemplates      BlockTemplate[]       @relation("BlockTemplateCreator")
  repliedSpaceReviews        SpaceReview[]         @relation("SpaceReviewReplyAuthor")
  priceOverriddenReservations Reservation[]        @relation("ReservationPriceOverrides")

  // OR検索用インデックス
  @@index([name])
  @@map("users")
}

/// EDITOR用のページ割り当て（中間テーブル）
model UserPageAssignment {
  userId String @map("user_id") @db.Uuid
  pageId String @map("page_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([userId, pageId])
  @@index([pageId])
  @@map("user_page_assignments")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id") // Better Auth: ユーザーID or プロバイダーのアカウントID
  providerId            String    @map("provider_id") // Better Auth: "credential" or "google" etc.
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String? // Better Auth: credential provider のパスワード（scrypt hash）
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

// ==============================================
// Business Models
// ==============================================

model Location {
  id              String  @id @default(uuid(7)) @db.Uuid
  // slug / name の一意性は下記 @@unique(where: isActive) 参照（soft-delete 済み行の
  // 値を永久に予約しないため partial index。SpaceCategory.name と同型の fix）。
  slug            String  @db.VarChar(255)
  name            String
  description     String? @db.Text
  address         String
  postalCode      String? @map("postal_code")
  prefecture      String?
  city            String?
  streetAddress   String? @map("street_address")
  buildingName    String? @map("building_name")
  /// 交通案内（最寄り駅・路線・徒歩分数等）。1 行 = 1 経路の構造化配列。
  /// 旧 access String 列（改行区切り）を 2026-05-01 に Json 配列化（破壊的変更）。
  accessLines     Json    @default("[]") @map("access_lines")
  parkingInfo     String? @map("parking_info") @db.Text
  amenities       Json    @default("{}")
  imageUrl        String  @map("image_url")
  imageUrls       Json    @default("[]") @map("image_urls")
  businessHours   Json?   @map("business_hours")
  specialHolidays Json?   @map("special_holidays")

  // MEO（Local SEO）— Settings から移管
  latitude              Float?
  longitude             Float?
  googleBusinessPlaceId String? @map("google_business_place_id")
  googleReviewUrl       String? @map("google_review_url")
  priceRange            String? @map("price_range") @db.VarChar(100)
  paymentAccepted       String? @map("payment_accepted")
  phoneNumber           String? @map("phone_number")
  email                 String?

  // GBP Sync
  gbpSyncEnabled Boolean   @default(true) @map("gbp_sync_enabled")
  gbpSyncedAt    DateTime? @map("gbp_synced_at") @db.Timestamptz(6)
  gbpSyncError   String?   @map("gbp_sync_error") @db.Text

  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(false) @map("is_published")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // スマートロックデバイス登録簿からの既定デバイス（任意）。新規Space作成時に
  // Space.smartLockDeviceIdの初期値として継承される（登録し忘れ防止）。
  defaultSmartLockDeviceId String? @map("default_smart_lock_device_id") @db.Uuid

  // Relations
  spaces                 Space[]
  events                 Event[]
  blockedDates           BlockedDate[]
  smartLockDevices       SmartLockDevice[] @relation("LocationSmartLockDevices")
  defaultSmartLockDevice SmartLockDevice?  @relation("LocationDefaultSmartLockDevice", fields: [defaultSmartLockDeviceId], references: [id], onDelete: SetNull)

  @@unique([sortOrder], map: "locations_active_sort_order_key", where: { isActive: true })
  @@unique([slug], map: "locations_slug_active_key", where: { isActive: true })
  @@unique([name], map: "locations_name_active_key", where: { isActive: true })
  @@index([isPublished, isActive])
  @@index([sortOrder])
  @@index([gbpSyncError])
  @@index([defaultSmartLockDeviceId])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' OR-branch coverage
  // (searchLocations queries name OR address; PostgreSQL falls back to Seq
  // Scan unless every OR branch is indexed).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "locations_name_trgm_idx")
  @@index([address(ops: raw("gin_trgm_ops"))], type: Gin, map: "locations_address_trgm_idx")
  @@map("locations")
}

model SpaceCategory {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String // 例: 会議室、スタジオ、セミナー室（seed idempotency 保証。一意性は下記 @@unique(where: isActive) 参照）
  description String?  @db.Text
  icon        String? // アイコン名（任意）
  color       String? // テーマカラー（任意）
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  spaces Space[]

  // Round-5 audit Finding #18: SpaceCategory は真の削除を持たず isActive:false
  // による無効化のみ（Space.category は onDelete: Restrict のため物理削除不可）。
  // name が無条件 @unique だと、無効化したカテゴリーの名前が永久に予約されたまま
  // になり同名での再作成が常に CONFLICT になっていた。isActive な行の間でのみ
  // 一意性を強制する partial unique index に変更する。
  @@unique([name], map: "space_categories_name_active_key", where: { isActive: true })
  @@unique([sortOrder], map: "space_categories_sort_order_key")
  @@map("space_categories")
}

model Space {
  id                   String    @id @default(uuid(7)) @db.Uuid
  // slug の一意性は下記 @@unique(where: isActive) 参照（soft-delete 済み行の
  // 値を永久に予約しないため partial index。Location.slug / SpaceCategory.name と同型）。
  slug                 String
  name                 String
  /// Lexical EditorState JSON（正本）
  descriptionJson      Json      @map("description_json")
  /// Lexical → 公開表示用 HTML キャッシュ（SanitizedHtml で出力）
  descriptionHtml      String    @map("description_html") @db.Text
  /// SEO description / カード要約 / メタデータ用プレーンテキスト派生
  descriptionPlainText String    @map("description_plain_text") @db.Text
  /// 号室・フロア等。建物の住所は必ず `Location.address` を正本とする。
  /// 主要交通案内・駐車場情報は親 Location（accessLines / parkingInfo）が SSoT。
  addressDetail        String?   @map("address_detail") @db.Text
  capacity             Int
  /// 面積（㎡×100、例: 2550 = 25.5㎡）
  area                 Int?
  hourlyPrice          Int       @map("hourly_price")
  mainImageUrl         String    @map("main_image_url")
  gallery              Json      @default("[]")
  /// 構造化された設備リスト（Airbnb / Booking.com 標準パターン）。
  /// JSON 配列 `{ name: string; iconName: string }[]`。
  /// `iconName` は `@/shared/lib/icon-curation` の curation 識別子。
  /// 空文字 = icon 未指定（fallback で text のみ表示）。
  facilities           Json      @default("[]")
  businessHours        Json?     @map("business_hours")
  isPublished          Boolean   @default(false) @map("is_published")
  publishedAt          DateTime? @map("published_at") @db.Timestamptz(6)
  isActive             Boolean   @default(true) @map("is_active")
  /// レビュー機能の per-space ON/OFF。false の場合は公開ページで非表示 + 投稿不可。
  /// 新規スペースはデフォルト false（opt-in）。`Settings.featureModules.reviews` が上位 gate。
  reviewsEnabled       Boolean   @default(false) @map("reviews_enabled")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // SEO設定
  metaDescription String? @map("meta_description")
  metaKeywords    String? @map("meta_keywords")

  // OGP設定
  ogpTitle       String? @map("ogp_title")
  ogpDescription String? @map("ogp_description")
  ogpImageUrl    String? @map("ogp_image_url")

  // 割引設定（Enum化）
  discountType             DiscountType             @default(NONE) @map("discount_type")
  discountValue            Int?                     @map("discount_value")
  durationDiscountOverride DurationDiscountOverride @default(INHERIT) @map("duration_discount_override")

  // 税率設定（Enum化）
  taxRateType TaxRateType @default(STANDARD) @map("tax_rate_type")

  // 場所・カテゴリー設定（拠点は必須。カテゴリーは任意）
  locationId String  @map("location_id") @db.Uuid
  categoryId String? @map("category_id") @db.Uuid

  // スマートロックデバイス（同一Locationに登録済みのデバイスから1台選択、任意）。
  // デバイスはLocation所有のため、同じ物理ロックを複数Spaceで共有できる
  // （例: 建物入口の共有ロックを複数の貸室が使う場合）。
  smartLockDeviceId String? @map("smart_lock_device_id") @db.Uuid

  // Relations
  reservations      Reservation[]
  reservationSeries ReservationSeries[]
  reviews           SpaceReview[]
  events            Event[]
  blockedDates      BlockedDate[]
  ratePlans         SpaceRatePlan[]
  location          Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  category          SpaceCategory?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  smartLockDevice   SmartLockDevice?    @relation(fields: [smartLockDeviceId], references: [id], onDelete: SetNull)

  @@unique([slug], map: "spaces_slug_active_key", where: { isActive: true })
  // OR検索用インデックス
  @@index([name])
  @@index([addressDetail])
  @@index([isPublished, isActive])
  @@index([publishedAt, isActive])
  @@index([locationId])
  @@index([categoryId])
  @@index([smartLockDeviceId])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' — searchSpaces uses
  // `OR: [{ name }, { slug }]`, so both branches need trigram to avoid a
  // Seq Scan fallback (per Codex review on PR #986).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "spaces_name_trgm_idx")
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "spaces_slug_trgm_idx")
  @@map("spaces")
}

/// 曜日別 / 時間帯別 / 特定期間 / 祝日料金プラン。マッチする plan がない時間帯は
/// `Space.hourlyPrice` にフォールバックする。同一時間帯に複数 plan がマッチした場合は
/// `updatedAt DESC`（last-updated-wins）で 1 件を採用する。解決ロジックは
/// `src/shared/lib/pricing/rate-plan-resolver.ts`（Task 4 で追加）。
/// CHECK 制約 4 本（hourlyPrice >= 0 / startTime・endTime の HH:MM 形式 / effectiveFrom <=
/// effectiveTo）は Prisma 7 が `@@check` 属性を持たないため migration.sql に手書きしてある。
/// `prisma db pull` で introspection すると欠落するため、再生成時は手で復元すること
/// （BlockedDate の CHECK 制約と同じ注意点）。
model SpaceRatePlan {
  id      String @id @default(uuid(7)) @db.Uuid
  spaceId String @map("space_id") @db.Uuid
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  name        String @db.VarChar(100) // 例: "週末料金", "GW料金", "深夜料金", "祝日料金"
  hourlyPrice Int    @map("hourly_price")

  daysOfWeek    DayOfWeek[] @map("days_of_week") // 空配列 = 全曜日（曜日制約なし）
  holidayMode   HolidayMode @default(ANY) @map("holiday_mode")
  startTime     String?     @map("start_time") @db.VarChar(5) // "HH:MM" (24h)、null = 00:00（開始）
  endTime       String?     @map("end_time") @db.VarChar(5) // "HH:MM"、null = 24:00（終了、半開区間）
  effectiveFrom DateTime?   @map("effective_from") @db.Date // JST 日付、null = 期限なし
  effectiveTo   DateTime?   @map("effective_to") @db.Date // JST 日付（inclusive）、null = 期限なし

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6) // last-updated-wins 優先度用

  @@index([spaceId, updatedAt(sort: Desc)])
  @@map("space_rate_plans")
}

/// 臨時休業 / 急な休み（businessHours の曜日別定休日を補完する日付範囲ベースの休業）。
/// per-space / per-location / global の 3 階層 cascade（additive、override なし）。
/// scope と type は VarChar + 型ガード SSoT（`@/shared/lib/validations/enums/helpers`）で運用。
/// scope / spaceId / locationId は discriminated union 不変条件を持つ:
/// SPACE→spaceId 必須・locationId null / LOCATION→locationId 必須・spaceId null /
/// GLOBAL→両方 null。これは DB の CHECK 制約 `blocked_dates_scope_target_check`
/// (baseline migration 00000000000000_init) で強制されるが、Prisma schema DSL では
/// 表現できないため schema.prisma は完全な SSoT ではない。
/// ⚠ `prisma db pull`（introspection）は CHECK 制約を取り込まず黙って落とすので、
/// introspection で schema を再生成する際は本制約を手で復元すること
/// （`prisma migrate reset` は baseline migration を再生するため制約は復元される）。
/// アプリ層は Zod superRefine（blocked-date バリデーション）で同一不変条件を二重に保証する。
model BlockedDate {
  id         String           @id @default(uuid(7)) @db.Uuid
  /// "SPACE" | "LOCATION" | "GLOBAL"（isValidBlockedDateScope で検証）
  scope      BlockedDateScope
  /// scope=SPACE のみ非 null
  spaceId    String?          @map("space_id") @db.Uuid
  /// scope=LOCATION のみ非 null
  locationId String?          @map("location_id") @db.Uuid
  /// JST カレンダー日付を UTC 深夜で保持。単日休業は startDate=endDate。
  startDate  DateTime         @map("start_date") @db.Date
  endDate    DateTime         @map("end_date") @db.Date
  /// "年末年始" / "設備点検" / "台風 19 号による臨時休業" 等の plain text ラベル
  reason     String?          @db.VarChar(200)
  /// "HOLIDAY" | "MAINTENANCE" | "EMERGENCY" | "OTHER"（isValidBlockedDateType で検証）
  type       BlockedDateType
  createdBy  String           @map("created_by") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  space    Space?    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  creator  User      @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([scope, startDate, endDate])
  @@index([spaceId, startDate, endDate])
  @@index([locationId, startDate, endDate])
  @@index([createdBy])
  @@map("blocked_dates")
}

model ReservationSeries {
  id                          String    @id @default(uuid(7)) @db.Uuid
  spaceId                     String    @map("space_id") @db.Uuid
  customerId                  String    @map("customer_id") @db.Uuid
  couponId                    String?   @map("coupon_id") @db.Uuid
  rrule                       String    @db.VarChar(500)
  dtstart                     DateTime  @db.Timestamptz(6)
  duration                    Int
  instanceCount               Int       @map("instance_count")
  templateData                Json      @map("template_data")
  agreementSnapshot           Json      @map("agreement_snapshot")
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  cancelledAt                 DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledByType             String?   @map("cancelled_by_type") @db.VarChar(20)
  cancellationReason          String?   @map("cancellation_reason") @db.Text
  deletedAt                   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById                 String?   @map("deleted_by_id") @db.Uuid
  /// Google Calendar 側の recurring master event ID (Phase B.2.1 Task 5 で追加)。
  /// null = 未同期 or Google Calendar 無効。bulk cancel の series-level GCal 操作
  /// (deleteGcalMaster / patchGcalMasterUntil) が非 null 時のみ発火する。
  googleCalendarMasterEventId String?   @map("google_calendar_master_event_id") @db.VarChar(1024)

  space     Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  customer  Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  coupon    Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  deletedBy User?         @relation("ReservationSeriesDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  instances Reservation[]

  // soft-delete 済み行が (spaceId, dtstart) を恒久占有しないよう partial UNIQUE。
  // 実体は 20260717010625_add_reservation_series が raw SQL で作った索引で、
  // `map` で同名を指すことで migrate diff が「一致」と判定する（新規 migration 不要）。
  // この宣言を消すと diff が DROP INDEX を提案し続ける（PR #1870 以前の状態）。
  @@unique([spaceId, dtstart], map: "reservation_series_space_dtstart_active_unique", where: { deletedAt: null })
  @@index([spaceId, dtstart])
  @@index([customerId])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([deletedById], map: "reservation_series_deleted_by_id_idx", where: { deletedById: { not: null } })
  @@index([couponId], map: "reservation_series_coupon_id_idx", where: { couponId: { not: null } })
  @@map("reservation_series")
}

model Reservation {
  id         String            @id @default(uuid(7)) @db.Uuid
  spaceId    String            @map("space_id") @db.Uuid
  userId     String?           @map("user_id") @db.Uuid
  customerId String            @map("customer_id") @db.Uuid
  /// Space reservations are half-open intervals: [startTime, endTime).
  /// DB invariant `reservations_time_order_check` enforces startTime < endTime.
  startTime  DateTime          @map("start_time") @db.Timestamptz(6)
  endTime    DateTime          @map("end_time") @db.Timestamptz(6)
  /// Active inventory states are PENDING / CONFIRMED. DB invariant
  /// `reservations_no_active_time_overlap_excl` prevents overlapping active,
  /// non-deleted reservations for the same space by using PostgreSQL EXCLUDE
  /// with `tstzrange(startTime, endTime, '[)')`.
  ///
  /// Prisma schema DSL cannot express EXCLUDE constraints or CHECK constraints.
  /// `prisma db pull` will not preserve these invariants; keep migration SQL,
  /// comments, and `__tests__/integration/domain/reservations/db-invariants.test.ts`
  /// in sync if this model changes.
  status     ReservationStatus @default(PENDING)
  totalPrice Int               @map("total_price") // 割引後・税抜（円、NOT NULL）
  notes      String?           @db.Text
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Optimistic concurrency (Rails ActiveRecord lock_version / Hibernate @Version と同型)。
  /// form-driven update path (updateCustomerReservation / updateAdminReservationCommand) が
  /// updateMany の WHERE 述語で claim + increment する。cron / payment / calendar-sync 等の
  /// 非 form path は touch しない (Rails .update_all / Hibernate native query と同型)。
  version Int @default(0)

  // 割引情報
  couponId               String? @map("coupon_id") @db.Uuid // 適用されたクーポンID
  couponDiscountAmount   Int?    @map("coupon_discount_amount") // クーポン割引額（円）
  durationDiscountAmount Int?    @map("duration_discount_amount") // 長時間割引額（円）
  spaceDiscountAmount    Int?    @map("space_discount_amount") // スペース固有割引額（円）
  basePrice              Int     @map("base_price") // 割引前価格（円、NOT NULL、Σ segment.subtotal）
  /// Rate plan 解決結果のスナップショット（`RateBreakdown` 型、`src/shared/lib/pricing/rate-breakdown.ts`）。
  /// rate plan 導入前の予約は segments が空の snapshot を保持する（内訳は再現不可）。
  rateBreakdownJson      Json    @map("rate_breakdown_json")

  // 税情報（予約時点の値を記録）
  taxRateType       TaxRateType @map("tax_rate_type") // 適用された税率タイプ（NOT NULL、snapshot）
  taxRate           Int         @map("tax_rate") // 適用税率（%、whole integer、例: 10 = 10%）（NOT NULL、snapshot）
  taxAmount         Int         @map("tax_amount") // 税額（円、NOT NULL）
  totalPriceWithTax Int         @map("total_price_with_tax") // 税込み合計（円、NOT NULL）
  /// 管理者が計算値を手動上書きした場合の実行者（audit 目的）。null = 上書きなし。
  ///
  /// **FK を張る。** 上書き額は返金額・領収書金額の根拠なので「誰が決めたか」は
  /// 後から必ず引ける必要がある。text の論理参照だと実行者が退職して users 行が
  /// 消えても ID 文字列だけが残り、**存在しない人を指したまま**になる。
  /// `deletedById` / `repliedById` と同じ `onDelete: SetNull` に揃え、
  /// 「消えた＝辿れない」を NULL で正直に表す。
  priceOverriddenById String?   @map("price_overridden_by_id") @db.Uuid

  // Google Calendar Sync
  googleCalendarEventId String?   @map("google_calendar_event_id") // 共有カレンダーのイベントID
  calendarSyncedAt      DateTime? @map("calendar_synced_at") @db.Timestamptz(6) // 最終同期日時
  calendarSyncError     String?   @map("calendar_sync_error") @db.Text // 同期エラーメッセージ

  // Guest contact info (予約時に入力された連絡先 — Customer レコードとは独立に保存)
  guestLastName     String?       @map("guest_last_name")
  guestFirstName    String?       @map("guest_first_name")
  guestEmail        String?       @map("guest_email")
  guestPhone        String?       @map("guest_phone")
  guestCompanyName  String?       @map("guest_company_name")
  guestCustomerType CustomerType? @map("guest_customer_type")

  // Relations
  space              Space               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  coupon             Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  review             SpaceReview?
  smartLockPasscodes SmartLockPasscode[]

  // Soft-delete
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by_id") @db.Uuid
  deletedBy   User?     @relation("ReservationDeletions", fields: [deletedById], references: [id], onDelete: SetNull)

  priceOverriddenBy User? @relation("ReservationPriceOverrides", fields: [priceOverriddenById], references: [id], onDelete: SetNull)

  /// 利用人数。公開予約フォームが必須で集め、`guestCountCapacityError` が
  /// スペース定員に対して server-side で検査する値。
  ///
  /// **nullable なのは「記録が無い」を表すため。** この列より前の予約には実際の
  /// 人数が存在せず、`@default(1)` で埋めると捏造になる。編集画面がまさにそれを
  /// やっていた（`numberOfGuests={1}` のハードコード）ため、20 名の予約でも
  /// 定員 1 名のスペースへ移動できていた。
  numberOfGuests Int? @map("number_of_guests")

  // Payment (Stripe)
  paymentStatus           PaymentStatus @default(UNPAID) @map("payment_status")
  /// Stripe Checkout Session の id。`@unique` は「同じ session が別の予約に紐づく」
  /// silent bug を防ぐ。EventRegistration 側は最初から `@unique` で、そのコメントは
  /// 「Reservation 側と同型」と書いていたが、実際にはこちら側だけ制約が無かった。
  stripeCheckoutSessionId String?       @unique @map("stripe_checkout_session_id")
  /// Stripe PaymentIntent の id。返金の idempotency key としても参照するため一意。
  stripePaymentIntentId   String?       @unique @map("stripe_payment_intent_id")
  paidAt                  DateTime?     @map("paid_at") @db.Timestamptz(6)
  /// checkout session を開始した (paymentStatus を PENDING に遷移させた) 最終時刻。
  /// fail-safe cron (`/api/cron/pending-reservation-expire`) が
  /// `PENDING_RESERVATION_EXPIRY_MINUTES` の cutoff 判定に使う。予約作成時刻
  /// (createdAt) ではなく checkout 開始時刻で判定することで、予約作成から時間をおいて
  /// 決済を開始したケース (createdAt < cutoff だが checkout はまだ生きている) を誤爆
  /// せず、FAILED → PENDING の再 checkout でも refresh される。
  paymentInitiatedAt      DateTime?     @map("payment_initiated_at") @db.Timestamptz(6)

  // Cancellation tracking
  cancellationReason String?   @map("cancellation_reason") @db.Text
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledByType    String?   @map("cancelled_by_type") @db.VarChar(20) // "CUSTOMER_MYPAGE" | "CUSTOMER_TOKEN" | "ADMIN" | "SYSTEM" (CANCELLED_BY SSoT: src/shared/lib/validations/enums/helpers.ts)

  // iCal RFC 5545 SEQUENCE (increments on update/cancel)
  icsSequence Int @default(0) @map("ics_sequence")

  // Reminder cron 冪等性: リマインダーメール送信済み日時（null = 未送信）。
  // 二重送信防止のため送信前に atomic claim で now を立て、送信失敗時は null に戻す。
  reminderSentAt DateTime? @map("reminder_sent_at") @db.Timestamptz(6)

  /// 予約変更後の SwitchBot パスコード再発行待ち（revoke 確定後に webhook/cron が createKey）。
  /// edit-side-effects が revoke 受理後に key 消失を同リクエスト内で確認できなかった場合に立てる。
  smartLockReissuePendingAt DateTime? @map("smart_lock_reissue_pending_at") @db.Timestamptz(6)

  // PR#16: 領収書 (適格請求書) の 1:1 relation (1 予約 = 1 領収書、再発行は
  // Receipt.reissuedFromId で自参照)
  receipt Receipt?
  // task #9 PR#1: 部分返金の repeatable child records (append-only)
  refunds Refund[]

  // Phase B.2: 繰返し予約 (RRULE) の親 series への参照。単発予約は両方 null。
  seriesId                String?            @map("series_id") @db.Uuid
  recurrenceInstanceIndex Int?               @map("recurrence_instance_index")
  series                  ReservationSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([startTime])
  @@index([endTime])
  @@index([status])
  @@index([createdAt])
  @@index([spaceId, startTime, endTime])
  @@index([customerId, startTime])
  @@index([couponId])
  @@index([deletedAt])
  @@index([paymentStatus])
  @@index([seriesId, recurrenceInstanceIndex])
  @@index([deletedById], map: "reservations_deleted_by_id_idx", where: { deletedById: { not: null } })
  // 手動上書きは例外的な操作なので大半の行が NULL。partial にして
  // `deleted_by_id` と同じ形にする（NULL を索引に載せない）。
  @@index([priceOverriddenById], map: "reservations_price_overridden_by_id_idx", where: { priceOverriddenById: { not: null } })
  @@map("reservations")
}

model Customer {
  id                     String              @id @default(uuid(7)) @db.Uuid
  lastName               String              @map("last_name")
  firstName              String              @map("first_name")
  lastNameKana           String?             @map("last_name_kana") // 姓カナ（任意）
  firstNameKana          String?             @map("first_name_kana") // 名カナ（任意）
  companyName            String?             @map("company_name") // 会社名・団体名（法人の場合）
  customerType           CustomerType        @default(PERSONAL) @map("customer_type")
  email                  String
  emailCanonical         String              @map("email_canonical")
  phoneNumber            String?             @map("phone_number")
  postalCode             String?             @map("postal_code") @db.VarChar(8) // 郵便番号 "123-4567" 等
  prefecture             String?             @db.VarChar(10) // 都道府県（PREFECTURES SSoT）
  city                   String?             @db.VarChar(100) // 市区町村
  streetAddress          String?             @map("street_address") @db.VarChar(200) // 町名・番地
  building               String?             @db.VarChar(200) // 建物名・部屋番号
  status                 CustomerStatus      @default(NEW)
  notes                  String?             @db.Text
  totalReservations      Int                 @default(0) @map("total_reservations")
  totalSpent             Int?                @map("total_spent")
  lastReservationAt      DateTime?           @map("last_reservation_at") @db.Timestamptz(6)
  firstReservationAt     DateTime?           @map("first_reservation_at") @db.Timestamptz(6)
  isActive               Boolean             @default(true) @map("is_active")
  marketingOptIn         Boolean             @default(false) @map("marketing_opt_in") // メルマガ・キャンペーン受信可否
  phoneContactOptIn      Boolean             @default(true) @map("phone_contact_opt_in") // 電話連絡可否
  /// Resend Webhook で観測された配信状態。HARD_BOUNCED / COMPLAINED は送信前にスキップ。
  /// 詳細は EmailDeliveryStatus enum 参照。
  emailDeliveryStatus    EmailDeliveryStatus @default(OK) @map("email_delivery_status")
  /// [write-only audit trail] Resend Webhook 観測時刻。現状 admin UI 未配線 (src/ read consumer 0)。
  /// 単独 DROP は 310s 計画ダウンタイム発生のため次の必然的 destructive migration に bundle 予定
  /// (memory: dead-taxinputmode-bundle-deferred-2026-07-11 と同方針)。
  emailDeliveryUpdatedAt DateTime?           @map("email_delivery_updated_at") @db.Timestamptz(6)
  /// [write-only audit trail] Resend Webhook payload の bounce.message / suppression reason (人間可読のラベル)。
  /// 現状 admin UI 未配線 (src/ read consumer 0)。単独 DROP は 310s 計画ダウンタイム発生のため
  /// 次の必然的 destructive migration に bundle 予定。誤って未使用と判断して単独 DROP しないこと。
  emailDeliveryReason    String?             @map("email_delivery_reason") @db.VarChar(500)
  /// 不審検知cron(customer-risk-scan)が検知理由コードを書き込む。手動クリアで null に戻す。
  /// 自動でBLACKLIST化・予約拒否はしない（最終判断は常に管理者、誤検知リスクの回避）。
  flaggedForReviewAt     DateTime?           @map("flagged_for_review_at") @db.Timestamptz(6)
  flagReasons            String[]            @default([]) @map("flag_reasons")
  /// STATE-03: 匿名化 (anonymize) 実施時刻。非 null = 匿名化済み。
  /// 決済歴 (Receipt 発行済) のある Customer は物理削除できないため
  /// (Receipt.reservation は onDelete: Restrict)、PII を placeholder に置換して
  /// Reservation / Receipt の customerId を残す。関連の会計証跡は不変。
  /// append-only の証跡列 (再設定禁止、reset は別 workflow)。
  anonymizedAt           DateTime?           @map("anonymized_at") @db.Timestamptz(6)
  /// STATE-03: 匿名化理由コード。
  /// - "customer-requested": 顧客本人からの削除依頼 (GDPR 相当)
  /// - "admin-purge":        管理者による purge (誤登録・重複クリーンアップ)
  /// - "data-retention":     データ保持期限経過による自動 purge
  anonymizedReason       String?             @map("anonymized_reason") @db.VarChar(50)
  /// RESEND-AUDIT M7: anonymize / merge で emailCanonical が placeholder に
  /// 書き換えられる際、その時点の emailCanonical (= 実 email) の
  /// `hashSuppressedEmailCandidate` 値を保存する。`getSuppressedEmailSet` は
  /// 「`emailDeliveryStatus ∈ {HARD_BOUNCED, COMPLAINED}` の emailCanonical hash」と
  /// 「`suppressedEmailHash IS NOT NULL` の直接値」の union を返す。
  /// これにより「匿名化前に HARD_BOUNCED / COMPLAINED だった email」への
  /// 再送信を suppression list で継続的に弾ける (sender reputation 保護)。
  /// 通常 Customer では NULL、匿名化・マージ後の永続 hash 記録用。
  suppressedEmailHash    String?             @map("suppressed_email_hash") @db.VarChar(128)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Social Auth Link
  userId String? @unique @map("user_id") @db.Uuid
  user   User?   @relation("CustomerUser", fields: [userId], references: [id], onDelete: SetNull)

  // Relations
  reservations               Reservation[]
  reservationSeries          ReservationSeries[]
  inquiries                  Inquiry[]
  reviews                    SpaceReview[]
  eventRegistrations         EventRegistration[]
  pendingEmailChanges        PendingCustomerEmailChange[]
  pendingMergeAsTarget       PendingCustomerMerge[]       @relation("MergeTarget")
  pendingMergeAsSource       PendingCustomerMerge[]       @relation("MergeSource")
  // Inquiry Overhaul Phase 1: 顧客が添付した inquiry_attachments 行 (uploadedByCustomerId)
  uploadedInquiryAttachments InquiryAttachment[]          @relation("InquiryAttachmentUploadedByCustomer")
  authoredInquiryReplies     InquiryReply[]               @relation("InquiryReplyAuthorCustomer")

  @@index([firstName])
  @@index([phoneNumber])
  @@index([status])
  @@index([customerType])
  @@index([emailCanonical, userId])
  @@index([isActive])
  @@index([lastReservationAt])
  @@index([lastName, firstName])
  @@index([emailDeliveryStatus])
  @@index([flaggedForReviewAt])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' — searchCustomers ORs
  // four columns; all four need trigram or PostgreSQL falls back to Seq Scan
  // on `customers` (per Codex review on PR #986).
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_last_name_trgm_idx")
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_first_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_email_trgm_idx")
  @@index([companyName(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_company_name_trgm_idx")
  @@index([suppressedEmailHash], map: "customers_suppressed_email_hash_idx", where: { suppressedEmailHash: { not: null } })
  @@index([createdAt])
  @@map("customers")
}

// ==============================================
// PendingCustomerEmailChange (SETTINGS-02 followup)
// ==============================================
//
// マイページからの初回 email 登録 (LINE OAuth で email scope 未付与顧客の
// 詰み状態解消) を本人確認 URL 経由に限定するための短命トークン台帳。
// PR #1217 の同時 uniqueness 検査 (未リンク顧客に既存の同 email 顧客が居ないこと)
// はここで確認しつつ、Customer.email への実書込は URL クリック後の
// /api/customer/verify-email 経由でのみ発生する。
//
// - id / tokenHash は verify Route Handler が hash 参照するため index を張る
// - consumedAt は「クリック済み」を single-use で強制する (2 回目クリックは 410 相当)
// - expiresAt は cron でなく verify Route Handler の compare で判定する
//   (削除は次回の request 時に customerId 既存行を上書きするため蓄積しない)
model PendingCustomerEmailChange {
  id                String    @id @default(uuid(7)) @db.Uuid
  customerId        String    @map("customer_id") @db.Uuid
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  newEmail          String    @map("new_email") @db.VarChar(320)
  newEmailCanonical String    @map("new_email_canonical") @db.VarChar(320)
  tokenHash         String    @unique @map("token_hash") @db.VarChar(64) // sha256 hex
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([customerId])
  @@index([expiresAt])
  @@map("pending_customer_email_changes")
}

// ==============================================
// PendingCustomerMerge (self-serve guest history merge)
// ==============================================
//
// 会員 Customer と同一 emailCanonical の未リンク guest Customer を、guest email
// 宛の本人確認 URL 経由で統合するための短命トークン台帳。
// PendingCustomerEmailChange と同型 (sha256 hash + single-use + TTL)。
model PendingCustomerMerge {
  id               String    @id @default(uuid(7)) @db.Uuid
  targetCustomerId String    @map("target_customer_id") @db.Uuid
  sourceCustomerId String    @map("source_customer_id") @db.Uuid
  guestEmail       String    @map("guest_email") @db.VarChar(320)
  tokenHash        String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  targetCustomer Customer @relation("MergeTarget", fields: [targetCustomerId], references: [id], onDelete: Cascade)
  sourceCustomer Customer @relation("MergeSource", fields: [sourceCustomerId], references: [id], onDelete: Cascade)

  @@index([targetCustomerId])
  @@index([expiresAt])
  @@index([sourceCustomerId])
  @@map("pending_customer_merges")
}

// ==============================================
// Coupon Model (割引クーポン)
// ==============================================

model Coupon {
  id          String  @id @default(uuid(7)) @db.Uuid
  code        String  @unique // クーポンコード (大文字英数字)
  name        String // 管理用名称
  description String? // 説明

  // 割引設定
  type          CouponType
  discountValue Int        @map("discount_value") // 割引額 or 割引率（円 or %）

  // 適用条件
  minReservationAmount Int? @map("min_reservation_amount") // 最低利用金額（円）
  maxDiscountAmount    Int? @map("max_discount_amount") // 最大割引額（円、パーセント割引時）

  // 有効期限
  validFrom  DateTime  @map("valid_from") @db.Timestamptz(6)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(6)

  // 利用制限
  usageLimit Int?    @map("usage_limit") // 利用回数上限（null=無制限）
  usageCount Int     @default(0) @map("usage_count") // 利用回数
  isActive   Boolean @default(true) @map("is_active")

  // 併用設定
  canCombineWithDurationDiscount Boolean @default(true) @map("can_combine_with_duration_discount") // 長時間割引との併用可否

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  reservations      Reservation[]
  reservationSeries ReservationSeries[]

  // @unique が自動的にインデックスを作成するため @@index([code]) は不要
  @@index([validFrom, validUntil])
  @@index([isActive])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' OR-branch coverage
  // (searchCoupons uses `OR: [{ code }, { name }]`; both branches indexed).
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "coupons_code_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "coupons_name_trgm_idx")
  @@map("coupons")
}

model Inquiry {
  id            String        @id @default(uuid(7)) @db.Uuid
  /// ユーザー可視の受付番号 (INQ-XXXXXXXX)。application 層で採番、UNIQUE 制約 + retry。
  receiptNumber String        @unique @map("receipt_number") @db.VarChar(20)
  name          String
  companyName   String?       @map("company_name") // 会社名・団体名（法人の場合）
  customerType  CustomerType? @map("customer_type")
  email         String
  /// 任意入力の連絡先電話番号 (public フォーム + 会員 prefill 対応)
  phoneNumber   String?       @map("phone_number")
  subject       String
  message       String        @db.Text
  status        InquiryStatus @default(NEW)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Inquiry Overhaul Phase 1: 担当者アサイン (SLA 対応期限とセットで運用)
  assigneeId   String?   @map("assignee_id") @db.Uuid
  assignee     User?     @relation("InquiryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  slaExpiresAt DateTime? @map("sla_expires_at") @db.Timestamptz(6)

  // Soft delete: admin UI の削除は deletedAt を刻むだけ。hard delete は
  // data-retention cron (`purgeExpiredInquiries`) が唯一の経路。
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  // GDPR / PIPA 22 対応の PII 匿名化タイムスタンプ + 理由 (Phase 6 で anonymize command 実装)
  anonymizedAt     DateTime? @map("anonymized_at") @db.Timestamptz(6)
  anonymizedReason String?   @map("anonymized_reason") @db.VarChar(50)

  // Customer Link（ログインユーザーのお問い合わせ紐づけ）
  customerId String?   @map("customer_id") @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // 複数返信スレッド / 状態履歴 / 添付 / 内部メモ / タグ
  replies       InquiryReply[]
  statusHistory InquiryStatusHistory[]
  attachments   InquiryAttachment[]
  internalNotes InquiryInternalNote[]
  tags          InquiryTagOnInquiry[]

  @@index([email])
  @@index([status])
  @@index([createdAt, status])
  @@index([customerId, createdAt])
  @@index([customerId, status])
  @@index([assigneeId])
  @@index([deletedAt])
  @@index([slaExpiresAt])
  @@index([anonymizedAt])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' — searchInquiries ORs
  // name/email/subject; all three need trigram to avoid Seq Scan fallback.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "inquiries_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "inquiries_email_trgm_idx")
  @@index([subject(ops: raw("gin_trgm_ops"))], type: Gin, map: "inquiries_subject_trgm_idx")
  @@map("inquiries")
}

/// Inquiry の返信スレッド (STAFF / CUSTOMER 双方向)。作成順に createdAt 昇順で並べる。
model InquiryReply {
  id               String                 @id @default(uuid(7)) @db.Uuid
  inquiryId        String                 @map("inquiry_id") @db.Uuid
  authorType       InquiryReplyAuthorType @map("author_type")
  /// STAFF → User.id (User 削除は Restrict — positive-author CHECK と整合)。CUSTOMER では null。
  authorId         String?                @map("author_id") @db.Uuid
  /// CUSTOMER → Customer.id (Customer 削除は Restrict)。STAFF では null。
  authorCustomerId String?                @map("author_customer_id") @db.Uuid
  body             String                 @db.Text
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  inquiry        Inquiry             @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author         User?               @relation("InquiryReplyAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  authorCustomer Customer?           @relation("InquiryReplyAuthorCustomer", fields: [authorCustomerId], references: [id], onDelete: Restrict)
  attachments    InquiryAttachment[]

  @@index([inquiryId, createdAt])
  @@index([authorId])
  @@index([authorCustomerId])
  @@map("inquiry_replies")
}

/// Inquiry.status の変更履歴 (append-only)。fromStatus = NULL は creation。
model InquiryStatusHistory {
  id          String         @id @default(uuid(7)) @db.Uuid
  inquiryId   String         @map("inquiry_id") @db.Uuid
  fromStatus  InquiryStatus? @map("from_status")
  toStatus    InquiryStatus  @map("to_status")
  changedById String?        @map("changed_by_id") @db.Uuid
  reason      String?        @db.VarChar(200)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  /// DELETE Cascade はデータ保持 purge が bypass GUC を立てた状態でだけ通る正規経路。
  /// onUpdate は NoAction にする（既定の Cascade は append-only trigger に弾かれる）。
  /// changedById は AuditLog.userId と同じ理由で FK を張らない論理参照。
  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([inquiryId, createdAt])
  @@map("inquiry_status_history")
}

/// Inquiry 本文または個別 InquiryReply に紐づく添付ファイル (R2 保管)。
model InquiryAttachment {
  id                   String   @id @default(uuid(7)) @db.Uuid
  inquiryId            String   @map("inquiry_id") @db.Uuid
  /// 特定の返信への添付なら非 null (返信削除で cascade 削除)
  replyId              String?  @map("reply_id") @db.Uuid
  /// R2 object key (UNIQUE)。physical uniqueness の source of truth。
  r2Key                String   @unique @map("r2_key")
  mimeType             String   @map("mime_type") @db.VarChar(100)
  sizeBytes            Int      @map("size_bytes")
  filename             String   @db.VarChar(255)
  /// アップロード主体: STAFF (uploadedById) または CUSTOMER (uploadedByCustomerId) のいずれか（必須）。
  uploadedById         String?  @map("uploaded_by_id") @db.Uuid
  uploadedByCustomerId String?  @map("uploaded_by_customer_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  inquiry            Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  reply              InquiryReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  uploadedByUser     User?         @relation("InquiryAttachmentUploadedByUser", fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedByCustomer Customer?     @relation("InquiryAttachmentUploadedByCustomer", fields: [uploadedByCustomerId], references: [id], onDelete: Restrict)

  @@index([inquiryId, createdAt])
  @@index([replyId])
  @@index([uploadedById], map: "inquiry_attachments_uploaded_by_id_idx", where: { uploadedById: { not: null } })
  @@index([uploadedByCustomerId], map: "inquiry_attachments_uploaded_by_customer_id_idx", where: { uploadedByCustomerId: { not: null } })
  @@map("inquiry_attachments")
}

/// スタッフ間 internal メモ (顧客には見えない)。author 削除は Restrict で保護。
model InquiryInternalNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  inquiryId String   @map("inquiry_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author  User    @relation("InquiryInternalNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([inquiryId, createdAt])
  @@index([authorId])
  @@map("inquiry_internal_notes")
}

/// タグマスタ (name UNIQUE)。カラーコードは省略可 (default UI 色)。
model InquiryTag {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique @db.VarChar(50)
  color     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  inquiries InquiryTagOnInquiry[]

  @@map("inquiry_tags")
}

/// Inquiry ↔ InquiryTag 中間テーブル。
model InquiryTagOnInquiry {
  inquiryId String   @map("inquiry_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  inquiry Inquiry    @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  tag     InquiryTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([inquiryId, tagId])
  @@index([tagId])
  @@map("inquiry_tag_on_inquiries")
}

model News {
  id                 String       @id @default(uuid(7)) @db.Uuid
  slug               String       @unique
  title              String
  contentHtml        String       @map("content_html") @db.Text // HTMLキャッシュ（公開表示用）
  contentJson        Json?        @map("content_json") // Lexical EditorState JSON（プライマリ）
  isPublished        Boolean      @default(false) @map("is_published")
  publishedAt        DateTime?    @map("published_at") @db.Timestamptz(6)
  contentWidth       LayoutWidth? @map("content_width")
  contentWidthCustom Int?         @map("content_width_custom") // CUSTOMの場合の幅（px）
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // SEO設定
  metaDescription String? @map("meta_description")
  metaKeywords    String? @map("meta_keywords")

  // OGP設定
  ogpTitle       String? @map("ogp_title")
  ogpDescription String? @map("ogp_description")
  ogpImageUrl    String? @map("ogp_image_url")

  // OR検索用インデックス
  @@index([title])
  @@index([isPublished, publishedAt])
  @@index([createdAt])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' — searchNews ORs
  // title/slug; both branches need trigram to avoid Seq Scan fallback.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "news_title_trgm_idx")
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "news_slug_trgm_idx")
  @@map("news")
}

model AnnouncementBar {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Sanity Portable Text 互換の inline span 配列。`{_key,_type:"span",text}` と
  /// `{_key,_type:"iconInline",name}` の discriminated union を順次配置する。
  message      Json      @default("[]")
  linkUrl      String?   @map("link_url")
  linkText     String?   @map("link_text")
  bgColor      String?   @map("bg_color") // カスタム背景色 (hex)
  textColor    String?   @map("text_color") // カスタム文字色 (hex)
  isActive     Boolean   @default(true) @map("is_active")
  displayOrder Int       @default(0) @map("display_order")
  startAt      DateTime? @map("start_at") @db.Timestamptz(6)
  endAt        DateTime? @map("end_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([displayOrder], map: "announcement_bars_display_order_key")
  @@index([isActive, displayOrder])
  @@index([startAt, endAt])
  @@map("announcement_bars")
}

// ==============================================
// Post Models
// ==============================================

model Post {
  id                 String       @id @default(uuid(7)) @db.Uuid
  title              String
  // 一意性は下記 @@unique(where: deletedAt is null) 参照（Event/FaqCategory と同型）
  slug               String
  excerpt            String       @db.Text
  contentHtml        String       @map("content_html") @db.Text // HTMLキャッシュ（公開表示用）
  contentJson        Json?        @map("content_json") // Lexical EditorState JSON（プライマリ）
  thumbnailUrl       String       @map("thumbnail_url")
  ogpImageUrl        String?      @map("ogp_image_url")
  categoryId         String       @map("category_id") @db.Uuid
  metaDescription    String?      @map("meta_description")
  metaKeywords       String?      @map("meta_keywords")
  ogpTitle           String?      @map("ogp_title")
  ogpDescription     String?      @map("ogp_description")
  publishedAt        DateTime?    @map("published_at") @db.Timestamptz(6)
  status             PostStatus   @default(DRAFT)
  viewCount          Int          @default(0) @map("view_count") // 公開ページでの閲覧回数（集計値、localStorage で dedup）
  authorId           String?      @map("author_id") @db.Uuid // ユーザー削除時にnull化
  contentWidth       LayoutWidth? @map("content_width")
  contentWidthCustom Int?         @map("content_width_custom") // CUSTOMの場合の幅（px）
  /// Soft delete: admin 削除は deletedAt を刻むだけ。hard delete はゴミ箱の永久削除 or trash-cleanup cron。
  deletedAt          DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  category PostCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author   User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  postTags PostTagOnPost[]

  // ソフトデリート済み行が slug を占有し続けないよう partial unique（Event と同型）。
  @@unique([slug], map: "posts_slug_active_key", where: { deletedAt: null })
  // OR検索用インデックス
  @@index([title])
  @@index([authorId])
  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([viewCount])
  @@index([status, viewCount])
  @@index([deletedAt])
  // pg_trgm GIN for admin command-palette ILIKE '%q%' — searchPosts ORs
  // title/slug; both branches need trigram to avoid Seq Scan fallback.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "posts_title_trgm_idx")
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "posts_slug_trgm_idx")
  @@index([createdAt], map: "posts_created_at_alive_idx", where: { deletedAt: null })
  @@map("posts")
}

/// Post ↔ PostTag 中間テーブル（JSON配列からの正規化）
model PostTagOnPost {
  postId String  @map("post_id") @db.Uuid
  tagId  String  @map("tag_id") @db.Uuid
  post   Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    PostTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tag_on_posts")
}

model PostCategory {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String   @unique
  slug            String   @unique
  description     String?  @db.Text
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description") @db.Text
  ogpImageUrl     String?  @map("ogp_image_url")
  order           Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  posts Post[]

  @@unique([order], map: "post_categories_order_key")
  @@map("post_categories")
}

model PostTag {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String   @unique
  slug            String   @unique
