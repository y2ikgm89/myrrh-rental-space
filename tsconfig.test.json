{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // bun:test モジュールの型定義を有効化（@types/bun + tsconfig types: ["bun", ...] が公式現行推奨）
    // 旧 "bun-types" 直接参照は deprecated alias（.claude/rules/bun-patterns.md §禁止事項 #10）
    // "node" を明示的に追加して @types/node を復元（Prisma $extends の型推論に必要）
    "types": ["bun", "node"],

    // テストファイルは noUncheckedIndexedAccess の strict 適用を緩和
    // （テスト内の arr[0].xxx アクセスが一般的なパターンのため）
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    // グローバル型宣言（global.d.ts の globalThis.prisma 等）をテストでも有効化
    "src/shared/types/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
