# Project command policy.
# These rules are evaluated for commands that Codex requests outside the sandbox.

prefix_rule(
    pattern = ["bun", "run", [
        "db:generate",
        "type-check",
        "lint",
        "format:check",
        "validate",
        "test:unit",
        "test:integration",
        "test:all",
        "build:skip-env",
        "docs",
    ]],
    decision = "allow",
    justification = "Repository generation, static analysis, and non-destructive verification gates.",
    match = [
        "bun run db:generate",
        "bun run type-check",
        "bun run lint",
        "bun run validate",
        "bun run test:unit",
        "bun run test:integration",
        "bun run build:skip-env",
    ],
    not_match = [
        "bun run db:reset",
        "bun run db:push",
        "bun run e2e",
    ],
)

prefix_rule(
    pattern = ["bun", "scripts/run-tests.ts"],
    decision = "allow",
    justification = "The local test runner isolates Bun tests per file.",
    match = [
        "bun scripts/run-tests.ts __tests__/unit/lib/crypto.test.ts",
        "bun scripts/run-tests.ts __tests__/unit/architecture-boundaries.test.ts",
    ],
)

prefix_rule(
    pattern = ["bun", "test"],
    decision = "allow",
    justification = "Focused Bun tests are safe verification commands.",
    match = [
        "bun test __tests__/unit/architecture-boundaries.test.ts",
        "bun test __tests__/unit/architecture/admin-design-tokens.test.ts",
    ],
)

prefix_rule(
    pattern = ["bun", "run", "e2e"],
    decision = "prompt",
    justification = "Playwright E2E launches browsers, a web server, and seeded test state. Run only when it is the right proof.",
    match = [
        "bun run e2e",
        "bun run e2e -- --project=chromium-smoke",
        "bun run e2e -- e2e/public/homepage.spec.ts",
    ],
)

prefix_rule(
    pattern = ["bun", "run", "e2e:ui"],
    decision = "prompt",
    justification = "The Playwright UI is interactive and should be launched only when requested.",
    match = [
        "bun run e2e:ui",
    ],
)

prefix_rule(
    pattern = ["bun", "run", ["db:reset", "db:push"]],
    decision = "forbidden",
    justification = "Destructive or migration-bypassing database commands require explicit user direction and verified target database.",
    match = [
        "bun run db:reset",
        "bun run db:push",
    ],
)

prefix_rule(
    pattern = ["bunx", "--bun", "prisma", "migrate", "reset"],
    decision = "forbidden",
    justification = "Database reset is destructive. Ask the user and verify the database target first.",
    match = [
        "bunx --bun prisma migrate reset",
        "bunx --bun prisma migrate reset --force",
    ],
)

prefix_rule(
    pattern = ["bunx", "--bun", "prisma", "db", ["push", "pull"]],
    decision = "forbidden",
    justification = "Direct Prisma push/pull bypasses migration review or can drop manual SQL invariants. Use reviewed migrations instead.",
    match = [
        "bunx --bun prisma db push",
        "bunx --bun prisma db pull",
    ],
)

prefix_rule(
    pattern = ["bunx", "--bun", "prisma", "migrate", "dev"],
    decision = "prompt",
    justification = "Migration creation changes database history. Confirm name, target database, and scope before running.",
    match = [
        "bunx --bun prisma migrate dev --name add-example",
    ],
)

prefix_rule(
    pattern = ["git", ["log", "blame", "show"]],
    decision = "prompt",
    justification = "Project work is local-first. Use history only when the user explicitly asks.",
    match = [
        "git log --oneline",
        "git blame src/proxy.ts",
        "git show HEAD",
    ],
)

prefix_rule(
    pattern = ["gh"],
    decision = "prompt",
    justification = "GitHub access is external project state. Use only when the user explicitly requests it.",
    match = [
        "gh pr view 1",
        "gh issue list",
    ],
)

prefix_rule(
    pattern = ["git", ["reset", "clean"]],
    decision = "forbidden",
    justification = "Do not discard workspace state from automation. Ask the user for an explicit destructive operation.",
    match = [
        "git reset --hard",
        "git clean -fd",
    ],
)
