# =============================================================================
#  Myrrh Rental Space — .gitignore
#  Stack: Next.js 16 + Bun 1.3 + Prisma 7 + Cloud Run + Playwright + Better Auth
#  Reference: https://nextjs.org/docs/app/getting-started/installation
# =============================================================================

# ─── Dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*

# ─── Build output ────────────────────────────────────────────────────────────
/.next/
/out/
/build/
/dist/
*.tsbuildinfo
next-env.d.ts

# ─── Runtime caches ──────────────────────────────────────────────────────────
.bun/
.turbo/
.cache/

# ─── Prisma (deps stage で再生成) ────────────────────────────────────────────
/generated/
!prisma/migrations/.gitkeep

# ─── Environment variables ──────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ─── Testing / Coverage ──────────────────────────────────────────────────────
/coverage/
/test-results/
/playwright-report/
/playwright/.cache/
/playwright/.auth/
.nyc_output

# ─── Lighthouse CI (artifacts; budget.json のみ tracked) ─────────────────────
/.lighthouseci/
!/.lighthouseci/budget.json

# ─── IDE / Editor ────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
.idea/
.cursor/

# ─── OS noise ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~
*.swp
*.swo
mintty.*.png
nul

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*storybook.log

# ─── Temporary / Sensitive ───────────────────────────────────────────────────
*.tmp
*.temp
*.pem
*.key
*.crt
gha-creds-*.json

# ─── Python (hooks) ──────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ─── AI / Tooling local state ────────────────────────────────────────────────
.remember/
.playwright-mcp/
# Serena MCP: project.yml と memories は commit、cache / logs / local 上書きは ignore
# https://oraios.github.io/serena/02-usage/040_workflow.html
.serena/cache/
.serena/logs/
.serena/project.local.yml
.claire/
.superpowers/

# ─── Claude Code local state ─────────────────────────────────────────────────
.claude/logs/
.claude/state/
.claude/memory/
.claude/agent-memory/
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
tmpclaude-*-cwd

# ─── Vendor deploy artifacts ─────────────────────────────────────────────────
.vercel/

# ─── react-email CLI build artifacts ─────────────────────────────────────────
.react-email/

# ─── Generated API docs (TypeDoc) ────────────────────────────────────────────
docs/api/

# ─── Section Architecture Phase B: migration audit log (ephemeral) ───────────
prisma/migrations/section-design-migration-log.json

# ─── Cloudflare enumerator output (Phase 8 準備、Terraform 化前の inventory) ─
# `bash scripts/enumerate-cloudflare.sh > cloudflare-inventory.txt` 等で生成する
# API 応答 dump。zone metadata (account ID / ruleset ID / R2 bucket 名等) を
# 含むため commit しない (Terraform 化後は state / config が SSoT になる)。
# 部分 dump (rulesets-detail / r2 / turnstile / pagerules / inventory-part2 等) も
# 同じ理由で除外するため glob で吸収。
cloudflare-*.txt
