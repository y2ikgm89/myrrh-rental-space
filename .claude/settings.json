{
  "permissions": {
    "allow": [
      "Bash(bun run validate)",
      "Bash(bun run type-check)",
      "Bash(bun run lint)",
      "Bash(bun run lint:*)",
      "Bash(bun run build)",
      "Bash(bun run build:*)",
      "Bash(bun run format)",
      "Bash(bun run format:check)",
      "Bash(bun run test:unit)",
      "Bash(bun run test:integration)",
      "Bash(bun run test:all)",
      "Bash(bun run e2e*)",
      "Bash(bun run db:generate)"
    ],
    "ask": [
      "Bash(bun run db:push)",
      "Bash(bun run db:migrate)",
      "Bash(bun run db:seed)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env.local)",
      "Edit(/.env)",
      "Edit(/.env.local)",
      "Edit(/prisma/migrations/**)",
      "Edit(/generated/**)",
      "Edit(/bun.lock)",
      "Bash(rm -rf:*)"
    ]
  },
  "env": {
    "PYTHONUTF8": "1"
  }
}
