{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(npm run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "mcp__plugin_serena_serena__list_memories",
      "Bash(# Git と基本構造の確認\n[ -d .git ] && echo \"\"Git: Yes\"\" || echo \"\"Git: No\"\"\n[ -f package.json ] && cat package.json)",
      "Bash(bunx create-next-app@latest:*)",
      "Bash([ -d .git ])",
      "Bash([ -d src ])",
      "Bash([ -f AGENTS.md ])",
      "Bash([ -f CLAUDE.md ])",
      "Bash([ -f Plans.md ])",
      "Bash([ -d .claude ])",
      "Bash(command -v:*)",
      "Bash([ -f .claude/settings.json ])",
      "Bash([ -f .claude/memory/decisions.md ])",
      "Bash([ -f .claude/memory/patterns.md ])",
      "Bash([ -f .claude/rules/test-quality.md ])",
      "Bash([ -f .claude/rules/implementation-quality.md ])",
      "Bash([ -f .claude-code-harness-version ])"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(sudo:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(mongod:*)",
      "Bash(mongo:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*id_rsa*)",
      "Read(**/*id_ed25519*)",
      "Read(**/.ssh/**)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)"
    ]
  }
}
