{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "85",
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "allow": [
      "mcp__github__*",
      "mcp__context7__*",
      "mcp__plugin_serena_serena__*",
      "mcp__plugin_playwright_playwright__*",
      "Bash(bun run validate *)",
      "Bash(bun run type-check *)",
      "Bash(bun run lint *)",
      "Bash(bun run build *)",
      "Bash(bun run test:unit *)",
      "Bash(bun run test:integration *)",
      "Bash(bun test *)",
      "Bash(bun outdated *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "statusMessage": "進行中タスクを確認中..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inject-current-date.sh",
            "timeout": 5,
            "statusMessage": "現在日付を注入中..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-bash.sh",
            "timeout": 10,
            "statusMessage": "危険コマンドを検査中..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-sensitive-files.sh",
            "timeout": 10,
            "statusMessage": "機密ファイルを検査中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prettier-format.sh",
            "async": true,
            "statusMessage": "Prettier 実行中..."
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/eslint-fix.sh",
            "async": true,
            "statusMessage": "ESLint --fix 実行中..."
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/schema-change-guard.sh",
            "timeout": 30,
            "statusMessage": "Prisma generate 実行中..."
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pattern-guard.sh",
            "timeout": 10,
            "statusMessage": "パターン検査中..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(mv *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/detect-empty-route-dirs.sh",
            "timeout": 10,
            "statusMessage": "空ルートディレクトリを検査中..."
          },
          {
            "type": "command",
            "if": "Bash(rm *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/detect-empty-route-dirs.sh",
            "timeout": 10,
            "statusMessage": "空ルートディレクトリを検査中..."
          },
          {
            "type": "command",
            "if": "Bash(git mv *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/detect-empty-route-dirs.sh",
            "timeout": 10,
            "statusMessage": "空ルートディレクトリを検査中..."
          },
          {
            "type": "command",
            "if": "Bash(bunx --bun prisma migrate *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/auto-db-generate.sh",
            "timeout": 30,
            "statusMessage": "prisma generate 実行中..."
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-subagent-git-snapshot.sh",
            "timeout": 10,
            "statusMessage": "Subagent 完了後の git state をキャプチャ中..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notification.sh",
            "statusMessage": "通知を送信中..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/type-check-on-stop.sh",
            "asyncRewake": true,
            "timeout": 300,
            "statusMessage": "背景で型チェック中..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {}
}
