# ==============================================
# Myrrh Rental Space - Environment Variables
# ==============================================
# Copy this file to .env.local for local development, or run:
#   bun run setup
#
# SSoT for names / validation: src/shared/lib/env/server.ts,
# src/shared/lib/env/client.ts, and validateProductionEnv() in server.ts.
#
# Local policy: production-only secrets stay empty (""). With
# emptyStringAsUndefined they pass Zod as optional. Generate real values for
# production with the openssl commands noted below — never commit them.
#
# PowerShell:
#   Copy-Item .env.example .env.local
#
# bash/zsh:
#   cp .env.example .env.local

# ----------------------------------------------
# Required (local)
# ----------------------------------------------
# App runtime (Prisma Client). Local docker = direct localhost URL.
# Production Neon: use the pooled host (`…-pooler.…neon.tech`), not the
# direct endpoint — see https://neon.com/docs/guides/prisma-migrations
#
# Do NOT append `?schema=…`. That was a Prisma v6 connection-string parameter;
# Prisma 7 talks to PostgreSQL through the pg driver adapter, which ignores it
# (a bogus schema still connects and `search_path` stays untouched). The schema
# is set via `PrismaPgOptions.schema` in src/shared/db/prisma.ts if ever needed.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myrrh_rental"
# Prisma CLI (migrate / db push). Neon official: direct (non-pooler) URL.
# Local docker: same value as DATABASE_URL. Never point local at production Neon.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/myrrh_rental"
# Local/CI only: real-DB integration tests. Keep this separate from DATABASE_URL.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/myrrh_test"
# Local-only dummy (≥32 chars). Production: openssl rand -base64 32
BETTER_AUTH_SECRET="local-dev-only-better-auth-secret-32chars-min"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAADi6Bqavj97fu7JG"
APP_SURFACE="admin"
ADMIN_APP_URL="http://localhost:3000"
# Local/CI only: bypass real IAP by resolving this email as the signed-in admin.
# Never set this in production.
ADMIN_TEST_IAP_EMAIL="admin@example.com"

# ----------------------------------------------
# Cloudflare R2 (production required — leave empty locally)
# ----------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
# お問い合わせ添付専用の private bucket（公開カスタムドメインなし、PII 隔離）。
# R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY は上記と共用。
R2_INQUIRIES_BUCKET_NAME=""

# ----------------------------------------------
# Cloudflare CDN (production required — leave empty locally)
# ----------------------------------------------
# Zone ID: 32 hex chars. API Token: Zone:Read + Zone:Cache Purge:Purge (single zone).
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""
# Generate with: openssl rand -hex 32
CLOUDFLARE_ORIGIN_HEADER_SECRET=""

# ----------------------------------------------
# Production-only (leave empty locally)
# ----------------------------------------------
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""
# Primary key kid (default "v1" when unset). 1-32 chars [a-zA-Z0-9_-]
ENCRYPTION_KEY_ID="v1"
# Key rotation decrypt-only list: kid1:hex64,kid2:hex64
SECONDARY_ENCRYPTION_KEYS=""
# Generate with: openssl rand -hex 32
AUDIT_LOG_HMAC_KEY=""
AUDIT_LOG_HMAC_KEY_ID="v1"
# Cloud Scheduler OIDC validation for /api/cron/*
CRON_OIDC_AUDIENCE=""
CRON_SERVICE_ACCOUNT_EMAIL=""
# Required for multi-instance self-hosting / build-time Server Actions encryption
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
# Cloud Run IAP signed-header audience for the admin service.
# Format: /projects/PROJECT_NUMBER/locations/REGION/services/ADMIN_SERVICE_NAME
IAP_JWT_AUDIENCE=""
ADMIN_ROLE_GROUP_SUPER_ADMIN_EMAIL=""
ADMIN_ROLE_GROUP_ADMIN_EMAIL=""
ADMIN_ROLE_GROUP_EDITOR_EMAIL=""
ADMIN_ROLE_GROUP_VIEWER_EMAIL=""

# ----------------------------------------------
# Optional integrations
# ----------------------------------------------
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""  # optional local-dev fallback for svix signing secret. Production canonical is DB (`Settings.resendWebhookSecret`) rotated via admin UI.
SUPPRESSION_HASH_SECRET=""  # HMAC secret for suppression set cache hashing (M6). Recommended: 64+ random hex chars (`openssl rand -hex 64`). Required in production (`validateProductionEnv`); local/test may omit (plain SHA-256 fallback).
EMAIL_FROM=""             # sender address (env優先 → DB senderEmail → fallback). Must be a Resend-verified domain.
EMAIL_FROM_NAME=""        # sender display name (env優先 → DB senderName → SITE_DEFAULTS.name)
STRIPE_SECRET_KEY=""
TURNSTILE_SECRET_KEY=""
GBP_STUB_MODE=""          # set to "1" to stub Google Business Profile API locally
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_APPLICATION_CREDENTIALS_JSON=""  # GA4 Data API service account JSON (single line)
LINE_CLIENT_ID=""
LINE_CLIENT_SECRET=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI=""

# ----------------------------------------------
# Optional — database pool tuning
# ----------------------------------------------
DATABASE_POOL_MAX=""
DATABASE_CONNECTION_TIMEOUT_MS=""
DATABASE_IDLE_TIMEOUT_MS=""
DATABASE_STATEMENT_TIMEOUT_MS=""
DATABASE_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=""

# ----------------------------------------------
# Optional — rate limiting (Cloud Run scaling contract)
# ----------------------------------------------
# in-memory only (product decision: no Redis for rate-limit). Cloud Run max-instances must stay 1.
RATE_LIMIT_BACKEND="in-memory"
MAX_INSTANCES_HINT=""

# ----------------------------------------------
# E2E / CI only (never production)
# ----------------------------------------------
# NEXT_PUBLIC_ENABLE_E2E_LOGIN="1"
# E2E_RUNTIME="1"
# E2E_FIXED_NOW_ISO="2026-01-01T00:00:00.000Z"

# ----------------------------------------------
# Runtime
# ----------------------------------------------
NODE_ENV="development"
