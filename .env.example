# ==============================================
# Myrrh Rental Space - Environment Variables
# ==============================================
# Copy this file to .env.local for local development.
#
# PowerShell:
#   Copy-Item .env.example .env.local
#
# bash/zsh:
#   cp .env.example .env.local

# ----------------------------------------------
# Required (all environments)
# ----------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myrrh_rental?schema=public"
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ----------------------------------------------
# Required (production only)
# ----------------------------------------------
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="replace-with-64-hex-characters"
# Generate with: openssl rand -base64 32
CRON_SECRET="replace-with-strong-random-secret"
# Generate with: openssl rand -base64 32
ADMIN_LOGIN_TOKEN="replace-with-strong-random-secret"

# ----------------------------------------------
# Optional
# ----------------------------------------------
BETTER_AUTH_URL="http://localhost:3000"
RESEND_API_KEY=""
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI=""

# ----------------------------------------------
# Runtime
# ----------------------------------------------
NODE_ENV="development"
