# ==============================================
# Myrrh Rental Space - Environment Variables
# ==============================================
# Copy this file to .env.local for local development.
#
# PowerShell:
#   Copy-Item .env.example .env.local
#
# bash/zsh:
#   cp .env.example .env.local

# ----------------------------------------------
# Required (all environments)
# ----------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myrrh_rental?schema=public"
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAADi6Bqavj97fu7JG"
APP_SURFACE="admin"
ADMIN_APP_URL="http://localhost:3000"
# Local/CI only: bypass real IAP by resolving this email as the signed-in admin.
# Never set this in production.
ADMIN_TEST_IAP_EMAIL="admin@example.com"

# ----------------------------------------------
# Cloudflare R2 (画像ストレージ / 本番必須)
# ----------------------------------------------
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="myrrh-media"
R2_PUBLIC_URL="https://media.example.com"

# ----------------------------------------------
# Required (production only)
# ----------------------------------------------
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="replace-with-64-hex-characters"
# Cloud Scheduler OIDC validation for /api/cron/*
CRON_OIDC_AUDIENCE="https://example.com"
CRON_SERVICE_ACCOUNT_EMAIL="myrrh-rental-space-scheduler@example-project.iam.gserviceaccount.com"
# Required for multi-instance self-hosting / build-time Server Actions encryption
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-base64-32-byte-key"
# Cloud Run IAP signed-header audience for the admin service.
# Format: /projects/PROJECT_NUMBER/locations/REGION/services/ADMIN_SERVICE_NAME
IAP_JWT_AUDIENCE="/projects/123456789012/locations/asia-northeast1/services/myrrh-rental-space-admin"
ADMIN_ROLE_GROUP_SUPER_ADMIN_EMAIL="myrrh-super-admins@myrrh-jp.com"
ADMIN_ROLE_GROUP_ADMIN_EMAIL="myrrh-admins@myrrh-jp.com"
ADMIN_ROLE_GROUP_EDITOR_EMAIL="myrrh-editors@myrrh-jp.com"
ADMIN_ROLE_GROUP_VIEWER_EMAIL="myrrh-viewers@myrrh-jp.com"

# ----------------------------------------------
# Optional
# ----------------------------------------------
RESEND_API_KEY=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI=""

# ----------------------------------------------
# Runtime
# ----------------------------------------------
NODE_ENV="development"
