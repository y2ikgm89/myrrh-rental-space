# ==============================================
# Myrrh Rental Space - Environment Variables
# ==============================================
# Copy this file to .env.local for local development.
#
# SSoT for names / validation: src/shared/lib/env/server.ts,
# src/shared/lib/env/client.ts, and validateProductionEnv() in server.ts.
#
# PowerShell:
#   Copy-Item .env.example .env.local
#
# bash/zsh:
#   cp .env.example .env.local

# ----------------------------------------------
# Required (all environments)
# ----------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myrrh_rental?schema=public"
# Local/CI only: real-DB integration tests. Keep this separate from DATABASE_URL.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/myrrh_test?schema=public"
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAADi6Bqavj97fu7JG"
APP_SURFACE="admin"
ADMIN_APP_URL="http://localhost:3000"
# Local/CI only: bypass real IAP by resolving this email as the signed-in admin.
# Never set this in production.
ADMIN_TEST_IAP_EMAIL="admin@example.com"

# ----------------------------------------------
# Cloudflare R2 (画像ストレージ / 本番必須)
# ----------------------------------------------
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="myrrh-media"
R2_PUBLIC_URL="https://media.example.com"

# ----------------------------------------------
# Cloudflare CDN (cache purge / origin protection / 本番必須)
# ----------------------------------------------
# Zone ID: 32 hex chars. API Token: Zone:Read + Zone:Cache Purge:Purge (single zone).
CLOUDFLARE_ZONE_ID="00000000000000000000000000000000"
CLOUDFLARE_API_TOKEN="replace-with-cloudflare-api-token-min-40-chars"
# Generate with: openssl rand -hex 32
CLOUDFLARE_ORIGIN_HEADER_SECRET="replace-with-64-hex-characters"

# ----------------------------------------------
# Required (production only)
# ----------------------------------------------
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="replace-with-64-hex-characters"
# Primary key kid (default "v1" when unset). 1-32 chars [a-zA-Z0-9_-]
ENCRYPTION_KEY_ID="v1"
# Key rotation decrypt-only list: kid1:hex64,kid2:hex64
SECONDARY_ENCRYPTION_KEYS=""
# Generate with: openssl rand -hex 32
AUDIT_LOG_HMAC_KEY="replace-with-64-hex-characters"
AUDIT_LOG_HMAC_KEY_ID="v1"
# Cloud Scheduler OIDC validation for /api/cron/*
CRON_OIDC_AUDIENCE="https://example.com"
CRON_SERVICE_ACCOUNT_EMAIL="myrrh-rental-space-scheduler@example-project.iam.gserviceaccount.com"
# Required for multi-instance self-hosting / build-time Server Actions encryption
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-base64-32-byte-key"
# Cloud Run IAP signed-header audience for the admin service.
# Format: /projects/PROJECT_NUMBER/locations/REGION/services/ADMIN_SERVICE_NAME
IAP_JWT_AUDIENCE="/projects/123456789012/locations/asia-northeast1/services/myrrh-rental-space-admin"
ADMIN_ROLE_GROUP_SUPER_ADMIN_EMAIL="myrrh-super-admins@myrrh-jp.com"
ADMIN_ROLE_GROUP_ADMIN_EMAIL="myrrh-admins@myrrh-jp.com"
ADMIN_ROLE_GROUP_EDITOR_EMAIL="myrrh-editors@myrrh-jp.com"
ADMIN_ROLE_GROUP_VIEWER_EMAIL="myrrh-viewers@myrrh-jp.com"

# ----------------------------------------------
# Optional integrations
# ----------------------------------------------
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""  # optional local-dev fallback for svix signing secret. Production canonical is DB (`Settings.resendWebhookSecret`) rotated via admin UI.
SUPPRESSION_HASH_SECRET=""  # HMAC secret for suppression set cache hashing (M6). Recommended: 64+ random hex chars (`openssl rand -hex 64`). Unset falls back to plain SHA-256 with a boot-time WARN.
EMAIL_FROM=""             # sender address (env優先 → DB senderEmail → fallback). Must be a Resend-verified domain.
EMAIL_FROM_NAME=""        # sender display name (env優先 → DB senderName → SITE_DEFAULTS.name)
STRIPE_SECRET_KEY=""
TURNSTILE_SECRET_KEY=""
GBP_STUB_MODE=""          # set to "1" to stub Google Business Profile API locally
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_APPLICATION_CREDENTIALS_JSON=""  # GA4 Data API service account JSON (single line)
LINE_CLIENT_ID=""
LINE_CLIENT_SECRET=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI=""

# ----------------------------------------------
# Optional — database pool tuning
# ----------------------------------------------
DATABASE_POOL_MAX=""
DATABASE_CONNECTION_TIMEOUT_MS=""
DATABASE_IDLE_TIMEOUT_MS=""
DATABASE_STATEMENT_TIMEOUT_MS=""
DATABASE_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=""

# ----------------------------------------------
# Optional — rate limiting (Cloud Run scaling contract)
# ----------------------------------------------
# in-memory: MAX_INSTANCES_HINT must be 1. redis: requires distributed store in rate-limit.ts.
RATE_LIMIT_BACKEND="in-memory"
MAX_INSTANCES_HINT=""

# ----------------------------------------------
# E2E / CI only (never production)
# ----------------------------------------------
# NEXT_PUBLIC_ENABLE_E2E_LOGIN="1"
# E2E_RUNTIME="1"
# E2E_FIXED_NOW_ISO="2026-01-01T00:00:00.000Z"

# ----------------------------------------------
# Runtime
# ----------------------------------------------
NODE_ENV="development"
