# ==============================================
# Myrrh Rental Space - Environment Variables
# ==============================================
# Copy this file to .env.local for local development.
#
# PowerShell:
#   Copy-Item .env.example .env.local
#
# bash/zsh:
#   cp .env.example .env.local

# ----------------------------------------------
# Required (all environments)
# ----------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myrrh_rental?schema=public"
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_SURFACE="admin"
ADMIN_APP_URL="http://localhost:3000"

# ----------------------------------------------
# Cloudflare R2 (画像ストレージ / 本番必須)
# ----------------------------------------------
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="myrrh-media"
R2_PUBLIC_URL="https://media.example.com"

# ----------------------------------------------
# Required (production only)
# ----------------------------------------------
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="replace-with-64-hex-characters"
# Generate with: openssl rand -base64 32
CRON_SECRET="replace-with-strong-random-secret"
# Generate with: openssl rand -base64 32
ADMIN_LOGIN_TOKEN="replace-with-strong-random-secret"
# Required for multi-instance self-hosting / build-time Server Actions encryption
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-base64-32-byte-key"

# ----------------------------------------------
# Optional
# ----------------------------------------------
BETTER_AUTH_URL="http://localhost:3000"
RESEND_API_KEY=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI=""

# ----------------------------------------------
# Runtime
# ----------------------------------------------
NODE_ENV="development"
