// Renovate: https://docs.renovatebot.com/configuration-options/
//
// このプロジェクトは Renovate を採用。Dependabot (.github/dependabot.yml) から
// 移行済み — Renovate は package grouping / auto-merge / schedule 制御で優位。
//
// 設定検証: npx --yes --package renovate -- renovate-config-validator
// （`bunx renovate-config-validator` は動かない。この bin を提供するのは
//   `renovate` パッケージで、同名パッケージからは実行ファイルを解決できない）
//
// packageRules は配列順に `mergeChildConfig` で合成される（Renovate 実装
// `lib/util/package-rules/index.ts`）。**後のルールが設定しなかったキーは前の値が残る**ので、
// 先頭の automerge ルールを打ち消したい後続ルールは `automerge: false` を明示すること。
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "group:recommended",
    ":timezone(Asia/Tokyo)",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":dependencyDashboard",
    ":maintainLockFilesWeekly",
    "schedule:weekdays",
    "helpers:pinGitHubActionDigests",
  ],
  // Mend ホスト版は「All repositories」でインストールすると**組織既定が `silent`** になり、
  // 解析は毎回走るのにブランチ・PR・Dependency Dashboard を一切作らない
  // （結果は developer.mend.io の "Pending Approval" に溜まるだけ）。
  // 実測 2026-08-11: 有効化後 1 時間でジョブは全て DONE、更新候補 45 件超を検出済み、
  // GitHub 側の書き込みは 0 件だった。
  //
  // 組織設定の `Disable Repo-level Override` が OFF なので、この repo 側の指定が優先される。
  // ポータルのトグルではなくここで持つ（設定はコードに置き、レビュー可能にする方針）。
  mode: "full",
  labels: ["dependencies", "automated"],
  prConcurrentLimit: 10,
  prHourlyLimit: 4,
  rangeStrategy: "bump",
  // 既定の `auto` は実質「conflicted のときだけ rebase」で、**base に遅れているだけでは
  // rebase しない**（PR 本文にも "Whenever PR becomes conflicted, or you tick the
  // rebase/retry checkbox" と出る）。
  //
  // branch protection は `required_status_checks.strict: true`
  // （`.github/branch-protection.json`）。required check は base 最新で
  // 緑である必要がある。GitHub 公式推奨。
  //
  // 実測 2026-08-11: `strict: false` のまま `rebaseWhen` 既定 (`auto`) だと、
  // gate 修正 (#2130) を main に入れても Renovate PR 4 本は古い base のまま
  // 赤で放置され、各 PR の rebase チェックボックスを手で叩くまで回復しなかった。
  //
  // `rebaseWhen: "behind-base-branch"` は GitHub の merge ブロックとは別物。
  // Renovate が自分のブランチを能動的に作り直すだけなので auto-merge は
  // 停止しない。CI が余分に回るが、このリポジトリは public のため
  // Actions 分数の課金は無い。
  rebaseWhen: "behind-base-branch",
  // bun.lock is lockfileVersion 2 (Bun 1.4 default for new lockfiles).
  // Existing v1 files are preserved on re-save; this repo stamps 2 so
  // lockFileMaintenance cannot silently rewrite the format.
  lockFileMaintenance: {
    enabled: true,
  },
  // major version の更新は手動対応（破壊的変更リスク）
  separateMajorMinor: true,
  separateMultipleMajor: true,
  // 脆弱性検出時は即時更新（schedule 無視）
  vulnerabilityAlerts: {
    enabled: true,
    labels: ["security", "dependencies"],
    schedule: ["at any time"],
    assignees: ["@y2ikgm89"],
  },
  // 依存グループ定義
  packageRules: [
    // ----- 自動マージ可能なパッチ更新 -----
    {
      description: "Auto-merge patch updates for non-major (>=1.0.0) deps",
      matchUpdateTypes: ["patch"],
      matchCurrentVersion: "!/^0/",
      matchDepTypes: ["devDependencies", "dependencies"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    // ----- Next.js エコシステム (同期更新) -----
    // next 本体と同じ版数で出るパッケージは 1 つの PR にまとめる。package.json では
    // これらを exact pin しているので、別々の PR で入ると版がずれた窓ができる。
    // 実害の例: @next/eslint-plugin-next 16.3.0 の新ルールが単独で先に入ると、
    // 無関係な PR の lint が突然落ちる。
    {
      description: "Group Next.js core packages",
      matchPackageNames: [
        "next",
        "@next/third-parties",
        "@next/eslint-plugin-next",
      ],
      groupName: "next.js",
      matchUpdateTypes: ["minor", "patch"],
    },
    // ----- React エコシステム -----
    {
      description: "Group React packages",
      matchPackageNames: [
        "react",
        "react-dom",
        "react-compiler-runtime",
        "@types/react",
        "@types/react-dom",
      ],
      groupName: "react",
    },
    // ----- TypeScript エコシステム -----
    {
      description: "Group TypeScript tooling",
      matchPackageNames: ["typescript", "@types/**", "typescript-eslint"],
      groupName: "typescript",
      matchUpdateTypes: ["minor", "patch"],
    },
    // typescript の major は PR を作らせず Dashboard のチェックボックスに留める。
    //
    // typescript-eslint の peer は 8.67.0 / canary いずれも `>=4.8.4 <6.1.0` で
    // TypeScript 7 を許さず、`scripts/ensure-typescript-toolchain.ts` が
    // 「インストール済み typescript-eslint が申告する範囲」を読んで範囲外なら throw する。
    // これを `bun run build` と `bun run type-check` の両方が入口で呼ぶため、
    // TS 7 の PR は必ず落ちる（PR #2168 で実際に落ちた）。
    // 放置すると TS の新版が出るたびに、構造的に通らない PR が CI を 1 回ずつ消費する。
    //
    // 解除条件は typescript-eslint の peer range が 7.x を含むこと。それだけ。
    // gate 側は範囲をハードコードしていないので、peer が動けば設定変更なしで通る。
    // なお TypeScript 6.x は 6.0.3 が最終版で 6.1 は存在しないため、
    // 6.0.3（現在の pin）と 7.x の間に中間ステップは無い。
    {
      description: "TypeScript major stays behind Dashboard approval",
      matchPackageNames: ["typescript"],
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    // ----- Prisma エコシステム -----
    {
      description: "Group Prisma packages",
      matchPackageNames: [
        "prisma",
        "@prisma/client",
        "@prisma/adapter-pg",
        "@prisma/dev",
      ],
      groupName: "prisma",
    },
    // ----- Radix UI (30+ パッケージを一括) -----
    {
      description: "Group all Radix UI packages",
      matchPackageNames: ["@radix-ui/**", "radix-ui"],
      groupName: "radix-ui",
    },
    // ----- Lexical (Rich text editor) -----
    {
      description: "Group all Lexical packages",
      matchPackageNames: ["lexical", "@lexical/**"],
      groupName: "lexical",
      matchUpdateTypes: ["minor", "patch"],
    },
    // ----- Tailwind CSS エコシステム -----
    {
      description: "Group Tailwind CSS packages",
      matchPackageNames: [
        "tailwindcss",
        "@tailwindcss/typography",
        "@tailwindcss/**",
      ],
      groupName: "tailwind",
    },
    // ----- ESLint / Prettier / tooling -----
    {
      description: "Group ESLint / Prettier tooling",
      matchPackageNames: [
        "eslint",
        "eslint-**",
        "@eslint/**",
        "@eslint-react/**",
        "prettier",
        "@typescript-eslint/**",
      ],
      groupName: "lint tooling",
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      platformAutomerge: true,
    },
    // ----- Playwright / axe-core -----
    {
      description: "Group E2E testing tools",
      matchPackageNames: [
        "@playwright/test",
        "playwright",
        "@axe-core/**",
        "axe-core",
      ],
      groupName: "playwright testing",
    },
    // ----- Better Auth -----
    {
      description: "Better Auth ecosystem",
      matchPackageNames: ["better-auth", "@better-auth/**"],
      groupName: "better-auth",
    },
    // ----- GSAP / Lenis (public animations) -----
    {
      description: "Group animation libraries",
      matchPackageNames: ["gsap", "@gsap/**", "lenis"],
      groupName: "animations",
    },
    // ----- dnd-kit -----
    {
      description: "Group @dnd-kit packages",
      matchPackageNames: ["@dnd-kit/**"],
      groupName: "dnd-kit",
    },
    // ----- @tabler/icons-react -----
    {
      description: "Tabler icons",
      matchPackageNames: ["@tabler/icons-react"],
      groupName: "tabler-icons",
    },
    // ----- GitHub Actions -----
    {
      description: "Pin GitHub Actions to SHA for security",
      matchManagers: ["github-actions"],
      pinDigests: true,
      groupName: "github-actions",
      automerge: true,
      platformAutomerge: true,
    },
    // ----- @types/bun は runtime pin と lockstep -----
    // runtime pin の SSoT は package.json#packageManager（全ピン 1.4.0 で統一済み）。
    // @types/bun がこれより先に上がると型だけ 1.5 API を誤前提にする（#2482 の
    // 実例: runtime 1.3.14 のまま @types/bun ^1.4.0 が入った）。major/minor は
    // Dashboard 承認必須。runtime bump と lockstep させること。
    {
      description: "Require approval for @types/bun ahead of Bun runtime",
      matchPackageNames: ["@types/bun", "bun-types"],
      matchUpdateTypes: ["major", "minor"],
      dependencyDashboardApproval: true,
    },
    // ----- overrides は親が宣言した range の内側に留める -----
    {
      description: "Keep overrides inside their parent's declared range",
      matchDepTypes: ["overrides"],
      matchUpdateTypes: ["major"],
      // `docs/dependency-overrides.md` の pin 表の契約は「親パッケージが宣言した
      // range の内側で、advisory を回避できる最小の版に留める」こと。major を跨ぐと
      // その契約が壊れる — `nanoid` を v4 にすると `postcss` が宣言した range を
      // 外れるが、bun の override は range を置換するので**強制的に適用されて
      // しまう**（型検査にもテストにも出ず、実行時に初めて壊れる）。
      //
      // 実測 2026-08-11: 初回スキャンで js-yaml v4/v5・body-parser v2・@babel/core v8・
      // nanoid v4/v5/v6・uuid v12/13/14・fast-uri v4 の 8 件以上が候補に挙がった。
      //
      // 消さずに Dependency Dashboard には出す。親側が major を上げて override も
      // 追随すべきになったとき、チェックボックスから起こせる状態を残す。
      dependencyDashboardApproval: true,
    },
    // ----- DB migration 系は慎重に -----
    {
      description: "Database drivers require manual review",
      matchPackageNames: ["pg", "@prisma/adapter-pg"],
      labels: ["requires-careful-review", "database"],
      minimumReleaseAge: "7 days",
      // `minimumReleaseAge` は automerge を**遅らせるだけで止めない**（公式:
      // "Await X time duration before Automerging"）。明示しないと先頭の
      // patch automerge ルールが残り、7 日後に無人でマージされる。
      automerge: false,
    },
    // ----- Stripe SDK は慎重に -----
    {
      description: "Stripe SDK requires manual review for payment safety",
      matchPackageNames: ["stripe", "@stripe/**"],
      labels: ["requires-careful-review", "payment"],
      minimumReleaseAge: "7 days",
      // 同上。SDK の版は `src/shared/lib/stripe.ts` の `apiVersion` ピン留めと
      // 結びついており（更新すると型エラーで次の LatestApiVersion が分かる仕掛け）、
      // 無人マージしてよい対象ではない。
      automerge: false,
    },
  ],
  // 除外パッケージ（手動管理）
  ignoreDeps: [],
}
